+"""Jarvis: killing the user's browser is always a human decision, and a configured local
+``browser.cdp_url`` relaunches the dedicated debug browser when it is closed."""
+
+from unittest.mock import patch
+
+import pytest
+
+from tools.approval import detect_dangerous_command
+from tools.approval_detection import BROWSER_KILL_DESCRIPTION
+from tools.approval_smart import _smart_verdict
+from tools import browser_tool_cdp as bt_cdp
