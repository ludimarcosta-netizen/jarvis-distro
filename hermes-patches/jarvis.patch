@@ -0,0 +1,29 @@
+import { useStore } from '@nanostores/react'
+
+import { HumanoidFace } from '@/components/jarvis-face/humanoid-face'
+import type { HumanoidMood } from '@/lib/jarvis-face/portrait-renderer'
+import { cn } from '@/lib/utils'
+import { $jarvisFaceOpen, $jarvisVoice, type JarvisVoiceState } from '@/store/jarvis-face'
+
+export function presenceMood(voice: JarvisVoiceState, busy: boolean): HumanoidMood {
+  if (voice.speaking) {
+    return 'speaking'
+  }
+
+  if (voice.listening) {
+    return 'listening'
+  }
+
+  return busy || voice.delegation?.status === 'running' ? 'thinking' : 'open'
+}
+
+export function JarvisPresence({ busy = false, className }: { busy?: boolean; className?: string }) {
+  const voice = useStore($jarvisVoice)
+  const faceOpen = useStore($jarvisFaceOpen)
+
+  return (
+    <div className={cn('jarvis-presence', className)}>
+      {!faceOpen && <HumanoidFace className="jarvis-presence-image" mood={presenceMood(voice, busy)} />}
+    </div>
+  )
+}
