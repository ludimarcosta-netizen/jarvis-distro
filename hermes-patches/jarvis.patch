--- /dev/null
+++ b/apps/desktop/src/store/jarvis-face.ts
@@ -0,0 +1,183 @@
+import { atom } from 'nanostores'
+
+import { connectionScoped, hermesApi } from '@/api/client'
+import type { CerebroGraph } from '@/lib/jarvis-face/galaxy-layout'
+import { isAuxiliaryWindow } from '@/store/windows'
+
+/**
+ * "Face" mode: a full-window layer over the normal app (the app keeps running
+ * underneath) with the Cérebro galaxy, chat and floating cards. The app launches in
+ * face mode; closing it lasts until the next launch. Helper windows (session, HUD,
+ * browser) never open it.
+ */
+export const $jarvisFaceOpen = atom(!isAuxiliaryWindow())
+
+export function setJarvisFaceOpen(open: boolean): void {
+  $jarvisFaceOpen.set(open)
+}
+
+export interface JarvisDelegation {
+  status: 'confirming' | 'done' | 'error' | 'running'
+  request: string
+}
+
+/** A sensitive voice request waiting for the user's one-use approval on screen. */
+export interface JarvisPending {
+  id: string
+  digest: string
+  request: string
+  remaining_s: number
+}
+
+export interface JarvisVoiceState {
+  status: 'connecting' | 'error' | 'idle' | 'live'
+  speaking: boolean
+  listening: boolean
+  delegation: JarvisDelegation | null
+  pending: JarvisPending | null
+}
+
+export const $jarvisVoice = atom<JarvisVoiceState>({
+  status: 'idle',
+  speaking: false,
+  listening: false,
+  delegation: null,
+  pending: null
+})
+
+const VOICE_STATUSES: ReadonlySet<string> = new Set(['connecting', 'error', 'idle', 'live'])
+const DELEGATION_STATUSES: ReadonlySet<string> = new Set(['confirming', 'done', 'error', 'running'])
+
+function parseDelegation(value: unknown): JarvisDelegation | null {
+  const d = value as Partial<JarvisDelegation> | null
+
+  return d && typeof d.status === 'string' && DELEGATION_STATUSES.has(d.status)
+    ? { status: d.status, request: typeof d.request === 'string' ? d.request : '' }
+    : null
+}
+
+function parsePending(value: unknown): JarvisPending | null {
+  const p = value as Partial<JarvisPending> | null
+
+  return p && typeof p.id === 'string' && typeof p.digest === 'string'
+    ? {
+        id: p.id,
+        digest: p.digest,
+        request: typeof p.request === 'string' ? p.request : '',
+        remaining_s: typeof p.remaining_s === 'number' ? p.remaining_s : 0
+      }
+    : null
+}
+
+/** Parse the `jarvis:voice` event published by the gemini-live-bridge plugin. */
+export function parseVoiceDetail(detail: unknown): JarvisVoiceState | null {
+  const value = detail as Partial<JarvisVoiceState> | null
+
+  if (!value || typeof value.status !== 'string' || !VOICE_STATUSES.has(value.status)) {
+    return null
+  }
+
+  return {
+    status: value.status,
+    speaking: value.speaking === true,
+    listening: value.listening === true,
+    delegation: parseDelegation(value.delegation),
+    pending: parsePending(value.pending)
+  }
+}
+
+/** Mirror the plugin's voice events into `$jarvisVoice`. Returns the unsubscribe. */
+export function bindJarvisVoiceEvents(): () => void {
+  const onVoice = (event: Event) => {
+    const next = parseVoiceDetail((event as CustomEvent).detail)
+
+    if (next) {
+      $jarvisVoice.set(next)
+    }
+  }
+
+  window.addEventListener('jarvis:voice', onVoice)
+
+  return () => window.removeEventListener('jarvis:voice', onVoice)
+}
+
+/** The user's click on the confirmation card; the voice plugin forwards it to the backend. */
+export function decideJarvisPending(pending: JarvisPending, allow: boolean): void {
+  window.dispatchEvent(new CustomEvent('jarvis:decide', { detail: { id: pending.id, digest: pending.digest, allow } }))
+}
+
+let submitHandler: ((text: string) => void) | null = null
+
+/** Register the handler that turns a face-chat submit into a real send. */
+export function setJarvisFaceSubmitHandler(fn: ((text: string) => void) | null): void {
+  submitHandler = fn
+}
+
+export function submitFromJarvisFace(text: string): boolean {
+  const trimmed = text.trim()
+
+  if (!trimmed || !submitHandler) {
+    return false
+  }
+
+  submitHandler(trimmed)
+
+  return true
+}
+
+export const $cerebroGraph = atom<CerebroGraph | null>(null)
+export const $cerebroGraphError = atom<null | string>(null)
+
+let graphInflight: null | Promise<void> = null
+
+/** The Cérebro keeps growing while the app runs; re-read it this often while a galaxy is on screen. */
+export const CEREBRO_GRAPH_REFRESH_MS = 5 * 60_000
+
+function sameGraph(a: CerebroGraph | null, b: CerebroGraph): boolean {
+  return a !== null && JSON.stringify(a) === JSON.stringify(b)
+}
+
+export function loadCerebroGraph(): Promise<void> {
+  if (graphInflight) {
+    return graphInflight
+  }
+
+  $cerebroGraphError.set(null)
+
+  graphInflight = hermesApi<CerebroGraph>({ ...connectionScoped(), path: '/api/plugins/gemini-live-bridge/cerebro-graph' })
+    .then(graph => {
+      // Unchanged vault: keep the old reference so the galaxy is not rebuilt for nothing.
+      if (!sameGraph($cerebroGraph.get(), graph)) {
+        $cerebroGraph.set(graph)
+      }
+    })
+    .catch(err => {
+      $cerebroGraphError.set(err instanceof Error ? err.message : String(err))
+    })
+    .finally(() => {
+      graphInflight = null
+    })
+
+  return graphInflight
+}
+
+/** Re-read the graph now and every CEREBRO_GRAPH_REFRESH_MS. Returns the stop. */
+export function watchCerebroGraph(): () => void {
+  void loadCerebroGraph()
+  const timer = window.setInterval(() => void loadCerebroGraph(), CEREBRO_GRAPH_REFRESH_MS)
+
+  return () => window.clearInterval(timer)
+}
+
+/** How strongly the galaxy should glow for the current Jarvis activity. */
+export function faceEnergy(voice: JarvisVoiceState, busy: boolean): number {
+  if (voice.speaking) {
+    return 1
+  }
+
+  if (busy || voice.delegation?.status === 'running') {
+    return 0.7
+  }
+
+  return voice.listening ? 0.45 : 0
+}
