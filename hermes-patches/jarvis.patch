--- /dev/null
+++ b/apps/desktop/src/components/jarvis-face/face-panels.tsx
@@ -0,0 +1,284 @@
+import { useStore } from '@nanostores/react'
+import { type ReactNode, useCallback, useEffect, useState } from 'react'
+
+import { getStatus } from '@/api/config'
+import { getCronJobs } from '@/api/cron'
+import { concluirPendencia, getPendencias, getSistemas, type Pendencia, type SystemCheck } from '@/api/jarvis-face'
+import { everyWhileVisible } from '@/lib/jarvis-face/visible-interval'
+import { cn } from '@/lib/utils'
+import { $jarvisVoice } from '@/store/jarvis-face'
+import { $faceCards, type FacePanel, isPanelOpen, togglePanel } from '@/store/jarvis-face-cards'
+import type { CronJob } from '@/types/hermes'
+
+export const PANEL_TITLES: Record<FacePanel, string> = {
+  lembretes: 'Lembretes agendados',
+  pendencias: 'Pendências',
+  sistemas: 'Status dos sistemas'
+}
+
+interface Polled<T> {
+  data: null | T
+  error: null | string
+  reload: () => void
+}
+
+/**
+ * Load once, then every `intervalMs` while the window is visible, until unmounted. An unchanged
+ * answer keeps the previous value, so the panel does not re-render. `load` must be a stable function.
+ */
+function usePolled<T>(load: () => Promise<T>, intervalMs: number): Polled<T> {
+  const [data, setData] = useState<null | T>(null)
+  const [error, setError] = useState<null | string>(null)
+  const [tick, setTick] = useState(0)
+
+  useEffect(() => {
+    let alive = true
+
+    const run = () =>
+      load().then(
+        value => {
+          if (alive) {
+            setData(previous => (JSON.stringify(previous) === JSON.stringify(value) ? previous : value))
+            setError(null)
+          }
+        },
+        err => {
+          if (alive) {
+            setError(err instanceof Error ? err.message : String(err))
+          }
+        }
+      )
+
+    void run()
+    const stop = everyWhileVisible(() => void run(), intervalMs)
+
+    return () => {
+      alive = false
+      stop()
+    }
+  }, [load, intervalMs, tick])
+
+  const reload = useCallback(() => setTick(value => value + 1), [])
+
+  return { data, error, reload }
+}
+
+const Note = ({ children }: { children: ReactNode }) => <p className="py-2 text-xs text-slate-400">{children}</p>
+
+export function PanelBody({ panel }: { panel: FacePanel }) {
+  switch (panel) {
+    case 'pendencias':
+      return <PendenciasPanel />
+
+    case 'lembretes':
+      return <LembretesPanel />
+
+    case 'sistemas':
+      return <SistemasPanel />
+  }
+}
+
+const todayIso = () => new Date().toISOString().slice(0, 10)
+
+function PendenciasPanel() {
+  const { data, error, reload } = usePolled(getPendencias, 60_000)
+  const [confirming, setConfirming] = useState<null | number>(null)
+  const [failed, setFailed] = useState<null | string>(null)
+
+  const finish = async (item: Pendencia) => {
+    setConfirming(null)
+
+    try {
+      const result = await concluirPendencia(item.id)
+
+      setFailed(result.ok ? null : 'Não foi possível concluir (já concluída?).')
+    } catch (err) {
+      setFailed(err instanceof Error ? err.message : String(err))
+    }
+
+    reload()
+  }
+
+  if (error) {
+    return <Note>Não consegui ler as pendências: {error}</Note>
+  }
+
+  if (!data) {
+    return <Note>Carregando…</Note>
+  }
+
+  if (data.length === 0) {
+    return <Note>Nenhuma pendência aberta.</Note>
+  }
+
+  return (
+    <div className="flex flex-col gap-2">
+      {failed && <Note>{failed}</Note>}
+      {data.map(item => {
+        const overdue = Boolean(item.prazo) && item.prazo! < todayIso()
+
+        return (
+          <div className="flex flex-col gap-1 rounded-xl border border-white/8 bg-white/4 px-3 py-2" key={item.id}>
+            <p className="leading-snug">{item.descricao}</p>
+            <div className="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-slate-400">
+              {item.prazo && <span className={cn(overdue && 'font-semibold text-rose-300')}>{overdue ? 'Venceu ' : 'Prazo '}{item.prazo}</span>}
+              {item.responsavel && <span>{item.responsavel}</span>}
+              {item.ata_titulo && <span className="truncate">· {item.ata_titulo}</span>}
+              <span className="ml-auto flex items-center gap-1">
+                {confirming === item.id ? (
+                  <>
+                    <button className="rounded-full bg-emerald-400/90 px-2.5 py-0.5 font-semibold text-slate-950" onClick={() => void finish(item)} type="button">
+                      Confirmar
+                    </button>
+                    <button className="rounded-full px-2 py-0.5 text-slate-300 hover:bg-white/10" onClick={() => setConfirming(null)} type="button">
+                      Voltar
+                    </button>
+                  </>
+                ) : (
+                  <button className="rounded-full border border-emerald-300/40 px-2.5 py-0.5 text-emerald-200 hover:bg-emerald-300/10" onClick={() => setConfirming(item.id)} type="button">
+                    Concluir
+                  </button>
+                )}
+              </span>
+            </div>
+          </div>
+        )
+      })}
+    </div>
+  )
+}
+
+const loadJobs = () => getCronJobs()
+
+function whenLabel(iso: null | string | undefined): string {
+  const date = iso ? new Date(iso) : null
+
+  return date && !Number.isNaN(date.getTime())
+    ? date.toLocaleString('pt-BR', { day: '2-digit', hour: '2-digit', minute: '2-digit', month: '2-digit' })
+    : '—'
+}
+
+export function sortedActiveJobs(jobs: readonly CronJob[]): CronJob[] {
+  return jobs
+    .filter(job => job.enabled)
+    .sort((a, b) => (a.next_run_at ?? '9999').localeCompare(b.next_run_at ?? '9999'))
+}
+
+function LembretesPanel() {
+  const { data, error } = usePolled(loadJobs, 60_000)
+
+  if (error) {
+    return <Note>Não consegui ler os agendamentos: {error}</Note>
+  }
+
+  if (!data) {
+    return <Note>Carregando…</Note>
+  }
+
+  const jobs = sortedActiveJobs(data)
+
+  if (jobs.length === 0) {
+    return <Note>Nenhum lembrete ou rotina ativa.</Note>
+  }
+
+  return (
+    <div className="flex flex-col gap-2">
+      {jobs.map(job => (
+        <div className="flex flex-col gap-0.5 rounded-xl border border-white/8 bg-white/4 px-3 py-2" key={job.id}>
+          <p className="leading-snug">{job.name || (job.prompt ?? '').slice(0, 80) || job.id}</p>
+          <div className="flex justify-between font-mono text-[11px] text-slate-400">
+            <span>{job.schedule_display ?? job.schedule?.display ?? ''}</span>
+            <span className="text-amber-200/90">próx. {whenLabel(job.next_run_at)}</span>
+          </div>
+          {job.last_error && <p className="text-[11px] text-rose-300">Última falha: {job.last_error.slice(0, 120)}</p>}
+        </div>
+      ))}
+    </div>
+  )
+}
+
+const STATUS_DOT: Record<SystemCheck['status'], string> = {
+  off: 'bg-slate-500',
+  ok: 'bg-emerald-400 shadow-[0_0_8px_#34d399]',
+  warn: 'bg-amber-400 shadow-[0_0_8px_#fbbf24]'
+}
+
+const loadGateway = () => getStatus()
+
+function SistemasPanel() {
+  const checks = usePolled(getSistemas, 10_000)
+  const gateway = usePolled(loadGateway, 10_000)
+  const jobs = usePolled(loadJobs, 60_000)
+  const voice = useStore($jarvisVoice)
+
+  const rows: SystemCheck[] = [
+    {
+      id: 'gateway',
+      label: 'Gateway do agente',
+      status: gateway.data ? (gateway.data.gateway_running ? 'ok' : 'off') : 'off',
+      detail: gateway.data ? (gateway.data.gateway_state ?? (gateway.data.gateway_running ? 'ativo' : 'parado')) : (gateway.error ?? '…')
+    },
+    {
+      id: 'sessao-voz',
+      label: 'Sessão de voz agora',
+      status: voice.status === 'error' ? 'warn' : voice.status === 'live' ? 'ok' : 'off',
+      detail: voice.speaking ? 'falando' : voice.listening ? 'ouvindo' : voice.status
+    },
+    ...(checks.data ?? []),
+    ...(jobs.data
+      ? [{ id: 'cron', label: 'Rotinas agendadas', status: 'ok' as const, detail: `${sortedActiveJobs(jobs.data).length} ativas` }]
+      : [])
+  ]
+
+  return (
+    <div className="flex flex-col divide-y divide-white/6">
+      {checks.error && <Note>Backend do Jarvis não respondeu: {checks.error}</Note>}
+      {rows.map(row => (
+        <div className="flex items-center gap-2.5 py-1.5" key={row.id}>
+          <span aria-hidden className={cn('size-2 shrink-0 rounded-full', STATUS_DOT[row.status])} />
+          <span className="flex-1">{row.label}</span>
+          <span className="font-mono text-[11px] text-slate-400">{row.detail}</span>
+        </div>
+      ))}
+    </div>
+  )
+}
+
+const DOCK_ITEMS: { label: string; panel: FacePanel }[] = [
+  { label: 'Pendências', panel: 'pendencias' },
+  { label: 'Lembretes', panel: 'lembretes' },
+  { label: 'Sistemas', panel: 'sistemas' }
+]
+
+const loadCount = () => getPendencias().then(items => items.length)
+
+export function FaceDock() {
+  const cards = useStore($faceCards)
+  const count = usePolled(loadCount, 60_000).data
+
+  return (
+    <nav aria-label="Painéis" className="pointer-events-auto absolute right-4 top-4 z-10 flex gap-2">
+      {DOCK_ITEMS.map(({ label, panel }) => {
+        const active = isPanelOpen(cards, panel)
+
+        return (
+          <button
+            aria-pressed={active}
+            className={cn(
+              'flex h-8 items-center gap-1.5 rounded-full border px-3.5 text-xs backdrop-blur-md transition',
+              active ? 'border-cyan-300/60 bg-cyan-300/15 text-cyan-100' : 'border-white/15 bg-white/5 text-slate-200 hover:border-cyan-300/50 hover:bg-white/10'
+            )}
+            key={panel}
+            onClick={() => togglePanel(panel)}
+            type="button"
+          >
+            {label}
+            {panel === 'pendencias' && count != null && count > 0 && (
+              <span className="rounded-full bg-amber-400/90 px-1.5 text-[10px] font-semibold text-slate-950">{count}</span>
+            )}
+          </button>
+        )
+      })}
+    </nav>
+  )
+}
diff --git a/apps/desktop/src/components/jarvis-face/humanoid-face.tsx b/apps/desktop/src/components/jarvis-face/humanoid-face.tsx
