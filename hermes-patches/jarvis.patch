+++ b/apps/desktop/src/lib/jarvis-face/face-motion.ts
@@ -0,0 +1,17 @@
+export const GALAXY_DISTANCE = 0.9
+
+/** Zooming into memories clears the centre; zooming out restores the portrait. */
+export function faceScale(distance: number): number {
+  return Math.max(0.28, Math.min(1, distance / GALAXY_DISTANCE))
+}
+
+export function zoomDistance(distance: number, delta: number, mode = 0, viewport = 900): number {
+  const pixels = delta * (mode === 1 ? 16 : mode === 2 ? viewport : 1)
+
+  return Math.max(0.7, Math.min(3.2, distance * Math.exp(Math.max(-1, Math.min(1, pixels * 0.0012)))))
+}
+
+/** Close and reopen from the current expression, without widening before a blink. */
+export function blinkOpenness(progress: number, resting: number): number {
+  return resting * (1 - Math.sin(Math.PI * Math.max(0, Math.min(1, progress))))
+}
