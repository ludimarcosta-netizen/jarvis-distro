+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import { createGalaxy } from '@/lib/jarvis-face/galaxy-renderer'
+import { $jarvisFaceOpen } from '@/store/jarvis-face'
+
+import { Backdrop } from './Backdrop'
+
+const renderer = vi.hoisted(() => ({ setGraph: vi.fn(), setEnergy: vi.fn(), setPaused: vi.fn(), dispose: vi.fn() }))
+vi.mock('@/lib/jarvis-face/galaxy-renderer', () => ({ createGalaxy: vi.fn(() => renderer) }))
+vi.mock('@/store/jarvis-face', async () => {
+  const { atom } = await import('nanostores')
+
+  return {
+    $jarvisFaceOpen: atom(false),
+    $cerebroGraph: atom(null),
+    $jarvisVoice: atom({}),
+    faceEnergy: vi.fn(() => 0),
+    watchCerebroGraph: vi.fn(() => () => undefined)
+  }
+})
+beforeEach(() => {
+  vi.clearAllMocks()
+  vi.stubGlobal(
+    'matchMedia',
+    vi.fn(() => ({ matches: false, addEventListener: vi.fn(), removeEventListener: vi.fn() }))
+  )
+  $jarvisFaceOpen.set(false)
+})
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+})
+it('pauses while hidden and resumes the same context', () => {
+  render(<Backdrop />)
+  expect(createGalaxy).toHaveBeenCalledTimes(1)
+  vi.spyOn(window.document, 'hidden', 'get').mockReturnValue(true)
+  act(() => window.document.dispatchEvent(new Event('visibilitychange')))
+  expect(renderer.setPaused).toHaveBeenLastCalledWith(true)
+  vi.spyOn(window.document, 'hidden', 'get').mockReturnValue(false)
+  act(() => window.document.dispatchEvent(new Event('visibilitychange')))
+  expect(renderer.setPaused).toHaveBeenLastCalledWith(false)
+  expect(createGalaxy).toHaveBeenCalledTimes(1)
+})
+it('releases the covered galaxy and creates a fresh canvas when returning', () => {
+  const { container } = render(<Backdrop />)
+  const original = container.querySelector('canvas')
+  act(() => $jarvisFaceOpen.set(true))
+  expect(container.querySelector('canvas')).toBeNull()
+  expect(renderer.dispose).toHaveBeenCalledTimes(1)
+  act(() => $jarvisFaceOpen.set(false))
+  expect(container.querySelector('canvas')).not.toBe(original)
+  expect(createGalaxy).toHaveBeenCalledTimes(2)
+})
+it('does not allocate a galaxy for inactive panes', () => {
+  const { rerender } = render(<Backdrop active={false} />)
+  expect(createGalaxy).not.toHaveBeenCalled()
+  rerender(<Backdrop active />)
+  expect(createGalaxy).toHaveBeenCalledTimes(1)
+})
+it('keeps the decorative fallback when WebGL is unavailable', () => {
+  vi.mocked(createGalaxy).mockImplementationOnce(() => {
+    throw new Error('WebGL unavailable')
+  })
+  vi.spyOn(console, 'error').mockImplementation(() => undefined)
+  const { container } = render(<Backdrop />)
+  expect(container.querySelector('.jarvis-workspace-backdrop')?.getAttribute('aria-hidden')).toBe('true')
+  expect(container.querySelector('.jarvis-workspace-shade')).not.toBeNull()
+})
