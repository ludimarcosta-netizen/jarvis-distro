diff --git a/tests/agent/test_rate_limit_far_reset_rotation.py b/tests/agent/test_rate_limit_far_reset_rotation.py
new file mode 100644
index 00000000000..82815312461
--- /dev/null
+++ b/tests/agent/test_rate_limit_far_reset_rotation.py
@@ -0,0 +1,68 @@
+"""A 429 whose provider reset lies beyond any retry wait is a spent quota window: rotate now.
+
+Anthropic answers a spent subscription window with a generic "would exceed your account's rate
+limit" and a reset hours away. The pool's "retry the same key once, rotate on the second 429" rule
+never reaches the second 429 when the session allows a single API retry, so the turn jumped to the
+fallback model while a healthy second Anthropic account sat unused in the pool.
+"""
+
+from __future__ import annotations
+
+import time
+
+from agent.agent_runtime_helpers import _recover_rate_limit
+
+
+class _Pool:
+    def entries(self):
+        return []
+
+    def current(self):
+        return None
+
+
+def _recover(error_context, *, has_retried_429=False):
+    rotations = []
+
+    def rotate_and_swap(status, label):
+        rotations.append((status, label))
+        return True
+
+    result = _recover_rate_limit(
+        _Pool(), has_retried_429=has_retried_429, error_context=error_context,
+        api_key_hint=None, credential_id=None, rotate_and_swap=rotate_and_swap,
+    )
+    return result, rotations
+
+
+def test_first_429_with_far_reset_rotates_immediately():
+    ctx = {"message": "This request would exceed your account's rate limit.", "reset_at": time.time() + 31 * 3600}
+
+    (recovered, retried), rotations = _recover(ctx)
+
+    assert recovered is True and retried is False
+    assert rotations == [(429, "rate limit")]
+
+
+def test_far_reset_as_iso_timestamp_also_rotates():
+    from datetime import datetime, timedelta, timezone
+
+    iso = (datetime.now(timezone.utc) + timedelta(hours=31)).isoformat()
+
+    (recovered, _), rotations = _recover({"reset_at": iso})
+
+    assert recovered is True and rotations == [(429, "rate limit")]
+
+
+def test_first_429_with_near_reset_still_retries_the_same_key():
+    (recovered, retried), rotations = _recover({"reset_at": time.time() + 30})
+
+    assert (recovered, retried) == (False, True)
+    assert rotations == []
+
+
+def test_first_429_without_reset_keeps_the_retry_once_rule():
+    (recovered, retried), rotations = _recover({"message": "rate limited"})
+
+    assert (recovered, retried) == (False, True)
+    assert rotations == []
