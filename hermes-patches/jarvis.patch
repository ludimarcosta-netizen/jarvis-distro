+import { describe, expect, it } from 'vitest'
+
+import { blinkOpenness, faceScale, GALAXY_DISTANCE, zoomDistance } from './face-motion'
+
+describe('memory exploration', () => {
+  it('shrinks the portrait when approaching memories and restores it on return', () => {
+    const near = zoomDistance(GALAXY_DISTANCE, -600)
+
+    expect(near).toBeLessThan(GALAXY_DISTANCE)
+    expect(faceScale(near)).toBeLessThan(faceScale(GALAXY_DISTANCE))
+    expect(faceScale(zoomDistance(near, 600))).toBeCloseTo(1)
+    expect(faceScale(3.2)).toBe(1)
+  })
+
+  it('normalizes trackpad, line and page scrolling and bounds large gestures', () => {
+    expect(zoomDistance(1.75, -48)).toBe(zoomDistance(1.75, -3, 1))
+    expect(zoomDistance(1.75, -900)).toBe(zoomDistance(1.75, -1, 2, 900))
+    expect(zoomDistance(0.7, -10000)).toBe(0.7)
+    expect(zoomDistance(3.2, 10000)).toBe(3.2)
+    expect(faceScale(0.7)).toBeGreaterThan(0)
+  })
+})
+
+describe('blink', () => {
+  it('closes completely, returns to the expression and never widens it', () => {
+    for (const resting of [0.5, 0.62, 0.72, 0.9]) {
+      expect(blinkOpenness(0, resting)).toBe(resting)
+      expect(blinkOpenness(0.5, resting)).toBe(0)
+      expect(blinkOpenness(1, resting)).toBeCloseTo(resting)
+
+      for (let p = 0; p <= 1; p += 0.05) {
+        expect(blinkOpenness(p, resting)).toBeLessThanOrEqual(resting)
+        expect(blinkOpenness(p, resting)).toBeGreaterThanOrEqual(0)
+      }
+    }
+  })
+})
diff --git a/apps/desktop/src/lib/jarvis-face/face-motion.ts b/apps/desktop/src/lib/jarvis-face/face-motion.ts
