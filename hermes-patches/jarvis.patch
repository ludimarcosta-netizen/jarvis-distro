+
+@pytest.mark.parametrize("text", [
+    "abre o spotify e toca sertanejo",          # mais de um passo
+    "abre o site da prefeitura",                # site
+    "abre a pasta de licitações",               # pasta
+    "abre www.google.com",
+    "qual a previsão do tempo?",
+    "me abre um chamado no sistema, depois avisa",
+])
+def test_anything_else_goes_to_the_model(abrir, text):
+    assert fa.try_fast_action(AGENT, text) is None
+    assert abrir.opened == [] and abrir.searched == []
+
+
+def test_not_found_falls_back_but_ambiguous_asks_right_away():
+    missing = FakeAbrir({"ok": False, "mensagem": "Não encontrei…", "opcoes": []})
+    with patch.object(fa, "_abrir", return_value=missing):
+        assert fa.try_fast_action(AGENT, "abre o chamado") is None
+    ambiguous = FakeAbrir({"ok": False, "mensagem": "Encontrei mais de um: A; B. Qual deles?", "opcoes": ["A", "B"]})
+    with patch.object(fa, "_abrir", return_value=ambiguous):
