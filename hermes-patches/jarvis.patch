+import { readFileSync } from 'node:fs'
+
+import { describe, expect, it } from 'vitest'
+
+import { viewMatrix } from './mat4'
+import { parseHumanoidRig, referenceHeadProjection, RIG_STRIDE } from './reference-head'
+
+const file = readFileSync('src/lib/jarvis-face/assets/humanoid-rig.bin')
+const buffer = new Uint8Array(file).buffer
+const rig = parseHumanoidRig(buffer)
+
+describe('anatomical humanoid rig', () => {
+  it('contains validated skin, mouth, teeth and eye geometry with true expression targets', () => {
+    expect(rig.vertices.length / RIG_STRIDE).toBeGreaterThan(45000)
+    expect(rig.indices.length / 3).toBeGreaterThan(70000)
+    expect(rig.indices).toBeInstanceOf(Uint32Array)
+    const parts = new Set<number>()
+
+    let jaw = 0,
+      blink = 0
+
+    for (let i = 0; i < rig.vertices.length; i += RIG_STRIDE) {
+      parts.add(rig.vertices[i + 8]!)
+      expect(Math.hypot(...rig.vertices.slice(i + 3, i + 6))).toBeCloseTo(1, 4)
+      jaw = Math.max(jaw, Math.hypot(...rig.vertices.slice(i + 9, i + 12)))
+      blink = Math.max(blink, Math.hypot(...rig.vertices.slice(i + 12, i + 15)))
+    }
+
+    expect([...parts].sort()).toEqual([0, 1, 3, 4, 6, 7, 8])
+    expect(jaw).toBeGreaterThan(0.08)
+    expect(blink).toBeGreaterThan(0.01)
+  })
+  it('preserves every vertex distance from the pivot through both profiles', () => {
+    for (const yaw of [-Math.PI / 2, -0.65, 0, 0.65, Math.PI / 2]) {
+      const m = viewMatrix(yaw, 0.18, 0)
+
+      for (let i = 0; i < rig.vertices.length; i += RIG_STRIDE * 17) {
+        const x = rig.vertices[i]!,
+          y = rig.vertices[i + 1]!,
+          z = rig.vertices[i + 2]!
+
+        const transformed = [
+          m[0]! * x + m[4]! * y + m[8]! * z,
+          m[1]! * x + m[5]! * y + m[9]! * z,
+          m[2]! * x + m[6]! * y + m[10]! * z
+        ]
+
+        expect(Math.hypot(...transformed)).toBeCloseTo(Math.hypot(x, y, z), 5)
+      }
+    }
+  })
+  it('keeps ears and skull rigid while animating lips and eyelids', () => {
+    let rigidSkin = 0
+
+    for (let i = 0; i < rig.vertices.length; i += RIG_STRIDE) {
+      const x = rig.vertices[i]!,
+        y = rig.vertices[i + 1]!
+
+      if (rig.vertices[i + 8] === 0 && (Math.abs(x) > 0.6 || y > 0.7)) {
+        expect(Math.hypot(...rig.vertices.slice(i + 9, i + 15))).toBeLessThan(0.025)
+        rigidSkin++
+      }
+    }
+
+    expect(rigidSkin).toBeGreaterThan(100)
+  })
+  it('joins the two volumetric lips at rest and moves both edges during speech', () => {
+    const lips: number[] = []
+
+    for (let i = 0; i < rig.vertices.length; i += RIG_STRIDE) {
+      if (rig.vertices[i + 8] === 7 || rig.vertices[i + 8] === 8) {lips.push(i)}
+    }
+
+    const upper = lips.filter(i => rig.vertices[i + 8] === 7)
+      .sort((a, b) => Math.abs(rig.vertices[a]!) - Math.abs(rig.vertices[b]!))[0]!
+
+    const lower = lips.find(i => rig.vertices[i + 8] === 8 &&
+      Math.abs(rig.vertices[i]! - rig.vertices[upper]!) < 0.00001 &&
+      Math.abs(rig.vertices[i + 1]! - rig.vertices[upper + 1]!) < 0.00001)!
+
+    expect(upper).toBeDefined()
+    expect(lower).toBeDefined()
+    expect(Math.abs(rig.vertices[upper]! - rig.vertices[lower]!)).toBeLessThan(0.001)
+    const closedGap = rig.vertices[upper + 1]! - rig.vertices[lower + 1]!
+    expect(closedGap).toBeGreaterThanOrEqual(0)
+    expect(closedGap).toBeLessThan(0.004)
+    expect(rig.vertices[upper + 10]!).toBeGreaterThan(0.005)
+    expect(rig.vertices[lower + 10]!).toBeLessThan(-0.04)
+    const openGap = closedGap + (rig.vertices[upper + 10]! - rig.vertices[lower + 10]!) * 0.6
+    expect(openGap).toBeGreaterThan(0.025)
+    expect(openGap).toBeLessThan(0.09)
+    const lipDepth = Math.min(rig.vertices[upper + 2]!, rig.vertices[lower + 2]!)
+
+    for (let i = 0; i < rig.vertices.length; i += RIG_STRIDE) {
+      if (rig.vertices[i + 8] === 1 || rig.vertices[i + 8] === 3) {
+        expect(rig.vertices[i + 2]!).toBeLessThan(lipDepth - 0.05)
+      }
+    }
+  })
+  it('closes real upper and lower eyelids over the eyeballs', () => {
+    let upper = 0,
+      lower = 0
+
+    for (let i = 0; i < rig.vertices.length; i += RIG_STRIDE) {
+      if (rig.vertices[i + 8] !== 0 || Math.abs(rig.vertices[i + 12]!) > 0.001) {continue}
+      const delta = rig.vertices[i + 13]!
+
+      if (delta < -0.025) {upper++}
+
+      if (delta > 0.02) {lower++}
+    }
+
+    expect(upper).toBeGreaterThan(20)
+    expect(lower).toBeGreaterThan(20)
+  })
+  it('rejects incomplete or corrupted assets', () => {
+    expect(() => parseHumanoidRig(new ArrayBuffer(8))).toThrow()
+    expect(() => parseHumanoidRig(buffer.slice(0, buffer.byteLength - 2))).toThrow()
+    const invalid = buffer.slice(0)
+    new DataView(invalid).setUint32(0, 0, true)
+    expect(() => parseHumanoidRig(invalid)).toThrow()
+  })
+  it('preserves frontal proportions independently of depth', () => {
+    const projection = referenceHeadProjection(0.8)
+    expect(projection[11]).toBe(0)
+    expect(projection[15]).toBe(1)
+    expect(projection[0]! * 0.8).toBeCloseTo(projection[5]!)
+  })
+})
diff --git a/apps/desktop/src/lib/jarvis-face/reference-head.ts b/apps/desktop/src/lib/jarvis-face/reference-head.ts
