+import { beforeEach, describe, expect, it } from 'vitest'
+
+import {
+  $faceCards,
+  dismissAgentCards,
+  dismissCard,
+  isPanelOpen,
+  markCardKeySeen,
+  MAX_AGENT_CARDS,
+  moveCard,
+  placeCard,
+  pushAgentCard,
+  raiseCard,
+  resetFaceCards,
+  togglePanel
+} from './jarvis-face-cards'
+
+const card = (title: string) => ({ kind: 'aviso' as const, title })
+
+beforeEach(resetFaceCards)
+
+describe('placeCard', () => {
+  it('fans out across columns on a wide window, then cascades down', () => {
+    const wide = { height: 900, width: 1600 }
+    const [a, b, c, d] = [0, 1, 2, 4].map(i => placeCard(i, wide))
+
+    expect(b!.x).toBeLessThan(a!.x)
+    expect(c!.x).toBeLessThan(b!.x)
+    expect(b!.y).toBe(a!.y)
+    expect(d!.x).toBe(a!.x)
+    expect(d!.y).toBeGreaterThan(a!.y)
+  })
+
+  it('cascades in a single column on a narrow window and stays on screen', () => {
+    const narrow = { height: 300, width: 200 }
+
+    expect(placeCard(0, narrow)).toEqual({ x: 16, y: 40 })
+    expect(placeCard(1, { height: 800, width: 600 }).y).toBeGreaterThan(placeCard(0, { height: 800, width: 600 }).y)
+  })
+})
+
+describe('pushAgentCard', () => {
+  it('adds a card once per key, even after it was dismissed', () => {
+    expect(pushAgentCard(card('a'), 'm1:0')).toBe(true)
+    expect(pushAgentCard(card('a'), 'm1:0')).toBe(false)
+
+    dismissCard('agent:m1:0')
+    expect(pushAgentCard(card('a'), 'm1:0')).toBe(false)
+    expect($faceCards.get()).toHaveLength(0)
+  })
+
+  it('skips keys marked as already seen (history on open)', () => {
+    markCardKeySeen('old:0')
+
+    expect(pushAgentCard(card('x'), 'old:0')).toBe(false)
+  })
+
+  it('drops the oldest agent card at the cap but never a panel', () => {
+    togglePanel('pendencias')
+
+    for (let i = 0; i < MAX_AGENT_CARDS + 2; i++) {
+      pushAgentCard(card(`c${i}`), `k${i}`)
+    }
+
+    const cards = $faceCards.get()
+    const titles = cards.flatMap(c => (c.source.type === 'agent' ? [c.source.card.title] : []))
+
+    expect(titles).toHaveLength(MAX_AGENT_CARDS)
+    expect(titles[0]).toBe('c2')
+    expect(isPanelOpen(cards, 'pendencias')).toBe(true)
+  })
+})
+
+describe('panels', () => {
+  it('toggle open and closed', () => {
+    togglePanel('sistemas')
+    expect(isPanelOpen($faceCards.get(), 'sistemas')).toBe(true)
+
+    togglePanel('sistemas')
+    expect(isPanelOpen($faceCards.get(), 'sistemas')).toBe(false)
+  })
+})
+
+describe('move and raise', () => {
+  it('moves one card and brings it to the front', () => {
+    pushAgentCard(card('a'), 'a')
+    pushAgentCard(card('b'), 'b')
+
+    moveCard('agent:a', 10, 20)
+    raiseCard('agent:a')
+
+    const [a, b] = $faceCards.get()
+
+    expect([a!.x, a!.y]).toEqual([10, 20])
+    expect(a!.z).toBeGreaterThan(b!.z)
+  })
+})
+
+describe('dismissAgentCards', () => {
+  it('clears agent cards but keeps the panels the user opened', () => {
+    togglePanel('pendencias')
+    pushAgentCard(card('a'), 'a')
+    pushAgentCard(card('b'), 'b')
+
+    dismissAgentCards()
+
+    const cards = $faceCards.get()
+
+    expect(cards).toHaveLength(1)
+    expect(isPanelOpen(cards, 'pendencias')).toBe(true)
+  })
+
+  it('keeps the same array when there is nothing to drop', () => {
+    togglePanel('sistemas')
+    const before = $faceCards.get()
+
+    dismissAgentCards()
+
+    expect($faceCards.get()).toBe(before)
+  })
+})
diff --git a/apps/desktop/src/store/jarvis-face-cards.ts b/apps/desktop/src/store/jarvis-face-cards.ts
new file mode 100644
index 00000000000..45dfc090a5f
--- /dev/null
+++ b/apps/desktop/src/store/jarvis-face-cards.ts
@@ -0,0 +1,138 @@
+import { atom } from 'nanostores'
+
+import type { AgentCard } from '@/lib/jarvis-face/cards'
+
+export type FacePanel = 'lembretes' | 'pendencias' | 'sistemas'
+
+export type FaceCardSource = { card: AgentCard; type: 'agent' } | { panel: FacePanel; type: 'panel' }
+
+export interface FaceCard {
+  id: string
+  source: FaceCardSource
+  x: number
+  y: number
+  /** Stacking order; the last touched card is on top. */
+  z: number
+}
+
+export const CARD_WIDTH = 360
+export const MAX_AGENT_CARDS = 6
+const SEEN_LIMIT = 300
+
+export const $faceCards = atom<FaceCard[]>([])
+
+let zCounter = 1
+const seen = new Set<string>()
+
+/**
+ * Fan cards out in columns from the right edge, then cascade down within a column.
+ * On a narrow window there is one column, so it degrades to a plain cascade.
+ */
+export function placeCard(index: number, viewport: { height: number; width: number }): { x: number; y: number } {
+  const columns = Math.max(1, Math.floor((viewport.width - 40) / (CARD_WIDTH + 16)))
+  const column = index % columns
+  const row = Math.floor(index / columns)
+  const x = Math.max(16, viewport.width - CARD_WIDTH - 24 - column * (CARD_WIDTH + 16) - (columns === 1 ? (row % 4) * 28 : 0))
+  const y = Math.min(Math.max(16, viewport.height - 260), 72 + (row % 5) * 52)
+
+  return { x, y }
+}
+
+const viewport = () => ({ height: window.innerHeight, width: window.innerWidth })
+
+function insert(id: string, source: FaceCardSource): void {
+  const cards = $faceCards.get()
+
+  if (cards.some(card => card.id === id)) {
+    return
+  }
+
+  const kept = source.type === 'agent' ? trimAgentCards(cards) : cards
+  const { x, y } = placeCard(kept.length, viewport())
+
+  $faceCards.set([...kept, { id, source, x, y, z: zCounter++ }])
+}
+
+/** Keep room for one more agent card: drop the oldest when at the cap. */
+function trimAgentCards(cards: FaceCard[]): FaceCard[] {
+  const agent = cards.filter(card => card.source.type === 'agent')
+
+  if (agent.length < MAX_AGENT_CARDS) {
+    return cards
+  }
+
+  const oldest = agent[0]!
+
+  return cards.filter(card => card.id !== oldest.id)
+}
+
+/** Add an agent card once per `key` (message id + index), even if it was dismissed since. */
+export function pushAgentCard(card: AgentCard, key: string): boolean {
+  if (seen.has(key)) {
+    return false
+  }
+
+  seen.add(key)
+
+  if (seen.size > SEEN_LIMIT) {
+    seen.delete(seen.values().next().value as string)
+  }
+
+  insert(`agent:${key}`, { card, type: 'agent' })
+
+  return true
+}
+
+/** Mark a message's cards as already handled (used for history that was there when the face opened). */
+export function markCardKeySeen(key: string): void {
+  seen.add(key)
+}
+
+export function togglePanel(panel: FacePanel): void {
+  const id = `panel:${panel}`
+
+  if ($faceCards.get().some(card => card.id === id)) {
+    dismissCard(id)
+
+    return
+  }
+
+  insert(id, { panel, type: 'panel' })
+}
+
+export function isPanelOpen(cards: readonly FaceCard[], panel: FacePanel): boolean {
+  return cards.some(card => card.id === `panel:${panel}`)
+}
+
+export function dismissCard(id: string): void {
+  $faceCards.set($faceCards.get().filter(card => card.id !== id))
+}
+
+/** Drop what the agent put on screen (cards); panels the user opened stay. */
+export function dismissAgentCards(): void {
+  const kept = $faceCards.get().filter(card => card.source.type === 'panel')
+
+  if (kept.length !== $faceCards.get().length) {
+    $faceCards.set(kept)
+  }
+}
+
+export function moveCard(id: string, x: number, y: number): void {
+  $faceCards.set($faceCards.get().map(card => (card.id === id ? { ...card, x, y } : card)))
+}
+
+export function raiseCard(id: string): void {
+  const cards = $faceCards.get()
+  const top = cards.reduce((max, card) => Math.max(max, card.z), 0)
+
+  if (cards.find(card => card.id === id)?.z === top) {
+    return
+  }
+
+  $faceCards.set(cards.map(card => (card.id === id ? { ...card, z: zCounter++ } : card)))
+}
+
+export function resetFaceCards(): void {
+  $faceCards.set([])
+  seen.clear()
+}
