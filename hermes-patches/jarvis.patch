@@ -0,0 +1,67 @@
+import { execSync } from 'node:child_process'
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url))
+const desktopRoot = path.resolve(__dirname, '..')
+const distDir = path.join(desktopRoot, 'dist')
+const resourcesDir = path.join(desktopRoot, 'release', 'win-unpacked', 'resources')
+const asarPath = path.join(resourcesDir, 'app.asar')
+const asarUnpackedDist = path.join(resourcesDir, 'app.asar.unpacked', 'dist')
+const tempExtractDir = path.join(resourcesDir, '.temp-asar-extract')
+const asarNewPath = path.join(resourcesDir, 'app.asar.new')
+const productIdentitySrc = path.join(desktopRoot, 'product-identity.cjs')
+
+console.log('[patch-app] Starting app update for win-unpacked...')
+
+// Kill any running Hermes process first
+try {
+  execSync('taskkill /F /IM Hermes.exe /T', { stdio: 'ignore' })
+} catch {}
+
+if (!fs.existsSync(asarPath)) {
+  console.error('[patch-app] Error: app.asar not found at', asarPath)
+  process.exit(1)
+}
+
+// 1. Extract app.asar
+if (fs.existsSync(tempExtractDir)) {
+  fs.rmSync(tempExtractDir, { recursive: true, force: true })
+}
+console.log('[patch-app] Extracting current app.asar...')
+execSync(`npx asar extract "${asarPath}" "${tempExtractDir}"`, { cwd: desktopRoot, stdio: 'inherit' })
+
+// 2. Copy updated dist to tempExtractDir/dist and product-identity
+console.log('[patch-app] Copying fresh dist to extracted tree...')
+fs.cpSync(distDir, path.join(tempExtractDir, 'dist'), { recursive: true })
+if (fs.existsSync(productIdentitySrc)) {
+  fs.copyFileSync(productIdentitySrc, path.join(tempExtractDir, 'product-identity.cjs'))
+  fs.copyFileSync(productIdentitySrc, path.join(tempExtractDir, 'dist', 'product-identity.cjs'))
+}
+
+// 3. Copy updated dist to app.asar.unpacked/dist
+if (fs.existsSync(asarUnpackedDist)) {
+  console.log('[patch-app] Copying fresh dist to app.asar.unpacked/dist...')
+  fs.cpSync(distDir, asarUnpackedDist, { recursive: true })
+}
+
+// 4. Repack asar archive
+console.log('[patch-app] Repacking app.asar...')
+execSync(`npx asar pack "${tempExtractDir}" "${asarNewPath}" --unpack "dist/**" --unpack "**/*.node"`, {
+  cwd: desktopRoot,
+  stdio: 'inherit'
+})
+
+// 5. Swap app.asar
+console.log('[patch-app] Swapping app.asar...')
+const asarBackupPath = path.join(resourcesDir, 'app.asar.bak')
+if (fs.existsSync(asarBackupPath)) {
+  fs.rmSync(asarBackupPath, { force: true })
+}
+fs.renameSync(asarPath, asarBackupPath)
+fs.renameSync(asarNewPath, asarPath)
+
+// 6. Cleanup
+fs.rmSync(tempExtractDir, { recursive: true, force: true })
+console.log('[patch-app] Win-unpacked Hermes.exe successfully updated with fresh Jarvis UI!')
diff --git a/apps/desktop/scripts/rig-reconstructed.py b/apps/desktop/scripts/rig-reconstructed.py
new file mode 100644
index 00000000000..5f769c4d8ff
--- /dev/null
+++ b/apps/desktop/scripts/rig-reconstructed.py
@@ -0,0 +1,114 @@
+from pathlib import Path
+import trimesh
+import numpy as np
+import struct
+
+ROOT=Path(__file__).resolve().parents[1]/'src/lib/jarvis-face/assets'
+mesh=trimesh.load(ROOT/'reference-head.glb',force='scene').to_geometry()
+# Weld only for component identification: preserve the original surface and UV seams.
+_,inverse=np.unique(np.round(mesh.vertices,5),axis=0,return_inverse=True)
+parents=list(range(int(inverse.max())+1))
+def find(i):
+    while parents[i]!=i:
+        parents[i]=parents[parents[i]]
+        i=parents[i]
+    return i
+for a,b,c in inverse[mesh.faces]:
+    ra,rb,rc=find(int(a)),find(int(b)),find(int(c))
+    parents[rb]=ra
+    parents[rc]=ra
+roots=np.array([find(int(i)) for i in inverse])
+labels,counts=np.unique(roots,return_counts=True)
+main=labels[np.argmax(counts)]
+keep=(roots[mesh.faces[:,0]]==main)&(mesh.triangles_center[:,1]>-.425)
+mesh.update_faces(keep)
+mesh.remove_unreferenced_vertices()
+scale=2.05
+positions=mesh.vertices.copy()*scale
+face_normals=np.cross(positions[mesh.faces[:,1]]-positions[mesh.faces[:,0]],positions[mesh.faces[:,2]]-positions[mesh.faces[:,0]])
+unique_positions,normal_map=np.unique(np.round(positions,6),axis=0,return_inverse=True)
+welded_normals=np.zeros_like(unique_positions)
+for corner in range(3): np.add.at(welded_normals,normal_map[mesh.faces[:,corner]],face_normals)
+normal_lengths=np.linalg.norm(welded_normals,axis=1,keepdims=True)
+welded_normals/=np.maximum(normal_lengths,1e-12)
+normals=welded_normals[normal_map]
+original_normals=np.zeros_like(positions)
+for corner in range(3): np.add.at(original_normals,mesh.faces[:,corner],face_normals)
+original_normals/=np.maximum(np.linalg.norm(original_normals,axis=1,keepdims=True),1e-20)
+normals[normal_lengths[normal_map,0]<1e-10]=original_normals[normal_lengths[normal_map,0]<1e-10]
+vertices=[]
+faces=[]
+def smooth(a,b,x):
+    t=np.clip((x-a)/(b-a),0,1)
+    return t*t*(3-2*t)
+def seam(x): return (-.134-.009*(abs(x/scale)/.135)**2)*scale
+def append(p,n,side=0,part=None):
+    x,y,z=p
+    mouth=smooth(.30,.34,z/scale)*(1-smooth(.115,.145,abs(x)/scale))
+    below=1-smooth(seam(x)-.008*scale,seam(x)+.008*scale,y)
+    if side: below=1 if side<0 else 0
+    jaw_weight=below*(1-smooth(.25,.34,abs(x)/scale))*smooth(-.10,.25,z/scale)
+    angle=.085
+    dy=((y-.13*scale)*(np.cos(angle)-1)-(z+.04*scale)*np.sin(angle))*jaw_weight
+    dz=((y-.13*scale)*np.sin(angle)+(z+.04*scale)*(np.cos(angle)-1))*jaw_weight
+    if side>0 or (y>=seam(x) and y<-.09*scale):
+        dy += .013*mouth*(1-smooth(seam(x),-.085*scale,y))
+    eye_y=(.145+.14*(abs(x)/scale-.145))*scale
+    eye_x=(abs(x)/scale-.15)/.085
+    eye_d=(y-eye_y)/(scale*.027)
+    eye=abs(eye_x)<1 and abs(eye_d)<1 and z/scale>.205
+    blink=np.zeros(3)
+    if not eye:
+        lid=(1-smooth(.085,.11,abs(abs(x)/scale-.15)))*(1-smooth(.030,.067,abs(y-eye_y)/scale))*smooth(.19,.24,z/scale)
+        blink[1]=(eye_y-y)*lid
+    if part is None:
+        part=4 if eye else (6 if mouth>.2 and abs(y-seam(x))<.06*scale else 0)
+    uv=[(np.arctan2(x,z)+np.pi)/(2*np.pi),(y/scale+.5)]
+    if part==6 and side and abs(y-seam(x))<1e-5: part=7 if side>0 else 8
+    dn=np.array([0,-n[2]*np.sin(angle),n[1]*np.sin(angle)])*jaw_weight
+    vertices.append([*p,*n,*uv,part,0,dy,dz,*blink,0,0,0,*dn,0,0,0])
+    return len(vertices)-1
+for p,n in zip(positions,normals): append(p,n)
+# Split triangles along the existing closed lip seam, rather than cutting an oval hole.
+for tri in mesh.faces:
+    ps=positions[tri]
+    vals=np.array([p[1]-seam(p[0]) for p in ps])
+    active=np.all(abs(ps[:,0])<.14*scale) and np.all(ps[:,2]>.315*scale) and vals.min()<0<vals.max()
+    if not active:
+        faces.append(list(map(int,tri)))
+        continue
+    for side in [1,-1]:
+        polygon=[]
+        for i in range(3):
+            j=(i+1)%3
+            if vals[i]*side>=0: polygon.append((ps[i],normals[tri[i]]))
+            if vals[i]*vals[j]<0:
+                t=vals[i]/(vals[i]-vals[j])
+                p=ps[i]*(1-t)+ps[j]*t
+                p[1]=seam(p[0])
+                n=normals[tri[i]]*(1-t)+normals[tri[j]]*t
+                polygon.append((p,n/np.linalg.norm(n)))
+        ids=[append(p,n,side) for p,n in polygon]
+        faces.extend([[ids[0],ids[i],ids[i+1]] for i in range(1,len(ids)-1)])
+# A recessed mouth chamber and upper teeth remain behind the actual articulated lips.
+def strip(part,ys,zs,width,segments=48):
+    rows=[]
+    for y,z in zip(ys,zs):
+        row=[]
+        for x in np.linspace(-width,width,segments+1):
+            p=np.array([x,y,z-.10*(x/width)**2])
+            row.append(append(p,np.array([0.,0.,1.]),part=part))
+        rows.append(row)
+    for a,b in zip(rows,rows[1:]):
+        for i in range(segments): faces.extend([[a[i],a[i+1],b[i]],[a[i+1],b[i+1],b[i]]])
+strip(1,[-.23*scale,-.09*scale],[.27*scale,.27*scale],.125*scale)
+strip(3,[-.152*scale,-.133*scale],[.30*scale,.30*scale],.094*scale)
+# Remove unused vertices after lip splitting; UInt32 indices support the reconstructed mesh.
+v=np.asarray(vertices,dtype='<f4')
+f=np.asarray(faces,dtype=np.uint32)
+used,inverse=np.unique(f,return_inverse=True)
+v=v[used]
+f=inverse.reshape(-1,3).astype('<u4')
+payload=struct.pack('<4I',0x4a524932,len(v),f.size,24)+v.tobytes()+f.tobytes()
+(ROOT/'humanoid-rig.bin').write_bytes(payload)
+print({'vertices':len(v),'triangles':len(f),'parts':np.unique(v[:,8]).tolist(),'bounds':[v[:,:3].min(0).tolist(),v[:,:3].max(0).tolist()]})
