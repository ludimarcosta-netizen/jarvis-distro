         assert "extra_content" in msgs[1]["tool_calls"][1]
 
 
+class TestChatCompletionsCrossProviderThoughtSignature:
+    """A fallback onto Gemini replays tool calls another provider made, which carry no
+    thought signature; Gemini rejects them with HTTP 400 unless the skip sentinel is sent."""
+
+    @staticmethod
+    def _call(call_id, extra_content=None):
+        tc = {"id": call_id, "type": "function", "function": {"name": "terminal", "arguments": "{}"}}
+        if extra_content is not None:
+            tc["extra_content"] = extra_content
+        return tc
+
+    def _history(self, *tool_calls):
+        return [
+            {"role": "user", "content": "go"},
+            {"role": "assistant", "content": "", "tool_calls": list(tool_calls)},
+            *({"role": "tool", "tool_call_id": tc["id"], "content": "ok"} for tc in tool_calls),
+        ]
+
+    def test_foreign_tool_calls_get_the_skip_sentinel_for_gemini(self, transport):
+        msgs = self._history(self._call("a"), self._call("b"))
+
+        result = transport.convert_messages(msgs, model="google/gemini-3.6-flash")
+
+        for tc in result[1]["tool_calls"]:
+            assert tc["extra_content"] == {"google": {"thought_signature": "skip_thought_signature_validator"}}
+        assert all("extra_content" not in tc for tc in msgs[1]["tool_calls"])  # stored history untouched
+
+    def test_gemini_own_parallel_turn_keeps_its_unsigned_siblings(self, transport):
+        signed = self._call("a", {"google": {"thought_signature": "REAL"}})
+        sibling = self._call("b")
+        msgs = self._history(signed, sibling)
+
+        result = transport.convert_messages(msgs, model="google/gemini-3.6-flash")
+
+        assert result[1]["tool_calls"][0]["extra_content"] == {"google": {"thought_signature": "REAL"}}
+        assert "extra_content" not in result[1]["tool_calls"][1]
+
+    def test_non_gemini_target_never_gets_the_sentinel(self, transport):
+        msgs = self._history(self._call("a"))
+
+        result = transport.convert_messages(msgs, model="gpt-4o")
+
+        assert "extra_content" not in result[1]["tool_calls"][0]
+
+
 
