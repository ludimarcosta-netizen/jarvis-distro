@@ -0,0 +1,72 @@
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { $jarvisFaceOpen, $jarvisVoice, type JarvisVoiceState } from '@/store/jarvis-face'
+
+import { JarvisHudHeader } from './jarvis-hud-header'
+import { JarvisPresence, presenceMood } from './jarvis-presence'
+
+vi.mock('@/store/jarvis-face', async () => {
+  const { atom } = await import('nanostores')
+  const faceOpen = atom(false)
+
+  return {
+    $jarvisFaceOpen: faceOpen,
+    $jarvisVoice: atom({ status: 'idle', speaking: false, listening: false, delegation: null, pending: null }),
+    setJarvisFaceOpen: (open: boolean) => faceOpen.set(open)
+  }
+})
+vi.mock('@/components/jarvis-face/humanoid-face', () => ({
+  HumanoidFace: ({ mood }: { mood: string }) => <canvas data-mood={mood} data-testid="portrait" />
+}))
+const idle: JarvisVoiceState = { status: 'idle', speaking: false, listening: false, delegation: null, pending: null }
+
+beforeEach(() => {
+  $jarvisFaceOpen.set(false)
+  $jarvisVoice.set(idle)
+})
+afterEach(cleanup)
+
+describe('Jarvis workspace', () => {
+  it('shows activity from voice events and clears it when idle', () => {
+    render(<JarvisHudHeader />)
+    expect(screen.getByRole('status').textContent).toBe('')
+    act(() => $jarvisVoice.set({ ...idle, listening: true }))
+    expect(screen.getByRole('status').textContent).toBe('Ouvindo')
+    act(() => $jarvisVoice.set({ ...idle, speaking: true }))
+    expect(screen.getByRole('status').textContent).toBe('Falando')
+    act(() => $jarvisVoice.set(idle))
+    expect(screen.getByRole('status').textContent).toBe('')
+  })
+  it('keeps voice failure and confirmation visible while a turn is busy', () => {
+    render(<JarvisHudHeader busy />)
+    expect(screen.getByRole('status').textContent).toBe('Pensando')
+    act(() => $jarvisVoice.set({ ...idle, status: 'error' }))
+    expect(screen.getByRole('status').textContent).toBe('Voz indisponível')
+    act(() =>
+      $jarvisVoice.set({ ...idle, pending: { id: 'approval', digest: 'digest', request: 'request', remaining_s: 20 } })
+    )
