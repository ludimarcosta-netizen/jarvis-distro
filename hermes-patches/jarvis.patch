+@pytest.mark.parametrize("text, period", [
+    ("Quais os compromissos de hoje?", (0, 0)),
+    ("Jarvis, quais são os meus compromissos?", (0, 0)),
+    ("minha agenda de amanhã", (1, 0)),
+    ("compromissos para amanhã", (1, 0)),
+    ("O que eu tenho pra hoje?", (0, 0)),
+    ("tenho algum compromisso amanhã?", (1, 0)),
+    ("me mostra a agenda da semana", (0, 6)),
