+import { connectionScoped, hermesApi } from './client'
+
+const BASE = '/api/plugins/gemini-live-bridge'
+
+export interface Pendencia {
+  id: number
+  descricao: string
+  responsavel: null | string
+  prazo: null | string
+  created_at: null | string
+  ata_titulo: null | string
+}
+
+export interface SystemCheck {
+  id: string
+  label: string
+  status: 'off' | 'ok' | 'warn'
+  detail: string
+}
+
+export function getPendencias(): Promise<Pendencia[]> {
+  return hermesApi<{ items: Pendencia[] }>({ ...connectionScoped(), path: `${BASE}/pendencias` }).then(
+    response => response.items
+  )
+}
+
+/** Only ever called from the user's own click in the pendências panel. */
+export function concluirPendencia(id: number): Promise<{ ok: boolean }> {
+  return hermesApi<{ ok: boolean }>({ ...connectionScoped(), method: 'POST', path: `${BASE}/pendencias/${id}/concluir` })
+}
+
+export function getSistemas(): Promise<SystemCheck[]> {
+  return hermesApi<{ checks: SystemCheck[] }>({ ...connectionScoped(), path: `${BASE}/sistemas` }).then(
+    response => response.checks
+  )
+}
