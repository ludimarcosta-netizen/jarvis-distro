+import { describe, expect, it } from 'vitest'
+
+import { PortraitMotion } from './portrait-motion'
+
+describe('fixed portrait articulation', () => {
+  it('keeps the lips still outside speech, opens with playback and closes on silence', () => {
+    const motion = new PortraitMotion(() => 0)
+    motion.setSpeechLevel(0.8, 0)
+    expect(motion.frame(0.01, 0.01).mouth).toBe(0)
+    motion.setMood('speaking')
+    expect(motion.frame(0.1, 0.09).mouth).toBeGreaterThan(0.6)
+    motion.setSpeechLevel(0, 0.1)
+    expect(motion.frame(0.28, 0.18).mouth).toBeLessThan(0.04)
+  })
+
+  it('does not leave the mouth open when playback amplitude stops arriving', () => {
+    const motion = new PortraitMotion(() => 0)
+    motion.setMood('speaking')
+    motion.setSpeechLevel(1, 0)
+    expect(motion.frame(0.1, 0.1).mouth).toBeGreaterThan(0.9)
+    expect(motion.frame(0.5, 0.4).mouth).toBeLessThan(0.001)
+  })
+
+  it('uses fallback only for missing amplitude, never for measured silence', () => {
+    const motion = new PortraitMotion(() => 0)
+    motion.setMood('speaking')
+    expect(motion.frame(0.1, 0.1).mouth).toBeGreaterThan(0)
+    motion.setSpeechLevel(0, 0.1)
+    expect(motion.frame(0.29, 0.19).mouth).toBeLessThan(0.01)
+    motion.setSpeechLevel(null, 0.3)
+    expect(motion.frame(0.4, 0.1).mouth).toBeGreaterThan(0.1)
+    motion.setMood('listening')
+    expect(motion.frame(0.7, 0.3).mouth).toBeLessThan(0.003)
+  })
+
+  it('closes and reopens both lids within a brief periodic blink', () => {
+    const motion = new PortraitMotion(() => 0)
+    expect(motion.frame(2.79, 0.01).blink).toBe(0)
+    expect(motion.frame(2.91, 0.01).blink).toBeCloseTo(1)
+    expect(motion.frame(3.03, 0.01).blink).toBe(0)
+    expect(motion.frame(5.94, 0.01).blink).toBeCloseTo(1)
+  })
+
+  it('asks for the smooth cadence just before and during a blink, and while the lips move', () => {
+    const motion = new PortraitMotion(() => 0)
+    motion.frame(1, 0.1)
+    expect(motion.moving(1)).toBe(false)
+    expect(motion.moving(2.7)).toBe(true)
+    motion.frame(3.1, 0.1)
+    expect(motion.moving(3.1)).toBe(false)
+    motion.setMood('speaking')
+    motion.setSpeechLevel(1, 3.1)
+    motion.frame(3.2, 0.1)
+    expect(motion.moving(3.2)).toBe(true)
+    motion.setMood('open')
+    motion.frame(4, 0.8)
+    expect(motion.moving(4)).toBe(false)
+  })
+})
diff --git a/apps/desktop/src/lib/jarvis-face/portrait-motion.ts b/apps/desktop/src/lib/jarvis-face/portrait-motion.ts
new file mode 100644
index 00000000000..91f3b747611
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/portrait-motion.ts
@@ -0,0 +1,47 @@
+import { blinkOpenness } from './face-motion'
+import type { HumanoidMood } from './humanoid-renderer'
+
+// Start the smooth cadence this early, so a blink never begins between two slow idle frames.
+const BLINK_LEAD_S = 0.15
+
+/** Playback amplitude controls articulation; missing analysers get a quiet syllabic fallback. */
+export class PortraitMotion {
+  private mood: HumanoidMood = 'open'
+  private level: number | null = null
+  private receivedAt = 0
+  private opening = 0
+  private blinkAt: number
+
+  constructor(private readonly random: () => number = Math.random) {
+    this.blinkAt = 2.8 + random() * 2
+  }
+
+  setMood(mood: HumanoidMood): void {
+    this.mood = mood
+  }
+
+  setSpeechLevel(level: number | null, time: number): void {
+    this.level = level === null ? null : Math.max(0, Math.min(1, level))
+    this.receivedAt = time
+  }
+
+  frame(time: number, delta: number): { mouth: number; blink: number } {
+    const fallback = Math.abs(Math.sin(time * 9.7)) * Math.abs(Math.sin(time * 3.1)) * 0.48
+    const amplitude = this.level === null ? fallback : time - this.receivedAt < 0.3 ? this.level ** 0.65 : 0
+    const target = this.mood === 'speaking' ? amplitude : 0
+    this.opening += (target - this.opening) * (1 - Math.exp(-delta * (target > this.opening ? 28 : 18)))
+    const progress = (time - this.blinkAt) / 0.22
+    const blink = progress >= 0 && progress <= 1 ? 1 - blinkOpenness(progress, 1) : 0
+
+    if (progress > 1) {
+      this.blinkAt = time + 2.8 + this.random() * 3.6
+    }
+
+    return { mouth: this.opening, blink }
+  }
+
+  /** True while the lips move or a blink is due: the renderer should draw at full cadence. */
+  moving(time: number): boolean {
+    return this.mood === 'speaking' || this.opening > 0.001 || time >= this.blinkAt - BLINK_LEAD_S
+  }
+}
diff --git a/apps/desktop/src/lib/jarvis-face/portrait-renderer.ts b/apps/desktop/src/lib/jarvis-face/portrait-renderer.ts
new file mode 100644
index 00000000000..6f108db3853
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/portrait-renderer.ts
@@ -0,0 +1,215 @@
+import portraitUrl from './assets/fixed-portrait.png?url'
+import { canvasPixelRatio, createFrameLoop } from './frame-scheduler'
+import type { HumanoidMood } from './humanoid-renderer'
+import { PortraitMotion } from './portrait-motion'
+
+export type { HumanoidMood } from './humanoid-renderer'
+
+export interface Portrait {
+  ready: Promise<void>
+  setMood: (mood: HumanoidMood) => void
+  setSpeechLevel: (level: number | null) => void
+  dispose: () => void
+}
+
+const VERTEX = `#version 300 es
+in vec2 aPosition;
+out vec2 vUv;
+void main(){
+  gl_Position=vec4(aPosition,0.,1.);
+  vUv=vec2(aPosition.x*.5+.5,.5-aPosition.y*.5);
+}`
+
+// All coordinates refer to the supplied 1254px illustration. No projection or head rotation.
+// Only connected lid/lip regions resample their original pixels; everything else stays fixed.
+const FRAGMENT = `#version 300 es
+precision highp float;
+uniform sampler2D uPortrait;
+uniform float uMouth;
+uniform float uBlink;
+in vec2 vUv;
+out vec4 outColor;
+vec4 portrait(vec2 p){return texture(uPortrait,p/1254.);}
+float falloff(float distance,float radius){return 1.-smoothstep(0.,radius,abs(distance));}
+vec2 eyelid(vec2 p,float cx,float slope){
+  float x=(p.x-cx)/82.;
+  if(abs(x)>=1. || uBlink<=0.)return p;
+  float arc=sqrt(max(0.,1.-x*x));
+  float cy=489.+(p.x-cx)*slope;
+  float h=25.*arc;
+  float upper=cy-h,lower=cy+h;
+  float top=upper+2.*h*.72*uBlink,bottom=lower-2.*h*.28*uBlink;
+  if(p.y<top){p.y-=2.*h*.72*uBlink*falloff(p.y-top,52.);}
+  else if(p.y>bottom){p.y+=2.*h*.28*uBlink*falloff(p.y-bottom,40.);}
+  else{p.y=mix(upper,lower,(p.y-top)/max(bottom-top,.001));}
+  return p;
+}
+void main(){
+  vec2 p=vec2(198.,22.)+vUv*vec2(860.,1208.);
+  vec2 source=eyelid(eyelid(p,474.,.12),786.,-.12);
+  float x=(p.x-627.)/136.;
+  float lip=pow(max(0.,1.-x*x),1.35);
+  float seam=796.+7.*lip;
+  float upper=seam-4.5*uMouth*lip;
+  float lower=seam+19.*uMouth*lip;
+  bool interior=abs(x)<1. && p.y>upper && p.y<lower && uMouth>.001;
+  if(abs(x)<1. && !interior){
+    float shift=p.y<seam ? -4.5*uMouth*lip : 19.*uMouth*lip;
+    float edge=p.y<seam ? upper : lower;
+    source.y-=shift*falloff(p.y-edge,p.y<seam ? 46. : 125.);
+  }
+  vec4 color=portrait(source);
+  if(interior){
+    // Expand the existing recessed seam between the two moving original lips.
+    // The opening tapers to zero at both corners; no independent oval or lip drawing.
+    float t=(p.y-upper)/max(lower-upper,.001);
+    color=portrait(vec2(p.x,seam+mix(-1.5,3.,t)));
+    color.rgb*=mix(.36,.74,pow(abs(t-.5)*2.,2.));
+  }
+  // The supplied cutout has isolated specks outside the head and its base.
+  float halfWidth=p.y<330. ? 345.*sqrt(max(0.,1.-pow((p.y-330.)/308.,2.)))+8.
+    : p.y<940. ? 410. : p.y<1100. ? 430. : 430.-(p.y-1100.)*.8;
+  float silhouette=1.-smoothstep(halfWidth,halfWidth+3.,abs(p.x-628.));
+  float alpha=color.a*.76*silhouette;
+  outColor=vec4(color.rgb*alpha,alpha);
+}`
+
+function compile(gl: WebGL2RenderingContext, type: number, source: string): WebGLShader {
+  const shader = gl.createShader(type)
+
+  if (!shader) {
+    throw new Error('Portrait shader allocation failed')
+  }
+
+  gl.shaderSource(shader, source)
+  gl.compileShader(shader)
+
+  if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
+    const message = gl.getShaderInfoLog(shader) ?? 'Portrait shader compilation failed'
+    gl.deleteShader(shader)
+    throw new Error(message)
+  }
+
+  return shader
+}
+
+export function createPortrait(canvas: HTMLCanvasElement): Portrait | null {
+  const gl = canvas.getContext('webgl2', { alpha: true, antialias: false })
+
+  if (!gl) {
+    return null
+  }
+
+  const program = gl.createProgram()
+  const buffer = gl.createBuffer()
+  const texture = gl.createTexture()
+
+  if (!program || !buffer || !texture) {
+    throw new Error('Portrait allocation failed')
+  }
+
+  const vertex = compile(gl, gl.VERTEX_SHADER, VERTEX)
+  const fragment = compile(gl, gl.FRAGMENT_SHADER, FRAGMENT)
+  gl.attachShader(program, vertex)
+  gl.attachShader(program, fragment)
+  gl.linkProgram(program)
+  gl.deleteShader(vertex)
+  gl.deleteShader(fragment)
+
+  if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
+    throw new Error(gl.getProgramInfoLog(program) ?? 'Portrait link failed')
+  }
+
+  gl.useProgram(program)
+  gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
+  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW)
+  const position = gl.getAttribLocation(program, 'aPosition')
+  gl.enableVertexAttribArray(position)
+  gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0)
+  gl.bindTexture(gl.TEXTURE_2D, texture)
+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR)
+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR)
+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
+  gl.uniform1i(gl.getUniformLocation(program, 'uPortrait'), 0)
+  const mouth = gl.getUniformLocation(program, 'uMouth')
+  const blink = gl.getUniformLocation(program, 'uBlink')
+  gl.enable(gl.BLEND)
+  gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA)
+  gl.clearColor(0, 0, 0, 0)
+  const motion = new PortraitMotion()
+  let disposed = false
+  let loaded = false
+  // What is on the canvas now; null when it must be painted again (new texture, resize).
+  let drawn: { mouth: number; blink: number } | null = null
+
+  const resize = () => {
+    const ratio = canvasPixelRatio(window.devicePixelRatio)
+    canvas.width = Math.max(1, Math.round(canvas.clientWidth * ratio))
+    canvas.height = Math.max(1, Math.round(canvas.clientHeight * ratio))
+    gl.viewport(0, 0, canvas.width, canvas.height)
+    drawn = null
+  }
+
+  resize()
+
+  // The still portrait only changes while the lips move or the lids blink: other frames draw nothing.
+  const render = (now: number, dt: number): boolean => {
+    const time = now / 1000
+    const expression = motion.frame(time, Math.min(0.1, dt))
+
+    if (
+      loaded &&
+      (drawn === null || Math.abs(expression.mouth - drawn.mouth) > 1e-3 || Math.abs(expression.blink - drawn.blink) > 1e-3)
+    ) {
+      gl.clear(gl.COLOR_BUFFER_BIT)
+      gl.uniform1f(mouth, expression.mouth)
+      gl.uniform1f(blink, expression.blink)
+      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)
+      drawn = expression
+    }
+
+    return motion.moving(time)
+  }
+
+  const loop = createFrameLoop(render)
+
+  const observer = new ResizeObserver(() => {
+    resize()
+    loop.wake()
+  })
+
+  observer.observe(canvas)
+
+  const image = new Image()
+  image.src = portraitUrl
+
+  const ready = image.decode().then(() => {
+    if (disposed) {
+      return
+    }
+
+    gl.bindTexture(gl.TEXTURE_2D, texture)
+    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image)
+    loaded = true
+    drawn = null
+    loop.wake()
+  })
+
+  return {
+    ready,
+    setMood: mood => {
+      motion.setMood(mood)
+      loop.setVoiceActive(mood === 'speaking')
+    },
+    setSpeechLevel: level => motion.setSpeechLevel(level, performance.now() / 1000),
+    dispose: () => {
+      disposed = true
+      loop.dispose()
+      observer.disconnect()
+      gl.deleteTexture(texture)
+      gl.deleteBuffer(buffer)
+      gl.deleteProgram(program)
+    }
+  }
+}
diff --git a/apps/desktop/src/lib/jarvis-face/reference-head.test.ts b/apps/desktop/src/lib/jarvis-face/reference-head.test.ts
