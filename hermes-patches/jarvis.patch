@@ -0,0 +1,45 @@
+import { useStore } from '@nanostores/react'
+
+import { Button } from '@/components/ui/button'
+import { Maximize } from '@/lib/icons'
+import { cn } from '@/lib/utils'
+import { $jarvisVoice, setJarvisFaceOpen } from '@/store/jarvis-face'
+
+export interface JarvisHudHeaderProps {
+  busy?: boolean
+  className?: string
+}
+
+export function JarvisHudHeader({ busy = false, className }: JarvisHudHeaderProps) {
+  const voice = useStore($jarvisVoice)
+
+  const status =
+    voice.status === 'error'
+      ? 'Voz indisponível'
+      : voice.status === 'connecting'
+        ? 'Conectando voz'
+        : voice.pending
+          ? 'Aguardando confirmação'
+          : voice.delegation?.status === 'running'
+            ? 'Executando pedido'
+            : voice.speaking
+              ? 'Falando'
+              : voice.listening
+                ? 'Ouvindo'
+                : busy
+                  ? 'Pensando'
+                  : null
+
+  return (
+    <div className={cn('jarvis-workspace-header', className)}>
+      <span className="jarvis-workspace-name">JARVIS</span>
+      <span aria-live="polite" className="jarvis-workspace-status" role="status">
+        {status}
+      </span>
+      <Button aria-label="Abrir modo face" onClick={() => setJarvisFaceOpen(true)} size="sm" variant="ghost">
+        <Maximize aria-hidden />
+        <span>Modo face</span>
+      </Button>
+    </div>
+  )
+}
