+"""Jarvis (fork local): atalho sem modelo para "abre o X" / "procura Y no YouTube"."""
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from agent import jarvis_fast_actions as fa
+
+
+class FakeAbrir:
+    def __init__(self, open_result=None):
+        self.opened, self.searched = [], []
+        self.open_result = open_result or {"ok": True, "mensagem": "Abri Spotify.", "opcoes": []}
+
+    def open_app(self, nome):
+        self.opened.append(nome)
+        return self.open_result
+
+    def search(self, onde, termo):
+        self.searched.append((onde, termo))
+        return {"ok": True, "mensagem": f"Abri a busca por “{termo}” no YouTube.", "opcoes": []}
+
+
+@pytest.fixture
+def abrir():
+    fake = FakeAbrir()
+    with patch.object(fa, "_abrir", return_value=fake):
+        yield fake
+
+
+AGENT = SimpleNamespace(_parent_session_id=None)
+
+
+@pytest.mark.parametrize("text, nome", [
+    ("abre o spotify", "spotify"),
+    ("Jarvis, abre o Spotify.", "spotify"),
+    ("abra o aplicativo do whatsapp por favor", "whatsapp"),
+    ("Abre a calculadora pra mim", "calculadora"),
