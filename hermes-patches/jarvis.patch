--- /dev/null
+++ b/apps/desktop/src/components/jarvis-face/face-overlay.tsx
@@ -0,0 +1,381 @@
+import { useStore } from '@nanostores/react'
+import { type FormEvent, useEffect, useMemo, useRef, useState } from 'react'
+
+import { Slot } from '@/contrib/react/slot'
+import { chatMessageText } from '@/lib/chat-messages/parts'
+import { X } from '@/lib/icons'
+import { extractCards } from '@/lib/jarvis-face/cards'
+import { isFaceIdle, messageIds, replyAfter } from '@/lib/jarvis-face/conversation'
+import { createGalaxy, type Galaxy, type GalaxyHover } from '@/lib/jarvis-face/galaxy-renderer'
+import type { HumanoidMood } from '@/lib/jarvis-face/humanoid-renderer'
+import { everyWhileVisible } from '@/lib/jarvis-face/visible-interval'
+import { cn } from '@/lib/utils'
+import {
+  $cerebroGraph,
+  $jarvisFaceOpen,
+  $jarvisVoice,
+  bindJarvisVoiceEvents,
+  decideJarvisPending,
+  faceEnergy,
+  type JarvisVoiceState,
+  setJarvisFaceOpen,
+  submitFromJarvisFace,
+  watchCerebroGraph
+} from '@/store/jarvis-face'
+import { dismissAgentCards, markCardKeySeen, pushAgentCard } from '@/store/jarvis-face-cards'
+import { $busy, $messages } from '@/store/session'
+
+import { FaceCardsLayer } from './face-cards'
+import { FaceDock } from './face-panels'
+import { HumanoidFace } from './humanoid-face'
+
+const STATUS_LABEL: Record<HumanoidMood, string> = {
+  open: 'ONLINE',
+  thinking: 'PENSANDO',
+  speaking: 'FALANDO',
+  listening: 'OUVINDO'
+}
+
+const KIND_LABEL: Record<string, string> = {
+  pessoas: 'Pessoa',
+  organizacoes: 'Organização',
+  projetos: 'Projeto',
+  sessoes: 'Sessão',
+  reunioes: 'Reunião',
+  perfil: 'Perfil'
+}
+
+const IDLE_CHECK_MS = 1000
+
+/** Something is happening on the voice side, so the conversation is not idle. */
+function voiceInUse(voice: JarvisVoiceState): boolean {
+  return (
+    voice.status === 'live' ||
+    voice.speaking ||
+    voice.listening ||
+    voice.pending !== null ||
+    voice.delegation?.status === 'running' ||
+    voice.delegation?.status === 'confirming'
+  )
+}
+
+function statusLabel(voice: JarvisVoiceState, head: HumanoidMood): string {
+  if (voice.pending) {
+    return 'AGUARDANDO CONFIRMAÇÃO'
+  }
+
+  return voice.delegation?.status === 'running' ? 'EXECUTANDO PEDIDO' : STATUS_LABEL[head]
+}
+
+export function JarvisFaceOverlay() {
+  const open = useStore($jarvisFaceOpen)
+
+  useEffect(bindJarvisVoiceEvents, [])
+
+  return open ? <FaceLayer /> : null
+}
+
+function FaceLayer() {
+  const canvasRef = useRef<HTMLCanvasElement>(null)
+  const portraitRef = useRef<HTMLDivElement>(null)
+  const lastActivity = useRef(Date.now())
+  const [galaxy, setGalaxy] = useState<Galaxy | null>(null)
+  const [unsupported, setUnsupported] = useState(false)
+  const [hover, setHover] = useState<GalaxyHover | null>(null)
+  const [draft, setDraft] = useState('')
+  const [conversationStarted, setConversationStarted] = useState(false)
+  // Only what arrives after this set is shown: the face never replays an old conversation.
+  const [baseline, setBaseline] = useState(() => messageIds($messages.get()))
+  const graph = useStore($cerebroGraph)
+  const voice = useStore($jarvisVoice)
+  const busy = useStore($busy)
+  const messages = useStore($messages)
+
+  const working = busy || voice.delegation?.status === 'running'
+
+  const headState: HumanoidMood = voice.speaking
+    ? 'speaking'
+    : voice.listening
+      ? 'listening'
+      : working
+        ? 'thinking'
+        : 'open'
+
+  const reply = useMemo(
+    () => replyAfter(messages, baseline, conversationStarted),
+    [messages, baseline, conversationStarted]
+  )
+
+  const touch = () => {
+    lastActivity.current = Date.now()
+  }
+
+  // Popovers and dialogs opened from the face (the "Vozes" panel) must layer above it.
+  useEffect(() => {
+    document.documentElement.setAttribute('data-jarvis-face', '')
+
+    return () => document.documentElement.removeAttribute('data-jarvis-face')
+  }, [])
+
+  useEffect(() => {
+    const canvas = canvasRef.current
+
+    if (!canvas) {
+      return
+    }
+
+    let created: Galaxy | null = null
+
+    try {
+      created = createGalaxy(canvas, {
+        onHover: setHover,
+        onFaceScale: scale => portraitRef.current?.style.setProperty('--face-scale', String(scale))
+      })
+    } catch {
+      created = null
+    }
+
+    if (!created) {
+      setUnsupported(true)
+
+      return
+    }
+
+    setGalaxy(created)
+    const stopWatching = watchCerebroGraph()
+
+    return () => {
+      stopWatching()
+      created.dispose()
+      setGalaxy(null)
+    }
+  }, [])
+
+  useEffect(() => {
+    if (galaxy && graph) {
+      galaxy.setGraph(graph)
+    }
+  }, [galaxy, graph])
+
+  useEffect(() => {
+    galaxy?.setEnergy(faceEnergy(voice, busy))
+  }, [galaxy, voice, busy])
+
+  // A running turn or live voice counts as interaction, so a long answer is never wiped mid-way.
+  useEffect(() => {
+    if (busy || voiceInUse(voice)) {
+      touch()
+    }
+  }, [busy, voice])
+
+  // 30 s with no interaction: forget the conversation (reply, agent cards, half-typed text).
+  // The check sleeps while the window is hidden and catches up when it shows again.
+  useEffect(() => {
+    let wiped = false
+
+    return everyWhileVisible(() => {
+      const inUse = $busy.get() || voiceInUse($jarvisVoice.get())
+
+      if (!isFaceIdle(Date.now(), lastActivity.current, inUse)) {
+        wiped = false
+
+        return
+      }
+
+      if (!wiped) {
+        wiped = true
+        setBaseline(messageIds($messages.get()))
+        setDraft('')
+        setConversationStarted(false)
+        dismissAgentCards()
+      }
+    }, IDLE_CHECK_MS)
+  }, [])
+
+  // Cards the agent wrote before the face opened are history, not news.
+  useEffect(() => {
+    $messages.get().forEach(message => {
+      extractCards(chatMessageText(message)).cards.forEach((_, index) => markCardKeySeen(`${message.id}:${index}`))
+    })
+  }, [])
+
+  useEffect(() => {
+    for (const message of messages) {
+      if (message.role !== 'assistant' || message.hidden) {
+        continue
+      }
+
+      if (!conversationStarted) {
+        extractCards(chatMessageText(message)).cards.forEach((_, index) => markCardKeySeen(`${message.id}:${index}`))
+
+        continue
+      }
+
+      extractCards(chatMessageText(message)).cards.forEach((card, index) =>
+        pushAgentCard(card, `${message.id}:${index}`)
+      )
+    }
+  }, [messages, conversationStarted])
+
+  // Replies to voice requests land in the "Jarvis Voice" session, not the one on screen. The agent
+  // does not always write a ::card, so a finished voice request always leaves one card behind.
+  useEffect(() => {
+    const onReply = (event: Event) => {
+      const detail = (event as CustomEvent<{ request?: string; text?: string }>).detail
+      const stamp = Date.now()
+      const { cards, text } = extractCards(detail?.text ?? '')
+
+      touch()
+      cards.forEach((card, index) => pushAgentCard(card, `voice:${stamp}:${index}`))
+
+      if (cards.length === 0 && text) {
+        pushAgentCard(
+          { body: text, kind: 'aviso', title: (detail?.request ?? '').trim().slice(0, 80) || 'Resposta do Jarvis' },
+          `voice:${stamp}:reply`
+        )
+      }
+    }
+
+    window.addEventListener('jarvis:reply', onReply)
+
+    return () => window.removeEventListener('jarvis:reply', onReply)
+  }, [])
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if (event.key === 'Escape' && !event.defaultPrevented) {
+        setJarvisFaceOpen(false)
+      }
+    }
+
+    window.addEventListener('keydown', onKey)
+
+    return () => window.removeEventListener('keydown', onKey)
+  }, [])
+
+  const onSubmit = (event: FormEvent) => {
+    event.preventDefault()
+    touch()
+
+    const currentMessages = messageIds($messages.get())
+
+    if (submitFromJarvisFace(draft)) {
+      setBaseline(currentMessages)
+      setConversationStarted(true)
+      setDraft('')
+    }
+  }
+
+  const hovered = hover && graph ? graph.nodes[hover.index] : null
+  const pending = voice.pending
+
+  return (
+    <div
+      aria-label="Face do Jarvis"
+      className="fixed inset-0 z-[80] select-none overflow-hidden bg-black text-slate-100"
+      onKeyDownCapture={touch}
+      onPointerDownCapture={touch}
+      role="dialog"
+    >
+      <canvas className={cn('absolute inset-0 size-full touch-none', unsupported && 'hidden')} ref={canvasRef} />
+      {unsupported && (
+        <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_center,#1b2a55_0%,#05070f_70%)]" />
+      )}
+
+      <button
+        aria-label="Fechar a face do Jarvis"
+        className="absolute left-4 top-4 z-10 flex size-9 items-center justify-center rounded-full border border-white/15 bg-white/5 text-slate-200 backdrop-blur-md transition hover:border-cyan-300/60 hover:bg-white/10 hover:text-white"
+        onClick={() => setJarvisFaceOpen(false)}
+        type="button"
+      >
+        <X className="size-4" />
+      </button>
+
+      <div className="pointer-events-none absolute left-1/2 top-4 z-10 -translate-x-1/2 font-mono text-[11px] tracking-[0.35em] text-cyan-200/80 drop-shadow-[0_0_12px_rgba(0,245,255,0.5)]">
+        J.A.R.V.I.S. · {statusLabel(voice, headState)}
+      </div>
+
+      <FaceDock />
+      <FaceCardsLayer />
+
+      {pending && (
+        <div
+          className="pointer-events-auto absolute left-1/2 top-14 w-[min(440px,calc(100vw-32px))] -translate-x-1/2 rounded-2xl border border-amber-300/50 bg-black/80 p-4 shadow-[0_0_60px_rgba(251,191,36,0.25)] backdrop-blur-xl"
+          role="alertdialog"
+          style={{ zIndex: 9999 }}
+        >
+          <div className="flex items-center justify-between font-mono text-[10px] tracking-widest text-amber-300">
+            <span>PEDIDO AGUARDANDO CONFIRMAÇÃO</span>
+            <span>{pending.remaining_s}s</span>
+          </div>
+          <p className="mt-2 text-sm leading-snug text-slate-100 select-text">{pending.request}</p>
+          <p className="mt-1 text-[11px] text-slate-400">Este pedido exige confirmação na tela.</p>
+          <div className="mt-3 flex gap-2">
+            <button
+              className="rounded-full bg-amber-300 px-4 py-1.5 text-xs font-semibold text-slate-950 transition hover:bg-amber-200"
+              onClick={() => decideJarvisPending(pending, true)}
+              type="button"
+            >
+              Confirmar este pedido uma vez
+            </button>
+            <button
+              className="rounded-full border border-white/20 px-4 py-1.5 text-xs text-slate-200 transition hover:bg-white/10"
+              onClick={() => decideJarvisPending(pending, false)}
+              type="button"
+            >
+              Cancelar pedido
+            </button>
+          </div>
+        </div>
+      )}
+
+      {hovered && hover && (
+        <div
+          className="pointer-events-none absolute z-10 max-w-64 rounded-lg border border-white/15 bg-black/70 px-3 py-1.5 text-xs backdrop-blur-md"
+          style={{ left: hover.x + 16, top: hover.y + 16 }}
+        >
+          <div className="font-medium text-slate-50">{hovered.label}</div>
+          <div className="text-[10px] uppercase tracking-wider text-cyan-300/80">
+            {KIND_LABEL[hovered.kind] ?? hovered.kind} · {hovered.degree} ligações
+          </div>
+        </div>
+      )}
+
+      <div className="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex flex-col items-center gap-3 px-4 pb-6">
+        {/* No z-index or transform on this wrapper: that would isolate the head's blend from the galaxy. */}
+        <div
+          className="jarvis-face-portrait pointer-events-none absolute inset-x-0 flex justify-center transition-[bottom] duration-500"
+          ref={portraitRef}
+          style={{ bottom: 'calc(100% + 8px)' }}
+        >
+          <HumanoidFace className="relative aspect-[215/302] h-[clamp(200px,27vh,280px)]" mood={headState} />
+        </div>
+
+        {reply && (
+          <div className="pointer-events-auto max-h-40 w-full max-w-2xl overflow-y-auto rounded-2xl border border-white/10 bg-black/45 px-4 py-3 text-sm leading-relaxed text-slate-100 shadow-[0_0_40px_rgba(80,140,255,0.15)] backdrop-blur-xl select-text">
+            <p className="whitespace-pre-wrap">{reply}</p>
+          </div>
+        )}
+
+        <div className="jarvis-face-console pointer-events-auto w-full max-w-2xl">
+          <div className="jarvis-face-controls">
+            <Slot area="jarvis.voice.controls" />
+          </div>
+          <form className="jarvis-face-composer" onSubmit={onSubmit}>
+            <input
+              aria-label="Mensagem para o Jarvis"
+              autoFocus
+              className="min-w-0 flex-1 bg-transparent text-sm text-slate-50 outline-none placeholder:text-slate-400"
+              onChange={event => setDraft(event.target.value)}
+              placeholder="Fale com o Jarvis…"
+              value={draft}
+            />
+            <button className="jarvis-face-send" disabled={!draft.trim()} type="submit">
+              Enviar
+            </button>
+          </form>
+        </div>
+      </div>
+    </div>
+  )
+}
