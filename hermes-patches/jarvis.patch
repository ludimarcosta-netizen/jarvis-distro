new file mode 100644
index 00000000000..b9d45d9b2be
--- /dev/null
+++ b/agent/jarvis_fast_actions.py
@@ -0,0 +1,164 @@
+"""Jarvis (fork local): pedidos triviais resolvidos sem chamar o modelo.
+
+"abre o Spotify" e "procura X no YouTube" levavam ~15 s (3 rodadas do modelo) para rodar um
+único comando. Aqui o turno é fechado na hora com a resposta pronta, pelo mesmo caminho do
+``finalize_turn`` que o loop já usa quando pula o modelo. Qualquer dúvida (pedido com mais passos,
+site, programa não encontrado, módulo ausente) devolve None e o turno segue normal para o modelo.
+
+O trabalho fica no módulo da skill ``abrir`` (HERMES_HOME/skills/productivity/abrir/abrir.py),
+o mesmo usado pela voz do Jarvis. "Quais os compromissos de hoje/amanhã/da semana?" usa
+HERMES_HOME/jarvis/agenda.py (Google Agenda + pendências): ~2 s em vez de ~2 min de procura.
+"""
+from __future__ import annotations
+
+import importlib.util
+import logging
+import re
+import unicodedata
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+_WAKE = r"^(?:(?:ei|hey|oi|ok)\s+)?(?:jarvis\s*[,:]?\s*)?"
+_OPEN_RE = re.compile(_WAKE + r"(?:abre|abra|abrir)\s+(?:(?:o|a|os|as|meu|minha)\s+)?"
+                      r"(?:(?:programa|aplicativo|app)\s+(?:do|da|de)?\s*)?(?P<nome>.+?)"
+                      r"(?:\s+(?:pra|para)\s+mim)?(?:\s+por\s+favor)?[\s.!]*$")
+_SEARCH_RE = re.compile(_WAKE + r"(?:procura|procure|pesquisa|pesquise|busca|busque)\s+(?:por\s+)?(?P<termo>.+?)"
+                        r"\s+(?:no|na)\s+(?P<onde>youtube|google maps|google|maps|spotify)[\s.!]*$")
+# "quais os compromissos de hoje?", "minha agenda de amanhã", "o que tenho pra hoje?",
+# "tenho compromisso amanhã?". Só consulta; "agenda uma reunião" (verbo) não casa.
+_QUANDO = r"(?P<quando>hoje|amanha|(?:(?:essa|esta|nessa|nesta|da|a)\s+)?semana)"
+_AGENDA_RE = re.compile(
+    _WAKE + r"(?:(?:quais|qual|como)\s+(?:(?:sao|e|esta|estao)\s+)?|(?:me\s+)?(?:diz|diga|fala|fale|mostra|mostre"
+    r"|lista|liste|ve|veja)\s+)?(?:(?:os|as|a|o)\s+)?(?:meus\s+|minhas\s+|minha\s+)?"
+    r"(?:compromissos?|agenda|pendencias?)(?:\s+(?:de|do|da|para|pra|dessa|desta)?\s*" + _QUANDO + r")?"
+    r"(?:\s+por\s+favor)?[\s?.!]*$")
+_AGENDA_TENHO_RE = re.compile(
+    _WAKE + r"(?:(?:o\s+)?que\s+(?:eu\s+)?tenho|(?:eu\s+)?tenho\s+(?:algum\s+)?compromisso)"
+    r"(?:\s+(?:de\s+compromisso|na\s+agenda))?\s+(?:(?:pra|para)\s+)?" + _QUANDO
+    + r"(?:\s+de\s+compromisso)?[\s?.!]*$")
+# quando -> (dias a partir de hoje, dias a mais no período), como em agenda.py --desde/--dias.
+_PERIODOS = {"hoje": (0, 0), "amanha": (1, 0)}
+# Mais de um passo, site ou arquivo/pasta: isso é trabalho do modelo.
+_NOT_SIMPLE = re.compile(r"(?:\s+e\s+|,|;|\bdepois\b|\bsite\b|\bpagina\b|\bendereco\b|\bpasta\b|\barquivo\b"
+                         r"|https?:|www\.|\.com\b|\.br\b)")
+_module: Any = None
+_agenda_module: Any = None
+
+
+def _local_file_command(agent: Any, text: str) -> Optional[str]:
+    # The owning agent/profile keeps its own references; never a process-global selection.
+    import sys
+
+    from hermes_constants import get_hermes_home
+
+    root = get_hermes_home() / "jarvis"
+    if not (root / "local_commands.py").is_file():
+        return None
+    if str(root) not in sys.path:
+        sys.path.insert(0, str(root))
+    from local_commands import try_command
+    from local_files import FilesSession
+
+    scope = (str(root), getattr(agent, "session_id", None))
+    saved = getattr(agent, "_jarvis_files", None)
+    if saved is None or saved[0] != scope:
+        saved = (scope, FilesSession())
+        agent._jarvis_files = saved
+    reply = try_command(text, saved[1])
+    if reply is not None or not (root / "local_media_commands.py").is_file():
+        return reply
+    from local_media import MediaSession
+    from local_media_commands import try_command as try_media
+
+    media = getattr(agent, "_jarvis_media", None)
+    if media is None or media[0] != scope:
+        media = (scope, MediaSession())
+        agent._jarvis_media = media
+    return try_media(text, media[1])
+
+
+def _fold(text: str) -> str:
+    plain = "".join(c for c in unicodedata.normalize("NFKD", text.casefold()) if not unicodedata.combining(c))
+    return re.sub(r"\s+", " ", plain).strip()
+
+
+def _abrir():
+    global _module
+    if _module is None:
+        from hermes_constants import get_hermes_home
+        path = get_hermes_home() / "skills" / "productivity" / "abrir" / "abrir.py"
+        if not path.exists():
+            return None
+        spec = importlib.util.spec_from_file_location("jarvis_abrir_fast", path)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        _module = module
+    return _module
+
+
+def _agenda():
+    """HERMES_HOME/jarvis/agenda.py (Google Agenda + pendências), o mesmo usado pela voz."""
+    global _agenda_module
+    if _agenda_module is None:
+        from hermes_constants import get_hermes_home
+        path = get_hermes_home() / "jarvis" / "agenda.py"
+        if not path.exists():
+            return None
+        spec = importlib.util.spec_from_file_location("jarvis_agenda_fast", path)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        _agenda_module = module
+    return _agenda_module
+
+
+def _agenda_period(text: str) -> Optional[tuple]:
+    match = _AGENDA_RE.match(text) or _AGENDA_TENHO_RE.match(text)
+    if not match:
+        return None
+    quando = match.group("quando") or "hoje"
+    return _PERIODOS.get(quando, (0, 6))  # qualquer forma de "semana" = hoje + 6 dias
+
+
+def _senhor(message: str) -> str:
+    return message.rstrip(". ") + ", senhor."
+
+
+def try_fast_action(agent: Any, user_message: Any) -> Optional[str]:
+    """Resposta pronta para um pedido trivial, ou None para seguir com o modelo."""
+    if not isinstance(user_message, str) or len(user_message) > 160:
+        return None
+    if getattr(agent, "_parent_session_id", None):  # subagente: segue o fluxo do pai
+        return None
+    original = user_message.strip()
+    text = _fold(original)
+    try:
+        period = _agenda_period(text)
+        if period is not None:
+            module = _agenda()
+            return module.consultar(*period) if module is not None else None
+        files_reply = _local_file_command(agent, original)
+        if files_reply is not None:
+            return files_reply
+        search =_SEARCH_RE.match(text)
+        if search and not _NOT_SIMPLE.search(search.group("termo")):
+            module = _abrir()
+            if module is None:
+                return None
+            # Termo com as letras originais (acentos) para a busca.
+            termo = original[search.start("termo"):search.end("termo")] if len(original) == len(text) else search.group("termo")
+            result = module.search(search.group("onde"), termo)
+            return _senhor(result["mensagem"]) if result["ok"] else None
+        opened = _OPEN_RE.match(text)
+        if opened and not _NOT_SIMPLE.search(opened.group("nome")):
+            module = _abrir()
+            if module is None:
+                return None
+            result = module.open_app(opened.group("nome"))
+            if result["ok"]:
+                return _senhor(result["mensagem"])
+            if result.get("opcoes"):  # ambíguo: pergunta na hora; a resposta segue pelo modelo
+                return result["mensagem"]
+    except Exception:  # noqa: BLE001 — atalho nunca pode quebrar o turno
+        logger.warning("jarvis fast action failed; falling back to the model", exc_info=True)
+    return None
