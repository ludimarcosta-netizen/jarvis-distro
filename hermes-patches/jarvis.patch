@@ -0,0 +1,165 @@
+import { useStore } from '@nanostores/react'
+import { type ReactNode, type PointerEvent as ReactPointerEvent, useEffect, useState } from 'react'
+
+import { X } from '@/lib/icons'
+import { type AgentCard, cardFromAttrs, type CardKind } from '@/lib/jarvis-face/cards'
+import { cn } from '@/lib/utils'
+import {
+  $faceCards,
+  CARD_WIDTH,
+  dismissCard,
+  type FaceCard,
+  type FacePanel,
+  moveCard,
+  raiseCard
+} from '@/store/jarvis-face-cards'
+
+import { PANEL_TITLES, PanelBody } from './face-panels'
+
+const KIND_STYLE: Record<CardKind, { accent: string; label: string }> = {
+  tarefa: { accent: 'text-cyan-300 border-cyan-300/30', label: 'TAREFA' },
+  lembrete: { accent: 'text-amber-300 border-amber-300/30', label: 'LEMBRETE' },
+  pesquisa: { accent: 'text-violet-300 border-violet-300/30', label: 'PESQUISA' },
+  aviso: { accent: 'text-rose-300 border-rose-300/30', label: 'AVISO' }
+}
+
+export function FaceCardsLayer() {
+  const cards = useStore($faceCards)
+
+  return (
+    <>
+      {cards.map(card => (
+        <FloatingCard card={card} key={card.id} />
+      ))}
+    </>
+  )
+}
+
+function cardHeading(card: FaceCard): { accent: string; label: string; title: string } {
+  if (card.source.type === 'agent') {
+    const style = KIND_STYLE[card.source.card.kind]
+
+    return { accent: style.accent, label: style.label, title: card.source.card.title }
+  }
+
+  return { accent: 'text-sky-300 border-sky-300/30', label: 'PAINEL', title: PANEL_TITLES[card.source.panel as FacePanel] }
+}
+
+function FloatingCard({ card }: { card: FaceCard }) {
+  const [shown, setShown] = useState(false)
+  const [drag, setDrag] = useState<null | { dx: number; dy: number }>(null)
+  const heading = cardHeading(card)
+
+  useEffect(() => {
+    const frame = requestAnimationFrame(() => setShown(true))
+
+    return () => cancelAnimationFrame(frame)
+  }, [])
+
+  const onPointerDown = (event: ReactPointerEvent<HTMLDivElement>) => {
+    if ((event.target as HTMLElement).closest('button')) {
+      return
+    }
+
+    raiseCard(card.id)
+    setDrag({ dx: event.clientX - card.x, dy: event.clientY - card.y })
+    event.currentTarget.setPointerCapture(event.pointerId)
+  }
+
+  const onPointerMove = (event: ReactPointerEvent<HTMLDivElement>) => {
+    if (!drag) {
+      return
+    }
+
+    const x = Math.min(Math.max(0, event.clientX - drag.dx), window.innerWidth - 80)
+    const y = Math.min(Math.max(0, event.clientY - drag.dy), window.innerHeight - 48)
+
+    moveCard(card.id, x, y)
+  }
+
+  return (
+    <section
+      aria-label={heading.title}
+      className={cn(
+        'pointer-events-auto fixed z-20 flex max-h-[70vh] flex-col overflow-hidden rounded-2xl border border-white/12 bg-black/55 text-slate-100 shadow-[0_0_50px_rgba(90,150,255,0.18)] backdrop-blur-xl transition-[opacity,transform] duration-300 ease-out',
+        shown ? 'translate-y-0 scale-100 opacity-100' : 'translate-y-3 scale-95 opacity-0'
+      )}
+      onPointerDown={() => raiseCard(card.id)}
+      style={{ left: card.x, top: card.y, width: `min(${CARD_WIDTH}px, calc(100vw - 32px))`, zIndex: 20 + card.z }}
+    >
+      <div
+        className={cn(
+          'flex cursor-grab items-center gap-2 border-b border-white/8 px-3 py-2 active:cursor-grabbing',
+          drag && 'cursor-grabbing'
+        )}
+        onPointerDown={onPointerDown}
+        onPointerMove={onPointerMove}
+        onPointerUp={() => setDrag(null)}
+      >
+        <span className={cn('rounded-full border px-2 py-0.5 font-mono text-[9px] font-semibold tracking-widest', heading.accent)}>
+          {heading.label}
+        </span>
+        <h2 className="min-w-0 flex-1 truncate text-sm font-medium">{heading.title}</h2>
+        <button
+          aria-label={`Fechar ${heading.title}`}
+          className="flex size-6 items-center justify-center rounded-full text-slate-400 transition hover:bg-white/10 hover:text-white"
+          onClick={() => dismissCard(card.id)}
+          type="button"
+        >
+          <X className="size-3.5" />
+        </button>
+      </div>
+      <div className="min-h-0 overflow-y-auto px-3 py-2.5 text-sm select-text">
+        {card.source.type === 'agent' ? <AgentCardBody card={card.source.card} /> : <PanelBody panel={card.source.panel} />}
+      </div>
+    </section>
+  )
+}
+
+export function AgentCardBody({ card }: { card: AgentCard }): ReactNode {
+  return (
+    <div className="flex flex-col gap-2">
+      {card.when && <div className="font-mono text-xs text-amber-200/90">{card.when}</div>}
+      {card.body && <p className="leading-relaxed whitespace-pre-wrap text-slate-200">{card.body}</p>}
+      {card.items && (
+        <ul className="flex list-disc flex-col gap-1 pl-4 text-slate-200 marker:text-cyan-300/70">
+          {card.items.map(item => (
+            <li key={item}>{item}</li>
+          ))}
+        </ul>
+      )}
+      {card.url && (
+        <button
+          className="self-start rounded-full border border-cyan-300/40 px-3 py-1 text-xs text-cyan-200 transition hover:bg-cyan-300/10"
+          onClick={() => void window.hermesDesktop?.openExternal(card.url!)}
+          type="button"
+        >
+          Abrir link
+        </button>
+      )}
+    </div>
+  )
+}
+
+/** `::card{…}` rendered inline in the normal chat (the floating version lives in the face). */
+export function InlineCardDirective({ attrs }: { attrs: Readonly<Record<string, string>> }): ReactNode {
+  const card = cardFromAttrs(attrs)
+
+  if (!card) {
+    return null
+  }
+
+  const style = KIND_STYLE[card.kind]
+
+  return (
+    <div className="my-2 flex max-w-md flex-col gap-1.5 rounded-xl border border-border bg-muted/40 px-3 py-2 text-sm">
+      <div className="flex items-center gap-2">
+        <span className={cn('rounded-full border px-2 py-0.5 font-mono text-[9px] font-semibold tracking-widest', style.accent)}>
+          {style.label}
+        </span>
+        <span className="font-medium">{card.title}</span>
+      </div>
+      <AgentCardBody card={card} />
+    </div>
+  )
+}
diff --git a/apps/desktop/src/components/jarvis-face/face-overlay.tsx b/apps/desktop/src/components/jarvis-face/face-overlay.tsx
