+import { describe, expect, it } from 'vitest'
+
+import { jawEnvelope } from './reference-renderer'
+
+describe('jawEnvelope', () => {
+  it('stays within 0..1 and keeps moving like speech', () => {
+    const samples = Array.from({ length: 400 }, (_, i) => jawEnvelope(i * 0.03))
+
+    expect(Math.min(...samples)).toBeGreaterThanOrEqual(0)
+    expect(Math.max(...samples)).toBeLessThanOrEqual(1)
+    expect(Math.max(...samples)).toBeGreaterThan(0.6)
+    expect(Math.min(...samples)).toBeLessThan(0.1)
+  })
+
+  it('is not periodic over a short window', () => {
+    const a = Array.from({ length: 50 }, (_, i) => jawEnvelope(i * 0.03))
+    const b = Array.from({ length: 50 }, (_, i) => jawEnvelope(i * 0.03 + 1.7))
+
+    expect(a).not.toEqual(b)
+  })
+})
diff --git a/apps/desktop/src/lib/jarvis-face/humanoid-renderer.ts b/apps/desktop/src/lib/jarvis-face/humanoid-renderer.ts
new file mode 100644
index 00000000000..95082b5fbf9
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/humanoid-renderer.ts
@@ -0,0 +1,493 @@
+import { blinkOpenness } from './face-motion'
+import { buildHeadGeometry, buildHeadMesh, buildOrbitDust, type SurfaceMesh } from './humanoid-geometry'
+import { perspective, viewMatrix } from './mat4'
+
+/**
+ * Holographic humanoid head: a wire grid and a point cloud sampled from a procedural face, two
+ * glowing eyes, orbiting dust. WebGL2, additive blending on black (the canvas is blended onto the
+ * galaxy with CSS `mix-blend-mode: screen`). The jaw and lips deform in the vertex shader.
+ */
+
+export type HumanoidMood = 'listening' | 'open' | 'speaking' | 'thinking'
+
+export interface HumanoidHead {
+  setMood: (mood: HumanoidMood) => void
+  /** Pointer position in -1..1 on both axes; the head and eyes turn toward it. */
+  setLook: (x: number, y: number) => void
+  dispose: () => void
+}
+
+type Rgb = [number, number, number]
+
+const MOOD_COLOR: Record<HumanoidMood, Rgb> = {
+  listening: [1, 0.72, 0.28],
+  open: [1, 0.26, 0.10],
+  speaking: [1, 0.5, 0.2],
+  thinking: [0.72, 0.38, 1]
+}
+
+/** How wide the eyes sit per mood: a villain squints even at rest. */
+const MOOD_EYES: Record<HumanoidMood, number> = { listening: 0.9, open: 0.62, speaking: 0.72, thinking: 0.5 }
+
+const BLINK_S = 0.2
+
+const MOOD_BRIGHT: Record<HumanoidMood, number> = { listening: 1, open: 0.92, speaking: 1.1, thinking: 1 }
+
+const COMMON = `#version 300 es
+precision highp float;
+uniform mat4 uProj;
+uniform mat4 uView;
+uniform vec3 uCenter;
+uniform float uJaw;
+uniform float uSpin;
+uniform float uSweep;
+uniform float uFacing;
+uniform float uDpr;
+uniform float uScale;
+uniform float uLid;
+vec3 deform(vec3 p) {
+  float eye = exp(-pow((abs(p.x) - 0.36) / 0.19, 4.0));
+  float lid = exp(-pow((p.y - 0.24) / 0.11, 4.0)) * smoothstep(0.35, 0.65, p.z);
+  p.y -= (p.y - 0.24) * eye * lid * (1.0 - uLid) * 0.95;
+  float w = 1.0 - smoothstep(-0.66, -0.50, p.y);
+  vec3 pivot = vec3(0.0, -0.15, -0.25);
+  vec3 q = p - pivot;
+  float ang = uJaw * 0.36 * w;
+  float c = cos(ang);
+  float s = sin(ang);
+  return vec3(q.x, q.y * c - q.z * s, q.y * s + q.z * c) + pivot;
+}
+vec3 spin(vec3 p) {
+  float c = cos(uSpin);
+  float s = sin(uSpin);
+  return vec3(c * p.x + s * p.z, p.y, -s * p.x + c * p.z);
+}
+float shade(vec3 p, float base) {
+  vec3 n = normalize(vec3(p.x, 0.0, p.z) + vec3(0.0001));
+  float facing = (mat3(uView) * spin(n)).z;
+  float side = mix(1.0, 0.16 + 0.84 * smoothstep(-0.3, 0.55, facing), uFacing);
+  float sweep = exp(-pow((p.y - uSweep) * 9.0, 2.0));
+  return base * side * (1.0 + 2.4 * sweep * uFacing);
+}
+`
+
+const POINT_VS = `${COMMON}
+in vec3 aPos;
+in float aA;
+in float aSize;
+out float vA;
+void main() {
+  vec3 p = deform(aPos);
+  vec4 vp = uView * vec4(spin(p - uCenter), 1.0);
+  gl_Position = uProj * vp;
+  gl_PointSize = clamp(aSize * uDpr * uScale / max(-vp.z, 0.1), 1.0, 14.0 * uDpr);
+  vA = shade(aPos, aA);
+}`
+
+const POINT_FS = `#version 300 es
+precision highp float;
+uniform vec3 uColor;
+uniform float uBright;
+in float vA;
+out vec4 outColor;
+void main() {
+  float d = length(gl_PointCoord - 0.5) * 2.0;
+  float a = (exp(-d * d * 5.0) + 0.25 * exp(-d * 2.0)) * (1.0 - smoothstep(0.85, 1.0, d));
+  vec3 hot = mix(uColor, vec3(1.0), 0.55);
+  outColor = vec4(hot * a * vA * uBright, clamp(a * vA * uBright, 0.0, 1.0));
+}`
+
+const LINE_VS = `${COMMON}
+in vec3 aPos;
+in float aA;
+out float vA;
+void main() {
+  vec3 p = deform(aPos);
+  vec4 vp = uView * vec4(spin(p - uCenter), 1.0);
+  gl_Position = uProj * vp;
+  vA = shade(aPos, aA);
+}`
+
+const LINE_FS = `#version 300 es
+precision highp float;
+uniform vec3 uColor;
+uniform float uBright;
+in float vA;
+out vec4 outColor;
+void main() { outColor = vec4(uColor * vA * uBright, clamp(vA * uBright, 0.0, 1.0)); }`
+
+const FILL_VS = `${COMMON}
+in vec3 aPos;
+in vec3 aNormal;
+out vec3 vN;
+out float vY;
+void main() {
+  vec3 p = deform(aPos);
+  vec4 vp = uView * vec4(spin(p - uCenter), 1.0);
+  gl_Position = uProj * vp;
+  vN = mat3(uView) * spin(aNormal);
+  vY = aPos.y;
+}`
+
+// The skin: translucent violet-blue body, lit from the upper left, with a bright rim where the
+// surface turns away from the viewer (the hot outline in the reference).
+const FILL_FS = `#version 300 es
+precision highp float;
+uniform vec3 uColor;
+uniform float uBright;
+uniform float uSweep;
+in vec3 vN;
+in float vY;
+out vec4 outColor;
+void main() {
+  vec3 n = normalize(vN);
+  float fres = pow(1.0 - clamp(n.z, 0.0, 1.0), 3.2);
+  float light = clamp(dot(n, normalize(vec3(-0.45, 0.55, 0.75))), 0.0, 1.0);
+  vec3 inner = mix(vec3(0.34, 0.08, 0.62), vec3(0.08, 0.26, 0.85), clamp(vY * 0.3 + 0.45, 0.0, 1.0));
+  float sweep = exp(-pow((vY - uSweep) * 9.0, 2.0));
+  vec3 col = inner * (0.06 + 0.26 * light) + uColor * (fres * 2.3 + sweep * 0.2);
+  col *= vY < -1.1 ? 0.18 : 1.0;
+  outColor = vec4(col * uBright, 1.0);
+}`
+
+const EYE_VS = `${COMMON}
+in vec3 aPos;
+in float aSide;
+uniform vec2 uGaze;
+out float vSide;
+void main() {
+  vec3 p = aPos + vec3(uGaze * 0.03, 0.0);
+  vec4 vp = uView * vec4(p - uCenter, 1.0);
+  gl_Position = uProj * vp;
+  gl_PointSize = 100.0 * uDpr * uScale / max(-vp.z, 0.1);
+  vSide = aSide;
+}`
+
+const EYE_FS = `#version 300 es
+precision highp float;
+uniform vec3 uColor;
+uniform float uOpen;
+uniform float uBright;
+in float vSide;
+out vec4 outColor;
+void main() {
+  vec2 raw = (gl_PointCoord - 0.5) * 2.0;
+  float ang = 0.34 * vSide;
+  vec2 c = vec2(cos(ang) * raw.x - sin(ang) * raw.y, sin(ang) * raw.x + cos(ang) * raw.y);
+  float open = max(uOpen, 0.06);
+  vec2 e = vec2(c.x * 0.9, c.y / open * 1.7);
+  float d = length(e);
+  float core = exp(-d * d * 3.6);
+  float halo = exp(-length(c) * 2.0) * 1.5 * open;
+  float ring = exp(-pow((d - 0.55) * 7.0, 2.0)) * 0.55;
+  float slit = (1.0 - smoothstep(0.0, 0.05, abs(c.y)));
+  vec3 hot = mix(uColor, vec3(1.0, 0.82, 0.5), 0.55);
+  vec3 col = hot * core * 3.2 + uColor * (halo + ring) + hot * slit * 0.35 * exp(-abs(c.x) * 1.4) * (1.0 - open * 0.7);
+  float visible = smoothstep(0.0, 0.12, uOpen);
+  outColor = vec4(col * uBright * visible, clamp(length(col) * uBright * visible, 0.0, 1.0));
+}`
+
+function compile(gl: WebGL2RenderingContext, type: number, source: string): WebGLShader {
+  const shader = gl.createShader(type)
+
+  if (!shader) {
+    throw new Error('shader allocation failed')
+  }
+
+  gl.shaderSource(shader, source)
+  gl.compileShader(shader)
+
+  if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
+    throw new Error(gl.getShaderInfoLog(shader) ?? 'shader compile failed')
+  }
+
+  return shader
+}
+
+function link(gl: WebGL2RenderingContext, vs: string, fs: string): WebGLProgram {
+  const prog = gl.createProgram()
+
+  if (!prog) {
+    throw new Error('program allocation failed')
+  }
+
+  gl.attachShader(prog, compile(gl, gl.VERTEX_SHADER, vs))
+  gl.attachShader(prog, compile(gl, gl.FRAGMENT_SHADER, fs))
+  gl.linkProgram(prog)
+
+  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
+    throw new Error(gl.getProgramInfoLog(prog) ?? 'program link failed')
+  }
+
+  return prog
+}
+
+/** Speech-like jaw envelope: syllables of different lengths layered, never perfectly periodic. */
+export function jawEnvelope(t: number): number {
+  const syllables = 0.55 * Math.abs(Math.sin(t * 7.1)) + 0.45 * Math.abs(Math.sin(t * 11.3 + 1.3))
+  const phrasing = 0.45 + 0.55 * Math.sin(t * 2.1) ** 2
+
+  return Math.min(1, syllables * phrasing * 1.25)
+}
+
+export function createHumanoidHead(canvas: HTMLCanvasElement): HumanoidHead | null {
+  const gl = canvas.getContext('webgl2', { alpha: true, antialias: true })
+
+  if (!gl) {
+    return null
+  }
+
+  const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false
+  const geometry = buildHeadGeometry()
+  const dust = buildOrbitDust()
+  const eyes = new Float32Array([-0.36, 0.24, 0.82, -1, 0.36, 0.24, 0.82, 1])
+
+  const pointProg = link(gl, POINT_VS, POINT_FS)
+  const lineProg = link(gl, LINE_VS, LINE_FS)
+  const eyeProg = link(gl, EYE_VS, EYE_FS)
+  const fillProg = link(gl, FILL_VS, FILL_FS)
+
+  const makeVao = (prog: WebGLProgram, data: Float32Array, layout: { name: string; size: number }[]) => {
+    const stride = layout.reduce((sum, item) => sum + item.size, 0) * 4
+    const vao = gl.createVertexArray()!
+    const buffer = gl.createBuffer()!
+    let offset = 0
+
+    gl.bindVertexArray(vao)
+    gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
+    gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW)
+
+    for (const { name, size } of layout) {
+      const loc = gl.getAttribLocation(prog, name)
+      gl.enableVertexAttribArray(loc)
+      gl.vertexAttribPointer(loc, size, gl.FLOAT, false, stride, offset)
+      offset += size * 4
+    }
+
+    gl.bindVertexArray(null)
+
+    return { vao, buffer, count: data.length / (stride / 4) }
+  }
+
+  const pointLayout = [{ name: 'aPos', size: 3 }, { name: 'aA', size: 1 }, { name: 'aSize', size: 1 }]
+  const cloud = makeVao(pointProg, geometry.points, pointLayout)
+  const orbit = makeVao(pointProg, dust, pointLayout)
+  const grid = makeVao(lineProg, geometry.lines, [{ name: 'aPos', size: 3 }, { name: 'aA', size: 1 }])
+  const eyeVao = makeVao(eyeProg, eyes, [{ name: 'aPos', size: 3 }, { name: 'aSide', size: 1 }])
+
+  const makeMesh = (mesh: SurfaceMesh) => {
+    const vao = gl.createVertexArray()!
+    const vertexBuffer = gl.createBuffer()!
+    const indexBuffer = gl.createBuffer()!
+
+    gl.bindVertexArray(vao)
+    gl.bindBuffer(gl.ARRAY_BUFFER, vertexBuffer)
+    gl.bufferData(gl.ARRAY_BUFFER, mesh.vertices, gl.STATIC_DRAW)
+    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer)
+    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, mesh.indices, gl.STATIC_DRAW)
+
+    for (const [name, offset] of [['aPos', 0], ['aNormal', 12]] as const) {
+      const loc = gl.getAttribLocation(fillProg, name)
+      gl.enableVertexAttribArray(loc)
+      gl.vertexAttribPointer(loc, 3, gl.FLOAT, false, 24, offset)
+    }
+
+    gl.bindVertexArray(null)
+
+    return { vao, count: mesh.indices.length }
+  }
+
+  const headMesh = makeMesh(buildHeadMesh())
+
+  const uniform = (prog: WebGLProgram, name: string) => gl.getUniformLocation(prog, name)
+
+  const common = (prog: WebGLProgram) => ({
+    proj: uniform(prog, 'uProj'),
+    view: uniform(prog, 'uView'),
+    center: uniform(prog, 'uCenter'),
+    jaw: uniform(prog, 'uJaw'),
+    spin: uniform(prog, 'uSpin'),
+    sweep: uniform(prog, 'uSweep'),
+    facing: uniform(prog, 'uFacing'),
+    dpr: uniform(prog, 'uDpr'),
+    scale: uniform(prog, 'uScale'),
+    lid: uniform(prog, 'uLid'),
+    color: uniform(prog, 'uColor'),
+    bright: uniform(prog, 'uBright')
+  })
+
+  const pu = common(pointProg)
+  const lu = common(lineProg)
+  const fu = common(fillProg)
+  const eu = { ...common(eyeProg), gaze: uniform(eyeProg, 'uGaze'), open: uniform(eyeProg, 'uOpen') }
+
+  let mood: HumanoidMood = 'open'
+  let color: Rgb = [...MOOD_COLOR.open]
+  let bright = MOOD_BRIGHT.open
+  let lookX = 0
+  let lookY = 0
+  let yaw = 0
+  let pitch = 0
+  let jaw = 0
+  let width = 1
+  let height = 1
+  let dpr = 1
+  let time = 0
+  let last = performance.now()
+  let nextBlink = 2.5
+  let blinkStart = -1
+  let lidOpen = 1
+  let gazeX = 0
+  let gazeY = 0
+  let raf = 0
+  let disposed = false
+
+  const resize = () => {
+    dpr = Math.min(window.devicePixelRatio || 1, 2)
+    width = Math.max(1, canvas.clientWidth)
+    height = Math.max(1, canvas.clientHeight)
+    canvas.width = Math.round(width * dpr)
+    canvas.height = Math.round(height * dpr)
+    gl.viewport(0, 0, canvas.width, canvas.height)
+  }
+
+  const observer = new ResizeObserver(resize)
+  observer.observe(canvas)
+  resize()
+
+  const eyeOpen = () => {
+    if (blinkStart < 0 && time >= nextBlink) {
+      blinkStart = time
+    }
+
+    if (blinkStart >= 0) {
+      const p = (time - blinkStart) / BLINK_S
+
+      if (p < 1) {
+        return blinkOpenness(p, MOOD_EYES[mood])
+      }
+
+      blinkStart = -1
+      nextBlink = time + 2.4 + Math.random() * 3.6
+    }
+
+    return MOOD_EYES[mood]
+  }
+
+  const setUniforms = (u: ReturnType<typeof common>, proj: Float32Array, view: Float32Array, facing: number) => {
+    gl.uniformMatrix4fv(u.proj, false, proj)
+    gl.uniformMatrix4fv(u.view, false, view)
+    gl.uniform3f(u.center, 0, -0.26, 0)
+    gl.uniform1f(u.sweep, ((time * 0.3) % 3.2) - 1.7)
+    gl.uniform1f(u.facing, facing)
+    gl.uniform1f(u.dpr, dpr)
+    gl.uniform1f(u.scale, height / 520)
+    gl.uniform1f(u.lid, lidOpen)
+    gl.uniform3f(u.color, color[0], color[1], color[2])
+    gl.uniform1f(u.bright, bright)
+  }
+
+  const frame = (now: number) => {
+    if (disposed) {
+      return
+    }
+
+    const dt = Math.min(0.05, (now - last) / 1000)
+    last = now
+    time += dt
+
+    const target = MOOD_COLOR[mood]
+    const ease = 1 - Math.exp(-dt * 5)
+
+    color = [color[0] + (target[0] - color[0]) * ease, color[1] + (target[1] - color[1]) * ease, color[2] + (target[2] - color[2]) * ease]
+    bright += (MOOD_BRIGHT[mood] * (mood === 'thinking' ? 0.9 + 0.15 * Math.sin(time * 5) : 1) - bright) * ease
+
+    const sway = reduced ? 0 : Math.sin(time * 0.45) * 0.1
+    yaw += (lookX * 0.38 + sway - yaw) * (1 - Math.exp(-dt * 4))
+    pitch += (-lookY * 0.16 - pitch) * (1 - Math.exp(-dt * 4))
+
+    const jawTarget = mood === 'speaking' ? jawEnvelope(time) : mood === 'listening' ? 0.04 : 0
+    jaw += (jawTarget - jaw) * (1 - Math.exp(-dt * 22))
+
+    const scanX = mood === 'thinking' ? Math.sin(time * 1.7) * 0.9 : lookX
+    gazeX += (scanX - gazeX) * (1 - Math.exp(-dt * 8))
+    gazeY += (-lookY * 0.7 - gazeY) * (1 - Math.exp(-dt * 8))
+
+    const proj = perspective(0.8, width / height, 0.1, 30)
+    const view = viewMatrix(yaw, pitch - 0.1, 4.4)
+    lidOpen = eyeOpen()
+
+    gl.clearColor(0, 0, 0, 0)
+    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT)
+    gl.enable(gl.DEPTH_TEST)
+    gl.depthMask(true)
+    gl.disable(gl.BLEND)
+    gl.blendFunc(gl.ONE, gl.ONE)
+
+    gl.enable(gl.CULL_FACE)
+    gl.cullFace(gl.BACK)
+    gl.useProgram(fillProg)
+    setUniforms(fu, proj, view, 1)
+    gl.uniform1f(fu.jaw, jaw)
+    gl.uniform1f(fu.spin, 0)
+    gl.bindVertexArray(headMesh.vao)
+    gl.drawElements(gl.TRIANGLES, headMesh.count, gl.UNSIGNED_INT, 0)
+    gl.disable(gl.CULL_FACE)
+
+    gl.enable(gl.BLEND)
+    gl.depthMask(false)
+    gl.depthFunc(gl.LEQUAL)
+
+    gl.useProgram(lineProg)
+    setUniforms(lu, proj, view, 1)
+    gl.uniform1f(lu.jaw, jaw)
+    gl.uniform1f(lu.spin, 0)
+    gl.bindVertexArray(grid.vao)
+    gl.drawArrays(gl.LINES, 0, grid.count)
+
+    gl.useProgram(pointProg)
+    setUniforms(pu, proj, view, 1)
+    gl.uniform1f(pu.jaw, jaw)
+    gl.uniform1f(pu.spin, 0)
+    gl.bindVertexArray(cloud.vao)
+    gl.drawArrays(gl.POINTS, 0, cloud.count)
+
+    gl.uniform1f(pu.jaw, 0)
+    gl.uniform1f(pu.facing, 0)
+    gl.uniform1f(pu.spin, reduced ? 0 : time * 0.22)
+    gl.bindVertexArray(orbit.vao)
+    gl.drawArrays(gl.POINTS, 0, orbit.count)
+
+    gl.useProgram(eyeProg)
+    gl.disable(gl.DEPTH_TEST)
+    setUniforms(eu, proj, view, 1)
+    gl.uniform1f(eu.jaw, 0)
+    gl.uniform1f(eu.spin, 0)
+    gl.uniform2f(eu.gaze, gazeX, gazeY)
+    gl.uniform1f(eu.open, lidOpen)
+    gl.bindVertexArray(eyeVao.vao)
+    gl.drawArrays(gl.POINTS, 0, 2)
+
+    gl.bindVertexArray(null)
+    gl.depthMask(true)
+    raf = requestAnimationFrame(frame)
+  }
+
+  raf = requestAnimationFrame(frame)
+
+  return {
+    setMood(next) {
+      mood = next
+    },
+    setLook(x, y) {
+      lookX = Math.max(-1, Math.min(1, x))
+      lookY = Math.max(-1, Math.min(1, y))
+    },
+    dispose() {
+      disposed = true
+      cancelAnimationFrame(raf)
+      observer.disconnect()
+      gl.getExtension('WEBGL_lose_context')?.loseContext()
+    }
+  }
+}
diff --git a/apps/desktop/src/lib/jarvis-face/mat4.ts b/apps/desktop/src/lib/jarvis-face/mat4.ts
