@@ -0,0 +1,54 @@
+import { describe, expect, it } from 'vitest'
+
+import { textPart } from '@/lib/chat-messages/parts'
+import type { ChatMessage } from '@/lib/chat-messages/types'
+
+import { FACE_IDLE_MS, isFaceIdle, messageIds, replyAfter } from './conversation'
+
+const msg = (id: string, role: ChatMessage['role'], text: string, extra: Partial<ChatMessage> = {}): ChatMessage => ({
+  id,
+  role,
+  parts: [textPart(text)],
+  ...extra
+})
+
+describe('replyAfter', () => {
+  const history = [msg('u1', 'user', 'oi'), msg('a1', 'assistant', 'resposta antiga')]
+
+  it('ignores history loaded after opening until a new face request starts', () => {
+    const openingBaseline = messageIds([])
+
+    expect(replyAfter(history, openingBaseline, false)).toBe('')
+    const requestBaseline = messageIds(history)
+    const next = [...history, msg('u2', 'user', 'novo pedido'), msg('a2', 'assistant', 'nova resposta')]
+
+    expect(replyAfter(next, requestBaseline, true)).toBe('nova resposta')
+    expect(replyAfter(next, requestBaseline, false)).toBe('')
+  })
+
+  it('shows nothing from the conversation that was already there', () => {
+    expect(replyAfter(history, messageIds(history))).toBe('')
+  })
+
+  it('shows the newest assistant reply that arrived after the baseline, without card directives', () => {
+    const baseline = messageIds(history)
+    const next = [...history, msg('u2', 'user', 'agenda'), msg('a2', 'assistant', 'Feito.\n\n::card{title="X"}')]
+
+    expect(replyAfter(next, baseline)).toBe('Feito.')
+  })
+
+  it('skips hidden and empty assistant bubbles and works after a session switch', () => {
+    const switched = [msg('b1', 'assistant', 'outra sessao', { hidden: true }), msg('b2', 'assistant', '   ')]
+
+    expect(replyAfter(switched, new Set(['zzz']))).toBe('')
+    expect(replyAfter([...switched, msg('b3', 'assistant', 'nova')], new Set(['zzz']))).toBe('nova')
+  })
+})
+
+describe('isFaceIdle', () => {
+  it('needs both quiet time and no running turn', () => {
+    expect(isFaceIdle(FACE_IDLE_MS, 0, false)).toBe(true)
+    expect(isFaceIdle(FACE_IDLE_MS - 1, 0, false)).toBe(false)
+    expect(isFaceIdle(FACE_IDLE_MS * 5, 0, true)).toBe(false)
+  })
+})
diff --git a/apps/desktop/src/lib/jarvis-face/conversation.ts b/apps/desktop/src/lib/jarvis-face/conversation.ts
new file mode 100644
index 00000000000..068d92057e2
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/conversation.ts
@@ -0,0 +1,42 @@
+import { chatMessageText } from '@/lib/chat-messages/parts'
+import type { ChatMessage } from '@/lib/chat-messages/types'
+
+import { extractCards } from './cards'
+
+/** The face forgets the conversation after this long without interaction. */
+export const FACE_IDLE_MS = 30_000
+
+/** Ids of every message present right now: the face only shows what arrives after this. */
+export function messageIds(messages: readonly ChatMessage[]): ReadonlySet<string> {
+  return new Set(messages.map(message => message.id))
+}
+
+/** Text of the newest assistant reply that was not in `baseline` (cards removed), or ''. */
+export function replyAfter(messages: readonly ChatMessage[], baseline: ReadonlySet<string>, conversationStarted = true): string {
+  if (!conversationStarted) {
+    return ''
+  }
+
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const message = messages[i]!
+
+    if (baseline.has(message.id)) {
+      return ''
+    }
+
+    if (message.role === 'assistant' && !message.hidden) {
+      const text = extractCards(chatMessageText(message)).text
+
+      if (text) {
+        return text
+      }
+    }
+  }
+
+  return ''
+}
+
+/** Idle = nothing is happening AND the last interaction is older than the window. */
+export function isFaceIdle(now: number, lastActivity: number, busy: boolean, idleMs = FACE_IDLE_MS): boolean {
+  return !busy && now - lastActivity >= idleMs
+}
diff --git a/apps/desktop/src/lib/jarvis-face/face-motion.test.ts b/apps/desktop/src/lib/jarvis-face/face-motion.test.ts
