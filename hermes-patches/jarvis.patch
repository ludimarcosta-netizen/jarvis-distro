+  setJarvisFaceOpen,
+  setJarvisFaceSubmitHandler,
+  submitFromJarvisFace,
+  watchCerebroGraph
+} from './jarvis-face'
+
+const hermesApi = vi.hoisted(() => vi.fn())
+
+vi.mock('@/api/client', () => ({ connectionScoped: () => ({}), hermesApi }))
+
+beforeEach(() => {
+  setJarvisFaceSubmitHandler(null)
+  setJarvisFaceOpen(false)
+  $jarvisVoice.set({ status: 'idle', speaking: false, listening: false, delegation: null, pending: null })
+})
+
+describe('parseVoiceDetail', () => {
+  it('accepts a well-formed event and rejects garbage', () => {
+    expect(parseVoiceDetail({ status: 'live', speaking: true, listening: false })).toEqual({
+      status: 'live',
+      speaking: true,
+      listening: false,
+      delegation: null,
+      pending: null
+    })
+    expect(parseVoiceDetail({ status: 'live' })).toEqual({
+      status: 'live',
+      speaking: false,
+      listening: false,
+      delegation: null,
+      pending: null
+    })
+    expect(parseVoiceDetail({ status: 'bogus' })).toBeNull()
+    expect(parseVoiceDetail(null)).toBeNull()
+  })
+})
+
+describe('bindJarvisVoiceEvents', () => {
+  it('mirrors jarvis:voice events and stops after unsubscribe', () => {
+    const off = bindJarvisVoiceEvents()
+
+    window.dispatchEvent(new CustomEvent('jarvis:voice', { detail: { status: 'live', speaking: true, listening: false } }))
+    expect($jarvisVoice.get().speaking).toBe(true)
+
+    off()
+    window.dispatchEvent(new CustomEvent('jarvis:voice', { detail: { status: 'idle', speaking: false, listening: false } }))
+    expect($jarvisVoice.get().status).toBe('live')
+  })
+})
+
+describe('submitFromJarvisFace', () => {
+  it('sends trimmed text through the registered handler', () => {
+    const handler = vi.fn()
+    setJarvisFaceSubmitHandler(handler)
+
+    expect(submitFromJarvisFace('  oi  ')).toBe(true)
+    expect(handler).toHaveBeenCalledWith('oi')
+  })
+
+  it('refuses empty text and a missing handler', () => {
+    const handler = vi.fn()
+    setJarvisFaceSubmitHandler(handler)
+
+    expect(submitFromJarvisFace('   ')).toBe(false)
+    setJarvisFaceSubmitHandler(null)
+    expect(submitFromJarvisFace('oi')).toBe(false)
+    expect(handler).not.toHaveBeenCalled()
+  })
+})
+
+describe('faceEnergy', () => {
+  it('ranks speaking > thinking > listening > idle', () => {
+    const idle = { status: 'idle', speaking: false, listening: false, delegation: null, pending: null } as const
+
+    expect(faceEnergy({ ...idle, speaking: true }, true)).toBe(1)
+    expect(faceEnergy(idle, true)).toBe(0.7)
+    expect(faceEnergy({ ...idle, delegation: { status: 'running', request: 'x' } }, false)).toBe(0.7)
+    expect(faceEnergy({ ...idle, listening: true }, false)).toBe(0.45)
+    expect(faceEnergy(idle, false)).toBe(0)
+  })
+})
+
+describe('open state', () => {
+  it('starts open in the main window and can be closed and reopened', async () => {
+    vi.resetModules()
+    const fresh = await import('./jarvis-face')
+
+    expect(fresh.$jarvisFaceOpen.get()).toBe(true)
+
+    fresh.setJarvisFaceOpen(false)
+    expect(fresh.$jarvisFaceOpen.get()).toBe(false)
+
+    fresh.setJarvisFaceOpen(true)
+    expect(fresh.$jarvisFaceOpen.get()).toBe(true)
+  })
+
+  it('does not start open in helper windows, and ignores what a past session stored', async () => {
+    window.localStorage.setItem('jarvis.face.open', 'false')
+    vi.resetModules()
+    vi.doMock('@/store/windows', () => ({ isAuxiliaryWindow: () => true }))
+
+    const helper = await import('./jarvis-face')
+
+    expect(helper.$jarvisFaceOpen.get()).toBe(false)
+
+    vi.doUnmock('@/store/windows')
+    vi.resetModules()
+
+    expect((await import('./jarvis-face')).$jarvisFaceOpen.get()).toBe(true)
+  })
+})
+
+describe('watchCerebroGraph', () => {
+  it('picks up notes added to the Cérebro while the app runs, without rebuilding an unchanged graph', async () => {
+    vi.useFakeTimers()
+    const before = { nodes: [{ id: 'a', label: 'a', kind: 'raiz', degree: 0 }], links: [] }
+    const after = { nodes: [...before.nodes, { id: 'b', label: 'b', kind: 'raiz', degree: 0 }], links: [] }
+    hermesApi.mockResolvedValueOnce(before).mockResolvedValueOnce({ ...before }).mockResolvedValueOnce(after)
+
+    const stop = watchCerebroGraph()
+    await vi.advanceTimersByTimeAsync(0)
+    const first = $cerebroGraph.get()
+    expect(first).toEqual(before)
+
+    await vi.advanceTimersByTimeAsync(CEREBRO_GRAPH_REFRESH_MS)
+    expect($cerebroGraph.get()).toBe(first)
+
+    await vi.advanceTimersByTimeAsync(CEREBRO_GRAPH_REFRESH_MS)
+    expect($cerebroGraph.get()).toEqual(after)
+
+    stop()
+    await vi.advanceTimersByTimeAsync(CEREBRO_GRAPH_REFRESH_MS * 3)
+    expect(hermesApi).toHaveBeenCalledTimes(3)
+    vi.useRealTimers()
+  })
+})
+
+describe('pending confirmation', () => {
+  it('parses delegation and pending from the plugin event and drops malformed ones', () => {
+    const parsed = parseVoiceDetail({
+      status: 'live',
+      delegation: { status: 'confirming', request: 'agendar lembrete' },
+      pending: { id: 'a1', digest: 'd1', request: 'agendar lembrete', remaining_s: 42 }
+    })
+
+    expect(parsed?.delegation).toEqual({ status: 'confirming', request: 'agendar lembrete' })
+    expect(parsed?.pending).toEqual({ id: 'a1', digest: 'd1', request: 'agendar lembrete', remaining_s: 42 })
+    expect(parseVoiceDetail({ status: 'live', delegation: { status: 'x' }, pending: { id: 1 } })).toMatchObject({
+      delegation: null,
+      pending: null
+    })
+  })
+
+  it('sends the decision as a jarvis:decide event carrying id and digest', () => {
+    const seen = vi.fn()
+    window.addEventListener('jarvis:decide', event => seen((event as CustomEvent).detail), { once: true })
+
+    decideJarvisPending({ id: 'a1', digest: 'd1', request: 'x', remaining_s: 5 }, true)
+
+    expect(seen).toHaveBeenCalledWith({ id: 'a1', digest: 'd1', allow: true })
+  })
+})
