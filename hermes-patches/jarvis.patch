+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import type { CronJob } from '@/types/hermes'
+
+const api = vi.hoisted(() => ({
+  concluirPendencia: vi.fn(),
+  getPendencias: vi.fn(),
+  getSistemas: vi.fn()
+}))
+
+vi.mock('@/api/jarvis-face', () => api)
+vi.mock('@/api/cron', () => ({ getCronJobs: vi.fn(async () => []) }))
+vi.mock('@/api/config', () => ({ getStatus: vi.fn(async () => ({ gateway_running: true, gateway_state: 'running' })) }))
+
+import { PanelBody, sortedActiveJobs } from './face-panels'
+
+const item = (id: number, descricao: string, prazo: null | string = null) => ({
+  ata_titulo: null,
+  created_at: null,
+  descricao,
+  id,
+  prazo,
+  responsavel: '__JARVIS_USER__'
+})
+
+beforeEach(() => {
+  api.getPendencias.mockReset()
+  api.concluirPendencia.mockReset()
+  api.getSistemas.mockReset()
+})
+
+afterEach(cleanup)
+
+it('shows open pendências and does not conclude until the user confirms', async () => {
+  api.getPendencias.mockResolvedValue([item(1, 'Publicar edital'), item(2, 'Conta Suprimento', '2020-01-01')])
+  api.concluirPendencia.mockResolvedValue({ ok: true })
+
+  render(<PanelBody panel="pendencias" />)
+
+  expect(await screen.findByText('Publicar edital')).toBeTruthy()
+  expect(screen.getByText(/Venceu 2020-01-01/)).toBeTruthy()
+
+  fireEvent.click(screen.getAllByText('Concluir')[0]!)
+  expect(api.concluirPendencia).not.toHaveBeenCalled()
+
+  fireEvent.click(screen.getByText('Voltar'))
+  expect(api.concluirPendencia).not.toHaveBeenCalled()
+
+  fireEvent.click(screen.getAllByText('Concluir')[0]!)
+  fireEvent.click(screen.getByText('Confirmar'))
+
+  await waitFor(() => expect(api.concluirPendencia).toHaveBeenCalledWith(1))
+  expect(api.concluirPendencia).toHaveBeenCalledTimes(1)
+})
+
+it('says so when there is nothing open and when the backend fails', async () => {
+  api.getPendencias.mockResolvedValueOnce([])
+  const { unmount } = render(<PanelBody panel="pendencias" />)
+
+  expect(await screen.findByText('Nenhuma pendência aberta.')).toBeTruthy()
+  unmount()
+
+  api.getPendencias.mockRejectedValue(new Error('offline'))
+  render(<PanelBody panel="pendencias" />)
+
+  expect(await screen.findByText(/Não consegui ler as pendências: offline/)).toBeTruthy()
+})
+
+it('lists system checks with the backend rows and the live voice state', async () => {
+  api.getSistemas.mockResolvedValue([{ detail: 'ouvindo', id: 'sentinel', label: 'Escuta ambiente', status: 'ok' }])
+
+  render(<PanelBody panel="sistemas" />)
+
+  expect(await screen.findByText('Escuta ambiente')).toBeTruthy()
+  expect(await screen.findByText('Gateway do agente')).toBeTruthy()
+  expect(screen.getByText('Sessão de voz agora')).toBeTruthy()
+})
+
+it('keeps only enabled jobs, soonest first', () => {
+  const job = (id: string, enabled: boolean, next?: string) => ({ enabled, id, next_run_at: next }) as CronJob
+
+  expect(sortedActiveJobs([job('b', true, '2026-10-08'), job('off', false), job('a', true, '2026-10-07')]).map(j => j.id)).toEqual([
+    'a',
+    'b'
+  ])
+})
+
+it('stops polling while the window is hidden and refreshes as soon as it shows again', async () => {
+  vi.useFakeTimers()
+  api.getSistemas.mockResolvedValue([])
+  const visibility = vi.spyOn(window.document, 'visibilityState', 'get').mockReturnValue('visible')
+
+  try {
+    render(<PanelBody panel="sistemas" />)
+    expect(api.getSistemas).toHaveBeenCalledTimes(1)
+
+    visibility.mockReturnValue('hidden')
+    act(() => void window.document.dispatchEvent(new Event('visibilitychange')))
+    await act(async () => void vi.advanceTimersByTime(60_000))
+    expect(api.getSistemas).toHaveBeenCalledTimes(1)
+
+    visibility.mockReturnValue('visible')
+    act(() => void window.document.dispatchEvent(new Event('visibilitychange')))
+    expect(api.getSistemas).toHaveBeenCalledTimes(2)
+  } finally {
+    visibility.mockRestore()
+    vi.useRealTimers()
+  }
+})
diff --git a/apps/desktop/src/components/jarvis-face/face-panels.tsx b/apps/desktop/src/components/jarvis-face/face-panels.tsx
