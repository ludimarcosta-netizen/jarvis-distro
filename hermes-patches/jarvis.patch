@@ -0,0 +1,68 @@
+import { describe, expect, it } from 'vitest'
+
+import { cardFromAttrs, extractCards } from './cards'
+
+describe('cardFromAttrs', () => {
+  it('requires a title and falls back to the aviso kind', () => {
+    expect(cardFromAttrs({ body: 'sem título' })).toBeNull()
+    expect(cardFromAttrs({ title: 'Oi', kind: 'bogus' })).toEqual({ kind: 'aviso', title: 'Oi' })
+  })
+
+  it('splits items, caps lengths and counts', () => {
+    const card = cardFromAttrs({
+      title: 'x'.repeat(200),
+      kind: 'pesquisa',
+      items: 'a|b|c|d|e|f|g|h',
+      body: 'y'.repeat(900)
+    })!
+
+    expect(card.title).toHaveLength(80)
+    expect(card.body).toHaveLength(400)
+    expect(card.items).toEqual(['a', 'b', 'c', 'd', 'e', 'f'])
+  })
+
+  it('keeps only https urls', () => {
+    expect(cardFromAttrs({ title: 'a', url: 'https://example.com/x' })?.url).toBe('https://example.com/x')
+    expect(cardFromAttrs({ title: 'a', url: 'http://example.com' })?.url).toBeUndefined()
+    expect(cardFromAttrs({ title: 'a', url: 'javascript:alert(1)' })?.url).toBeUndefined()
+    expect(cardFromAttrs({ title: 'a', url: 'file:///C:/x' })?.url).toBeUndefined()
+    expect(cardFromAttrs({ title: 'a', url: 'não é url' })?.url).toBeUndefined()
+  })
+})
+
+describe('extractCards', () => {
+  it('lifts cards out and leaves the prose', () => {
+    const text = [
+      'Agendei o lembrete, senhor.',
+      '::card{kind="lembrete" title="Reunião com a Câmara" when="amanhã 09:00"}',
+      '::card{kind="tarefa" title="Enviar ofício" body="Para a Procuradoria"}'
+    ].join('\n\n')
+
+    const { cards, text: prose } = extractCards(text)
+
+    expect(prose).toBe('Agendei o lembrete, senhor.')
+    expect(cards).toEqual([
+      { kind: 'lembrete', title: 'Reunião com a Câmara', when: 'amanhã 09:00' },
+      { kind: 'tarefa', title: 'Enviar ofício', body: 'Para a Procuradoria' }
+    ])
+  })
+
+  it('handles a card appended to the end of a sentence', () => {
+    const { cards, text } = extractCards('Feito. ::card{title="Pronto"}')
+
+    expect(cards).toHaveLength(1)
+    expect(text).toBe('Feito.')
+  })
+
+  it('caps cards per message and keeps other directives and plain text untouched', () => {
+    const many = Array.from({ length: 6 }, (_, i) => `::card{title="c${i}"}`).join('\n\n')
+
+    expect(extractCards(many).cards).toHaveLength(3)
+    expect(extractCards('::preview{file="a.html"}').text).toBe('::preview{file="a.html"}')
+    expect(extractCards('std::vector é prosa')).toEqual({ cards: [], text: 'std::vector é prosa' })
+  })
+
+  it('drops cards without a title', () => {
+    expect(extractCards('::card{kind="tarefa"}').cards).toEqual([])
+  })
+})
diff --git a/apps/desktop/src/lib/jarvis-face/cards.ts b/apps/desktop/src/lib/jarvis-face/cards.ts
new file mode 100644
index 00000000000..92897558521
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/cards.ts
@@ -0,0 +1,106 @@
+import { segmentTranscriptDirectives } from '@/lib/transcript-directives'
+
+export const CARD_KINDS = ['tarefa', 'lembrete', 'pesquisa', 'aviso'] as const
+
+export type CardKind = (typeof CARD_KINDS)[number]
+
+export interface AgentCard {
+  kind: CardKind
+  title: string
+  body?: string
+  when?: string
+  items?: string[]
+  /** https only. */
+  url?: string
+}
+
+const LIMITS = { title: 80, body: 400, when: 40, item: 120, items: 6, url: 300 } as const
+
+const clip = (value: string | undefined, max: number): string => (value ?? '').trim().slice(0, max)
+
+function safeHttpsUrl(raw: string | undefined): string | undefined {
+  const candidate = clip(raw, LIMITS.url)
+
+  try {
+    const url = new URL(candidate)
+
+    return url.protocol === 'https:' ? url.toString() : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** Attributes come from model output: validate every field, never trust shape. */
+export function cardFromAttrs(attrs: Readonly<Record<string, string>>): AgentCard | null {
+  const title = clip(attrs.title, LIMITS.title)
+
+  if (!title) {
+    return null
+  }
+
+  const kind = (CARD_KINDS as readonly string[]).includes(attrs.kind ?? '') ? (attrs.kind as CardKind) : 'aviso'
+  const body = clip(attrs.body, LIMITS.body)
+  const when = clip(attrs.when, LIMITS.when)
+  const url = safeHttpsUrl(attrs.url)
+
+  const items = (attrs.items ?? '')
+    .split('|')
+    .map(item => clip(item, LIMITS.item))
+    .filter(Boolean)
+    .slice(0, LIMITS.items)
+
+  return {
+    kind,
+    title,
+    ...(body ? { body } : {}),
+    ...(when ? { when } : {}),
+    ...(items.length ? { items } : {}),
+    ...(url ? { url } : {})
+  }
+}
+
+export interface ExtractedCards {
+  cards: AgentCard[]
+  /** The message with every `::card{…}` directive removed. */
+  text: string
+}
+
+const MAX_CARDS_PER_MESSAGE = 3
+
+/** Pull `::card{…}` directives out of a message; other directives stay in the text. */
+export function extractCards(text: string): ExtractedCards {
+  const cards: AgentCard[] = []
+  const kept: string[] = []
+
+  for (const paragraph of text.split(/\n{2,}/)) {
+    const segments = segmentTranscriptDirectives(paragraph)
+
+    if (!segments) {
+      kept.push(paragraph)
+
+      continue
+    }
+
+    let rest = ''
+
+    for (const segment of segments) {
+      if (segment.kind === 'prose') {
+        rest += segment.text
+      } else if (segment.directive.name === 'card') {
+        const card = cardFromAttrs(segment.directive.attrs)
+
+        if (card && cards.length < MAX_CARDS_PER_MESSAGE) {
+          cards.push(card)
+        }
+      } else {
+        rest += segment.directive.source
+      }
+    }
+
+    if (rest.trim()) {
+      kept.push(rest.trim())
+    }
+  }
+
+  return { cards, text: kept.join('\n\n').trim() }
+}
diff --git a/apps/desktop/src/lib/jarvis-face/conversation.test.ts b/apps/desktop/src/lib/jarvis-face/conversation.test.ts
