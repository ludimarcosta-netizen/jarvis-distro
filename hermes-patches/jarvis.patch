@@ -0,0 +1,97 @@
+import './jarvis-face.css'
+
+import { useEffect, useRef, useState } from 'react'
+
+import portraitUrl from '@/lib/jarvis-face/assets/fixed-portrait.png?url'
+import { createPortrait, type HumanoidMood, type Portrait } from '@/lib/jarvis-face/portrait-renderer'
+import { cn } from '@/lib/utils'
+
+interface HumanoidFaceProps {
+  mood: HumanoidMood
+  className?: string
+}
+
+/** Fixed illustration with local eyelid and lip animation, blended over the galaxy. */
+export function HumanoidFace({ mood, className }: HumanoidFaceProps) {
+  const canvasRef = useRef<HTMLCanvasElement>(null)
+  const [head, setHead] = useState<Portrait | null>(null)
+  const [failed, setFailed] = useState(false)
+
+  useEffect(() => {
+    const canvas = canvasRef.current
+
+    if (!canvas) {
+      return
+    }
+
+    let created: Portrait | null = null
+
+    try {
+      created = createPortrait(canvas)
+    } catch (error) {
+      console.error('Jarvis face renderer failed', error)
+      created = null
+    }
+
+    if (!created) {
+      setFailed(true)
+
+      return
+    }
+
+    let active = true
+    void created.ready
+      .then(() => {
+        if (active) {
+          setHead(created)
+        }
+      })
+      .catch(error => {
+        console.error('Jarvis portrait image failed', error)
+
+        if (active) {
+          setFailed(true)
+        }
+      })
+
+    return () => {
+      active = false
+      created.dispose()
+      setHead(null)
+    }
+  }, [])
+
+  useEffect(() => {
+    head?.setMood(mood)
+  }, [head, mood])
+
+  useEffect(() => {
+    if (!head) {
+      return
+    }
+
+    const onSpeechLevel = (event: Event) => {
+      const detail: unknown = (event as CustomEvent<unknown>).detail
+
+      if (detail && typeof detail === 'object' && 'level' in detail) {
+        const level = detail.level
+
+        if (level === null || (typeof level === 'number' && Number.isFinite(level))) {
+          head.setSpeechLevel(level)
+        }
+      }
+    }
+
+    window.addEventListener('jarvis:voice-level', onSpeechLevel)
+
+    return () => {
+      window.removeEventListener('jarvis:voice-level', onSpeechLevel)
+    }
+  }, [head])
+
+  return failed ? (
+    <img alt="" aria-hidden className={cn('pointer-events-none block object-contain', className)} src={portraitUrl} />
+  ) : (
+    <canvas aria-hidden className={cn('pointer-events-none block mix-blend-screen', className)} ref={canvasRef} />
+  )
+}
diff --git a/apps/desktop/src/components/jarvis-face/jarvis-face.css b/apps/desktop/src/components/jarvis-face/jarvis-face.css
new file mode 100644
index 00000000000..7d8d94bfaf0
--- /dev/null
