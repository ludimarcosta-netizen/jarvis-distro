@@ -0,0 +1,76 @@
+/* While the Jarvis face covers the app (z-80), popovers, menus and dialogs opened from it
+   (e.g. the "Vozes" panel) must sit above it, or they open invisibly underneath. */
+:root[data-jarvis-face] [data-radix-popper-content-wrapper] {
+  z-index: 120 !important;
+}
+
+:root[data-jarvis-face] [data-slot='dialog-overlay'],
+:root[data-jarvis-face] [data-slot='dialog-content'] {
+  z-index: 130 !important;
+}
+:root {
+  --jarvis-face-ember: #ff5838;
+  --jarvis-face-violet: #9628ff;
+}
+
+.jarvis-face-portrait {
+  transform: scale(var(--face-scale, 1));
+  transform-origin: center bottom;
+}
+
+.jarvis-face-glow {
+  background: radial-gradient(
+    closest-side,
+    color-mix(in srgb, var(--jarvis-face-ember) 22%, transparent),
+    color-mix(in srgb, var(--jarvis-face-violet) 9%, transparent) 55%,
+    transparent
+  );
+}
+
+.jarvis-face-console {
+  border: 1px solid var(--jarvis-workspace-stroke);
+  border-radius: 16px;
+  background: color-mix(in srgb, var(--jarvis-workspace-night) 94%, transparent);
+  backdrop-filter: blur(24px);
+  color: var(--jarvis-workspace-text);
+}
+.jarvis-face-controls {
+  padding: 12px 16px;
+}
+.jarvis-face-composer {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 16px;
+  border-top: 1px solid var(--jarvis-workspace-stroke);
+}
+.jarvis-face-composer input {
+  min-height: 32px;
+}
+.jarvis-face-composer:focus-within {
+  outline: 2px solid var(--ui-accent);
+  outline-offset: 2px;
+  border-radius: 0 0 16px 16px;
+}
+.jarvis-face-send {
+  min-height: 36px;
+  padding: 8px 16px;
+  border-radius: 8px;
+  background: var(--ui-accent);
+  color: var(--jarvis-workspace-night);
+  font-size: 12px;
+  font-weight: 600;
+}
+.jarvis-face-send:disabled {
+  opacity: 0.4;
+}
+.jarvis-face-send:focus-visible {
+  outline: 2px solid var(--jarvis-workspace-text);
+  outline-offset: 2px;
+}
+@media (max-width: 540px) {
+  .jarvis-face-controls,
+  .jarvis-face-composer {
+    padding: 12px;
+  }
+}
diff --git a/apps/desktop/src/components/jarvis/jarvis-head.tsx b/apps/desktop/src/components/jarvis/jarvis-head.tsx
