diff --git a/apps/desktop/scripts/build-jarvis-sculpt.cjs b/apps/desktop/scripts/build-jarvis-sculpt.cjs
new file mode 100644
index 00000000000..0052ad462f9
--- /dev/null
+++ b/apps/desktop/scripts/build-jarvis-sculpt.cjs
@@ -0,0 +1,349 @@
+const fs = require('node:fs')
+const path = require('node:path')
+
+// Authored Jarvis sculpture. No photograph, imported head or external model data.
+// The facial patch has connected aperture boundaries, volumetric lips and lids.
+const points = [],
+  faces = []
+const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x))
+const smooth = (a, b, x) => {
+  const t = clamp((x - a) / (b - a))
+  return t * t * (3 - 2 * t)
+}
+const gauss = (x, c, w) => Math.exp(-(((x - c) / w) ** 2))
+const mix = (a, b, t) => a + (b - a) * t
+function profile(table, y) {
+  for (let i = 1; i < table.length; i++) {
+    if (y <= table[i][0]) {
+      const a = table[i - 1],
+        b = table[i],
+        span = b[0] - a[0]
+      const slope = (b[1] - a[1]) / span
+      const tangent = j => {
+        if (j === 0 || j === table.length - 1) return slope
+        const l = (table[j][1] - table[j - 1][1]) / (table[j][0] - table[j - 1][0])
+        const r = (table[j + 1][1] - table[j][1]) / (table[j + 1][0] - table[j][0])
+        return l * r <= 0 ? 0 : (2 * l * r) / (l + r)
+      }
+      const t = clamp((y - a[0]) / span),
+        t2 = t * t,
+        t3 = t2 * t
+      return (
+        (2 * t3 - 3 * t2 + 1) * a[1] +
+        (t3 - 2 * t2 + t) * span * tangent(i - 1) +
+        (-2 * t3 + 3 * t2) * b[1] +
+        (t3 - t2) * span * tangent(i)
+      )
+    }
+  }
+  return table.at(-1)[1]
+}
+// Cross sections traced from the supplied front/profile turnaround. Each row
+// defines the actual armor silhouette and front plate relief, not a painted mask.
+const sculptRows = [
+  // y, width, central bridge, inner plate, orbit, cheek, temple, side, seam
+  [-.82,.19, .38,.38,.36,.30,.20,.08,-.05],
+  [-.72,.25, .45,.45,.43,.37,.23,.10,-.06],
+  [-.58,.34, .43,.43,.40,.34,.26,.13,-.06],
+  [-.44,.41, .44,.43,.40,.32,.28,.14,-.05],
+  [-.32,.46, .43,.42,.39,.29,.29,.15,-.04],
+  [-.23,.49, .52,.46,.38,.30,.33,.18,-.04],
+  [-.12,.51, .56,.49,.40,.34,.38,.20,-.03],
+  [ .07,.54, .54,.47,.40,.44,.41,.22,-.02],
+  [ .23,.55, .46,.43,.37,.33,.36,.25,-.02],
+  [ .35,.55, .46,.44,.45,.46,.44,.29,-.02],
+  [ .48,.54, .43,.43,.43,.42,.37,.26,-.02],
+  [ .68,.50, .39,.39,.38,.35,.30,.20,-.03],
+  [ .87,.37, .28,.28,.27,.24,.19,.12,-.05],
+  [.97,.24, .17,.17,.16,.14,.10,.04,-.05],
+  [1.025,.12,.07,.07,.06,.04,.01,-.02,-.05],
+  [1.045,.015,-.03,-.03,-.03,-.04,-.04,-.05,-.05]
+]
+const widths = sculptRows.map(r=>[r[0],r[1]])
+const depths = [[-.82,.15],[-.70,.27],[-.44,.38],[.05,.44],[.48,.44],[.70,.39],[.87,.29],[1.04,.03]]
+const plateColumns = [0,.12,.28,.47,.68,.86,1]
+function surface(x,y) {
+  const u=clamp(Math.abs(x)/profile(widths,y))
+  let row=1
+  while(row<sculptRows.length-1 && y>sculptRows[row][0]) row++
+  const a=sculptRows[row-1],b=sculptRows[row],v=clamp((y-a[0])/(b[0]-a[0]))
+  let col=1
+  while(col<plateColumns.length-1 && u>plateColumns[col]) col++
+  const t=clamp((u-plateColumns[col-1])/(plateColumns[col]-plateColumns[col-1]))
+  // Linear section interpolation preserves the bevels and plate breaks.
+  const z=mix(mix(a[col+1],a[col+2],t),mix(b[col+1],b[col+2],t),v)
+  return [x,y,z]
+}
+function jawTarget(p, weight) {
+  const angle = 0.2 * weight,
+    cy = -0.18,
+    cz = -0.12
+  const y = p[1] - cy,
+    z = p[2] - cz
+  return [p[0], cy + y * Math.cos(angle) - z * Math.sin(angle), cz + y * Math.sin(angle) + z * Math.cos(angle)]
+}
+function vertex(p, part = 0, jaw = p, blink = p, uv = null) {
+  const id = points.length
+  points.push({ p, part, jaw, blink, uv: uv || [Math.atan2(p[0], p[2] + 0.07) / Math.PI, (p[1] + 0.74) / 1.78] })
+  return id
+}
+function quad(a, b, c, d) {
+  faces.push(a, b, c, b, d, c)
+}
+function grid(nx, ny, sample, skip = () => false, reverse = false) {
+  const ids = []
+  for (let j = 0; j <= ny; j++) for (let i = 0; i <= nx; i++) ids.push(sample(i / nx, j / ny))
+  for (let j = 0; j < ny; j++)
+    for (let i = 0; i < nx; i++) {
+      if (skip((i + 0.5) / nx, (j + 0.5) / ny)) continue
+      const a = ids[j * (nx + 1) + i],
+        b = ids[j * (nx + 1) + i + 1]
+      const c = ids[(j + 1) * (nx + 1) + i],
+        d = ids[(j + 1) * (nx + 1) + i + 1]
+      if (reverse) quad(b, a, d, c)
+      else quad(a, b, c, d)
+    }
+}
+const eyes = [-1, 1].map(s => ({ s, cx: s * 0.43, cy: 0.26, hx: 0.24, hy: 0.045 }))
+const mouth = { cx: 0, cy: -0.42, hx: 0.41, hy: 0.075 }
+function aperture(u, y, hole, kind) {
+  const dx = (u - hole.cx) / hole.hx,
+    dy = (y - hole.cy) / hole.hy
+  const r = Math.max(Math.abs(dx), Math.abs(dy))
+  if (r > (kind === 'eye' ? 3.4 : 2.2)) return { u, y, weight: 0, angle: 0 }
+  const angle = Math.atan2(dy, dx),
+    weight = 1 - smooth(1, 2.2, r)
+  const cos = Math.cos(angle),
+    sin = Math.sin(angle)
+  const targetU = hole.cx + hole.hx * cos * r
+  const curveY =
+    kind === 'eye'
+      ? hole.cy + 0.027 * hole.s * cos + (sin > 0 ? 0.016 : 0.012) * sin * r
+      : hole.cy + (sin > 0 ? 0.025 : 0.03) * sin * r + 0.006 * gauss(cos, 0, 0.25) * Math.max(0, sin)
+  return { u: mix(u, targetU, weight), y: mix(y, curveY, weight), weight, angle }
+}
+// Rectangular O-grid holes are mapped to smooth anatomical contours. Boundary
+// vertices form the lids and the outer lip; the rest of the skin remains connected.
+const xs = [
+  ...new Set(
+    Array.from({ length: 121 }, (_, i) => -1 + i / 60).concat(
+      eyes.flatMap(e => [e.cx - e.hx, e.cx + e.hx]),
+      [-mouth.hx, mouth.hx]
+    )
+  )
+].sort((a, b) => a - b)
+const ys = [
+  ...new Set(
+    Array.from({ length: 151 }, (_, i) => -0.82 + (1.865 * i) / 150).concat(
+      eyes.flatMap(e => [e.cy - e.hy, e.cy + e.hy]),
+      [mouth.cy - mouth.hy, mouth.cy + mouth.hy]
+    )
+  )
+].sort((a, b) => a - b)
+const frontIds = []
+for (let j = 0; j < ys.length; j++)
+  for (let i = 0; i < xs.length; i++) {
+    let u = xs[i],
+      y = ys[j],
+      blinkWeight = 0,
+      eye = null
+    for (const e of eyes) {
+      const a = aperture(u, y, e, 'eye')
+      u = a.u
+      y = a.y
+      if (a.weight > 0) {
+        blinkWeight = a.weight
+        eye = e
+      }
+    }
+    const m = aperture(u, y, mouth, 'mouth')
+    u = m.u
+    y = m.y
+    const p = surface(u * profile(widths, y), y)
+    for (const socket of eyes) {
+      const dx = p[0] - socket.s * .236, dy = p[1] - .26
+      if (dx*dx + dy*dy < .135**2) p[2] = Math.max(p[2], .30 + Math.sqrt(.135**2-dx*dx-dy*dy) + .006)
+    }
+    if (eye) {
+      const dx = p[0] - eye.s * 0.236,
+        dy = p[1] - 0.26
+      const sphere = 0.30 + Math.sqrt(Math.max(0.0001, 0.135 ** 2 - dx ** 2 - dy ** 2)) + 0.008
+      if (dx * dx + dy * dy < 0.135 ** 2) p[2] = Math.max(p[2], sphere)
+    }
+    const lower = 1 - smooth(-0.47, -0.3, p[1])
+    const jaw = jawTarget(p, lower * smooth(-0.03, 0.25, p[2]))
+    if (p[1] > -0.42 && m.weight > 0) jaw[1] += 0.012 * m.weight
+    const blink = [...p]
+    if (eye) {
+      blink[1] = mix(p[1], eye.cy + (0.027 * eye.s * (u - eye.cx)) / eye.hx, blinkWeight)
+      blink[2] = Math.max(
+        p[2],
+        0.30 + Math.sqrt(Math.max(0.0001, 0.135 ** 2 - (p[0] - eye.s * 0.236) ** 2 - (blink[1] - 0.26) ** 2)) + 0.008
+      )
+    }
+    frontIds.push(vertex(p, 0, jaw, blink, [Math.asin(clamp(u, -1, 1)) / Math.PI, (ys[j] + 0.82) / 1.86]))
+  }
+for (let j = 0; j < ys.length - 1; j++)
+  for (let i = 0; i < xs.length - 1; i++) {
+    const x = (xs[i] + xs[i + 1]) / 2,
+      y = (ys[j] + ys[j + 1]) / 2
+    if ([...eyes, mouth].some(e => Math.abs(x - e.cx) < e.hx && Math.abs(y - e.cy) < e.hy)) continue
+    const a = frontIds[j * xs.length + i],
+      b = frontIds[j * xs.length + i + 1],
+      c = frontIds[(j + 1) * xs.length + i],
+      d = frontIds[(j + 1) * xs.length + i + 1]
+    quad(a, b, c, d)
+  }
+// Back of skull: same horizontal sections and boundary as the facial patch.
+grid(76, ys.length - 1, (u, v) => {
+  const y = ys[Math.round(v * (ys.length - 1))],
+    a = Math.PI / 2 + u * Math.PI
+  const w = profile(widths, y),
+    d = profile(depths, y) * 1.18,
+    center = surface(w, y)[2]
+  const p = [w * Math.sin(a), y, center + d * Math.cos(a)]
+  return vertex(p)
+})
+// Two lips with rounded vermilion volumes. Inner edges meet at rest; upper and
+// lower lip targets move independently. Mouth opening never discards skin pixels.
+grid(160, 8, (u, v) => {
+  const a = u * Math.PI * 2,
+    co = Math.cos(a),
+    si = Math.sin(a),
+    x = 0.41 * profile(widths, -0.42) * co
+  const upper = si >= 0,
+    outerY = -0.42 + (upper ? 0.025 : 0.03) * si + 0.006 * gauss(co, 0, 0.25) * Math.max(0, si)
+  const seamY = -0.42 + 0.006 * gauss(Math.abs(co), 0.42, 0.2) - 0.004 * gauss(co, 0, 0.18)
+  const y = mix(outerY, seamY + (upper ? 0.0015 : -0.0015) * Math.abs(si), v)
+  const p = surface(x, y)
+  p[2] += 0.003 + Math.sin(v * Math.PI) * 0.013 + (upper ? 0.004 : 0.008) * v
+  const w = Math.pow(Math.abs(si), 0.55)
+  const jaw = upper
+    ? [p[0], p[1] + 0.018 * w * (0.35 + 0.65 * v), p[2] - 0.012 * w * v]
+    : jawTarget(p, mix(0.7, 1, v) * w)
+  return vertex(p, 6, jaw, p, [u, v])
+})
+// An actual recessed oral cavity; its rim stays behind both lip surfaces.
+grid(
+  72,
+  12,
+  (u, v) => {
+    const a = u * Math.PI * 2,
+      r = v,
+      x = 0.19 * r * Math.cos(a),
+      y = -0.455 + 0.095 * r * Math.sin(a)
+    const p = [x, y, 0.20 + 0.06 * r * r]
+    return vertex(p, 1, jawTarget(p, Math.sin(a) < 0 ? 0.8 : 0))
+  },
+  undefined,
+  true
+)
+function ellipsoid(center, radii, part, jawWeight = 0, cap = null) {
+  grid(
+    part === 3 ? 12 : 48,
+    part === 3 ? 8 : 24,
+    (u, v) => {
+      const phi = u * 2 * Math.PI,
+        theta = cap ? v * cap : v * Math.PI
+      const p = [
+        center[0] + radii[0] * Math.sin(theta) * Math.cos(phi),
+        center[1] + radii[1] * Math.sin(theta) * Math.sin(phi),
+        center[2] + radii[2] * Math.cos(theta)
+      ]
+      return vertex(p, part, jawTarget(p, jawWeight))
+    },
+    undefined,
+    true
+  )
+}
+for (const s of [-1,1]) {
+  ellipsoid([s*.236,.26,.30],[.135,.135,.135],4)
+  ellipsoid([s*.236,.26,.30],[.136,.136,.136],5,0,.31)
+  // Recessed concentric actuator on the helmet side. Axis points outward.
+  grid(96,20,(u,v)=>{
+    const a=u*2*Math.PI,r=v*.17
+    const relief=.010 + .012*gauss(v,.89,.06)+.008*gauss(v,.68,.045)+.008*gauss(v,.42,.05)
+    return vertex([s*(.546+relief),.16+r*Math.sin(a),-.10+r*Math.cos(a)],7,undefined,undefined,[u,v])
+  },undefined,s<0)
+  grid(96,4,(u,v)=>{
+    const a=u*2*Math.PI,r=.17
+    return vertex([s*mix(.525,.56,v),.16+r*Math.sin(a),-.10+r*Math.cos(a)],7,undefined,undefined,[u,1])
+  },undefined,s>0)
+}
+// Teeth are separate rounded volumes on curved dental arches, upper and lower.
+for (const lower of [false, true])
+  for (let i = 0; i < 10; i++) {
+    const x = (i - 4.5) * 0.033,
+      z = 0.335 - 0.5 * x * x,
+      y = lower ? -0.49 : -0.422
+    ellipsoid([x, y, z], [0.016, 0.022, 0.014], 3, lower ? 1 : 0)
+  }
+ellipsoid([0, -0.52, 0.23], [0.12, 0.018, 0.065], 2, 0.9, Math.PI / 2)
+// A short anatomical neck. Its shoulder/base region dissolves into the galaxy.
+grid(80, 28, (u, v) => {
+  const a = u * 2 * Math.PI,
+    y = mix(-1.16, -0.72, v),
+    radius = mix(0.30, 0.235, smooth(-1.16, -0.89, y))
+  const p = [radius * Math.sin(a), y, -0.16 + radius * 0.8 * Math.cos(a)]
+  p[2] += 0.016 * gauss(Math.abs(p[0]), 0.12, 0.05) * gauss(y, -0.78, 0.2)
+  return vertex(p, 0, p, p, [a / Math.PI, (y + 0.74) / 1.78])
+})
+// Suspension rings at the holographic base.
+for(const [radius,y] of [[.32,-1.055],[.40,-1.115]]) grid(128,8,(u,v)=>{
+  const a=u*Math.PI*2,b=v*Math.PI*2,r=radius+.0025*Math.cos(b)
+  return vertex([r*Math.sin(a),y+.0025*Math.sin(b),-.16+r*Math.cos(a)],8,undefined,undefined,[u,v])
+})
+// The reference has a compact, broad skull, rather than an elongated organic head.
+for(const v of points) for(const position of new Set([v.p,v.jaw,v.blink])) position[1] *= .88
+// Area-weighted smooth normals, recomputed for both expression targets.
+function normals(field) {
+  const result = points.map(() => [0, 0, 0])
+  for (let i = 0; i < faces.length; i += 3) {
+    const ids = faces.slice(i, i + 3),
+      [a, b, c] = ids.map(id => points[id][field])
+    const ab = b.map((v, k) => v - a[k]),
+      ac = c.map((v, k) => v - a[k])
+    const n = [ab[1] * ac[2] - ab[2] * ac[1], ab[2] * ac[0] - ab[0] * ac[2], ab[0] * ac[1] - ab[1] * ac[0]]
+    for (const id of ids) for (let k = 0; k < 3; k++) result[id][k] += n[k]
+  }
+  return result.map(n => {
+    const d = Math.hypot(...n)
+    return d > 1e-9 ? n.map(v => v / d) : [0, 0, 1]
+  })
+}
+const normal = normals('p'),
+  jn = normals('jaw'),
+  bn = normals('blink'),
+  stride = 24
+if (points.length > 65535) throw new Error('Sculpt exceeds 16-bit index range')
+const buffer = Buffer.alloc(16 + points.length * stride * 4 + faces.length * 2)
+buffer.writeUInt32LE(0x4a524947, 0)
+buffer.writeUInt32LE(points.length, 4)
+buffer.writeUInt32LE(faces.length, 8)
+buffer.writeUInt32LE(stride, 12)
+let offset = 16
+points.forEach((v, i) => {
+  const values = [
+    ...v.p,
+    ...normal[i],
+    ...v.uv,
+    v.part,
+    ...v.jaw.map((p, k) => p - v.p[k]),
+    ...v.blink.map((p, k) => p - v.p[k]),
+    0,
+    0,
+    0,
+    ...jn[i].map((p, k) => p - normal[i][k]),
+    ...bn[i].map((p, k) => p - normal[i][k])
+  ]
+  for (const value of values) {
+    buffer.writeFloatLE(value, offset)
+    offset += 4
+  }
+})
+for (const i of faces) {
+  buffer.writeUInt16LE(i, offset)
+  offset += 2
+}
+fs.writeFileSync(path.resolve(__dirname, '../src/lib/jarvis-face/assets/humanoid-rig.bin'), buffer)
+console.log(JSON.stringify({ vertices: points.length, triangles: faces.length / 3, bytes: buffer.length }))
diff --git a/apps/desktop/scripts/patch-unpacked-app.mjs b/apps/desktop/scripts/patch-unpacked-app.mjs
