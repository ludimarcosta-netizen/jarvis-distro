+:root {
+  --jarvis-workspace-night: #0f1011;
+  --jarvis-workspace-text: #f7f8f8;
+  --jarvis-workspace-muted: #8a8f98;
+  --jarvis-workspace-stroke: #23252a;
+}
+
+/* The galaxy workspace is dark even when an older installation saved light
+   chrome. Scope the palette to normal windows; preserve the transparent HUD. */
+:root:has([data-contrib-shell]) {
+  color-scheme: dark !important;
+  --ui-base: var(--jarvis-workspace-text);
+  --ui-accent: color-mix(in srgb, var(--jarvis-face-violet) 65%, var(--jarvis-workspace-text));
+  --ui-bg-chrome: var(--jarvis-workspace-night);
+  --ui-bg-sidebar: color-mix(in srgb, var(--jarvis-workspace-night) 96%, var(--jarvis-face-violet));
+  --ui-bg-editor: color-mix(in srgb, var(--jarvis-workspace-night) 96%, var(--jarvis-workspace-text));
+  --ui-bg-elevated: var(--ui-bg-editor);
+  --ui-bg-input: var(--ui-bg-editor);
+  --ui-text-primary: var(--jarvis-workspace-text);
+  --ui-text-secondary: var(--jarvis-workspace-muted);
+  --ui-text-tertiary: var(--jarvis-workspace-muted);
+  --dt-secondary-foreground: var(--jarvis-workspace-text) !important;
+  --dt-accent-foreground: var(--jarvis-workspace-text) !important;
+  --dt-muted: var(--ui-bg-editor) !important;
+  --dt-border: var(--jarvis-workspace-stroke) !important;
+  --dt-input: var(--jarvis-workspace-stroke) !important;
+  --dt-ring: var(--ui-accent) !important;
+  --dt-composer-ring: var(--ui-accent) !important;
+  --dt-user-bubble-border: var(--jarvis-workspace-stroke) !important;
+  --dt-sidebar-border: var(--jarvis-workspace-stroke) !important;
+  --ui-inline-code-background: var(--ui-bg-editor);
+  --ui-inline-code-foreground: var(--jarvis-workspace-text);
+}
+
+[data-jarvis-workspace] {
+  --ui-chat-surface-background: transparent;
+  --ui-text-primary: var(--jarvis-workspace-text);
+  --ui-text-secondary: var(--jarvis-workspace-muted);
+  --ui-text-tertiary: var(--jarvis-workspace-muted);
+  background: var(--jarvis-workspace-night);
+  color: var(--jarvis-workspace-text);
+}
+
+.jarvis-workspace-backdrop {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  overflow: hidden;
+  pointer-events: none;
+  background:
+    radial-gradient(
+      ellipse at 75% 20%,
+      color-mix(in srgb, var(--jarvis-face-violet) 20%, transparent),
+      transparent 65%
+    ),
+    radial-gradient(ellipse at 25% 65%, color-mix(in srgb, var(--jarvis-face-ember) 12%, transparent), transparent 60%),
+    var(--jarvis-workspace-night);
+}
+
+.jarvis-workspace-galaxy {
+  width: 100%;
+  height: 100%;
+  opacity: 0.18;
+}
+.jarvis-workspace-shade {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(
+    180deg,
+    transparent,
+    color-mix(in srgb, var(--jarvis-workspace-night) 72%, transparent) 65%
+  );
+}
+
+.jarvis-workspace-header {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  padding: 0.5rem 1rem;
+  min-height: 2.75rem;
+}
+.jarvis-workspace-name {
+  font-size: 0.6875rem;
+  font-weight: 600;
+  letter-spacing: 0.22em;
+}
+.jarvis-workspace-status {
+  flex: 1;
+  font-size: 0.75rem;
+  color: var(--jarvis-workspace-muted);
+}
+
+.jarvis-presence {
+  position: relative;
+  flex-shrink: 0;
+}
+.jarvis-presence-image {
+  width: 100%;
+  height: 100%;
+}
+.jarvis-presence-hero {
+  width: 10rem;
+  height: 14rem;
+  margin: 0 auto 1rem;
+}
+.jarvis-presence-dock {
+  width: 3rem;
+  height: 4.25rem;
+}
+.jarvis-workspace-companion {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  width: 100%;
+}
+.jarvis-workspace-voice {
+  display: flex;
+  align-items: center;
+  flex: 1;
+  gap: 0.5rem;
+  padding: 0.5rem 0;
+}
+.jarvis-intro-title {
+  margin-bottom: 0.5rem;
+  font-size: 1.5rem;
+  font-weight: 500;
+  letter-spacing: -0.03em;
+}
+
+[data-jarvis-workspace] [data-slot='composer-surface'] {
+  background: color-mix(in srgb, var(--jarvis-workspace-night) 94%, transparent);
+}
+[data-jarvis-workspace] [data-slot='aui_intro'] {
+  color: var(--jarvis-workspace-text);
+}
+[data-jarvis-workspace] [data-slot='aui_intro'] p:last-child {
+  color: var(--jarvis-workspace-muted);
+}
+
+@media (max-height: 700px) {
+  .jarvis-presence-hero {
+    width: 7rem;
+    height: 10rem;
+    margin-bottom: 0.5rem;
+  }
+}
+@media (max-width: 900px), (max-height: 700px) {
+  .jarvis-presence-dock {
+    width: 2.5rem;
+    height: 3.5rem;
+  }
+}
+@media (max-width: 480px) {
+  .jarvis-workspace-header {
+    gap: 0.5rem;
+    padding-inline: 0.75rem;
+  }
+  .jarvis-workspace-name {
+    letter-spacing: 0.12em;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .jarvis-workspace-galaxy {
+    display: none;
+  }
+}
