+    with patch.object(fa, "_abrir", return_value=broken):
+        assert fa.try_fast_action(AGENT, "abre o spotify") is None
+
+
+class FakeAgenda:
+    def __init__(self):
+        self.calls = []
+
+    def consultar(self, desde=0, dias=0):
+        self.calls.append((desde, dias))
+        return "Agenda Google (07/10/2026):\n- Nenhum evento."
+
+
+@pytest.fixture
+def agenda():
