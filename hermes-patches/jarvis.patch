index 00000000000..b010fcc39f6
--- /dev/null
+++ b/apps/desktop/src/components/jarvis/jarvis-head.tsx
@@ -0,0 +1,532 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react'
+import { cn } from '@/lib/utils'
+
+export type JarvisHeadState = 'closed' | 'opening' | 'open' | 'thinking' | 'speaking' | 'listening'
+
+export interface JarvisHeadProps {
+  state?: JarvisHeadState
+  size?: 'sm' | 'md' | 'lg' | 'hero'
+  width?: number | string
+  height?: number | string
+  className?: string
+  enableParallax?: boolean
+  interactive?: boolean
+  onClick?: () => void
+}
+
+export function JarvisHead({
+  state = 'open',
+  size = 'md',
+  width,
+  height,
+  className,
+  enableParallax = true,
+  interactive = true,
+  onClick
+}: JarvisHeadProps) {
+  const containerRef = useRef<HTMLDivElement>(null)
+  const svgRef = useRef<SVGSVGElement>(null)
+  const [isBlinking, setIsBlinking] = useState(false)
+  const [mouthVentsState, setMouthVentsState] = useState<{ opacity: number; scaleX: number }[]>([
+    { opacity: 0.5, scaleX: 1 },
+    { opacity: 0.5, scaleX: 1 },
+    { opacity: 0.5, scaleX: 1 },
+    { opacity: 0.5, scaleX: 1 }
+  ])
+
+  // Automatic randomized natural blinking
+  useEffect(() => {
+    if (state !== 'open' && state !== 'listening') return
+
+    let blinkTimeout: NodeJS.Timeout
+    let closeTimeout: NodeJS.Timeout
+
+    const scheduleBlink = () => {
+      const minDelay = 2800
+      const maxDelay = 6500
+      const delay = Math.floor(Math.random() * (maxDelay - minDelay)) + minDelay
+
+      blinkTimeout = setTimeout(() => {
+        setIsBlinking(true)
+        closeTimeout = setTimeout(() => {
+          setIsBlinking(false)
+          scheduleBlink()
+        }, 220)
+      }, delay)
+    }
+
+    scheduleBlink()
+
+    return () => {
+      clearTimeout(blinkTimeout)
+      clearTimeout(closeTimeout)
+    }
+  }, [state])
+
+  // Mouth vents speaking animation
+  useEffect(() => {
+    if (state !== 'speaking') {
+      setMouthVentsState([
+        { opacity: 0.5, scaleX: 1 },
+        { opacity: 0.5, scaleX: 1 },
+        { opacity: 0.5, scaleX: 1 },
+        { opacity: 0.5, scaleX: 1 }
+      ])
+      return
+    }
+
+    const interval = setInterval(() => {
+      setMouthVentsState([
+        { opacity: 0.35 + Math.random() * 0.65, scaleX: 0.75 + Math.random() * 0.5 },
+        { opacity: 0.4 + Math.random() * 0.6, scaleX: 0.8 + Math.random() * 0.4 },
+        { opacity: 0.35 + Math.random() * 0.65, scaleX: 0.7 + Math.random() * 0.5 },
+        { opacity: 0.3 + Math.random() * 0.7, scaleX: 0.85 + Math.random() * 0.3 }
+      ])
+    }, 110)
+
+    return () => clearInterval(interval)
+  }, [state])
+
+  // Mouse Parallax & Gaze Tracking
+  useEffect(() => {
+    if (!enableParallax) return
+
+    const handlePointerMove = (e: MouseEvent) => {
+      if (!svgRef.current || state === 'closed') return
+
+      const rect = svgRef.current.getBoundingClientRect()
+      const centerX = rect.left + rect.width / 2
+      const centerY = rect.top + rect.height / 2
+      const deltaX = (e.clientX - centerX) / (window.innerWidth / 2)
+      const deltaY = (e.clientY - centerY) / (window.innerHeight / 2)
+
+      const tiltX = Math.max(-6, Math.min(6, deltaY * -6))
+      const tiltY = Math.max(-8, Math.min(8, deltaX * 8))
+
+      svgRef.current.style.transform = `perspective(700px) rotateX(${tiltX.toFixed(1)}deg) rotateY(${tiltY.toFixed(1)}deg)`
+    }
+
+    const handlePointerLeave = () => {
+      if (svgRef.current) {
+        svgRef.current.style.transform = 'perspective(700px) rotateX(0deg) rotateY(0deg)'
+      }
+    }
+
+    window.addEventListener('mousemove', handlePointerMove, { passive: true })
+    window.addEventListener('mouseleave', handlePointerLeave)
+
+    return () => {
+      window.removeEventListener('mousemove', handlePointerMove)
+      window.removeEventListener('mouseleave', handlePointerLeave)
+    }
+  }, [enableParallax, state])
+
+  // Size dimensions presets
+  const sizeClasses = {
+    sm: 'w-24 h-28',
+    md: 'w-36 h-40',
+    lg: 'w-52 h-60',
+    hero: 'w-64 h-72'
+  }[size]
+
+  // Eyelid offset calculation
+  const getEyelidTransform = () => {
+    if (state === 'closed' || isBlinking) return 'translateY(0px)'
+    return 'translateY(-46px)'
+  }
+
+  return (
+    <div
+      ref={containerRef}
+      className={cn(
+        'relative inline-flex flex-col items-center justify-center select-none',
+        state === 'thinking' && 'head-thinking',
+        state === 'speaking' && 'head-speaking',
+        state === 'listening' && 'head-listening',
+        interactive && 'cursor-pointer transition-transform duration-300 hover:scale-[1.02]',
+        className
+      )}
+      onClick={onClick}
+    >
+      {/* Ambient Radial Flare Glow */}
+      <div
+        className={cn(
+          'absolute pointer-events-none rounded-full transition-all duration-700 -z-10',
+          size === 'sm' && 'size-32 blur-xl',
+          size === 'md' && 'size-52 blur-2xl',
+          size === 'lg' && 'size-72 blur-3xl',
+          size === 'hero' && 'size-88 blur-3xl',
+          state === 'thinking' && 'bg-cyan-500/25 scale-125 animate-pulse',
+          state === 'speaking' && 'bg-sky-500/30 scale-115 animate-ping',
+          state === 'listening' && 'bg-pink-500/25 scale-120',
+          state === 'open' && 'bg-cyan-500/15'
+        )}
+      />
+
+      {/* Futuristic Android Head Vector */}
+      <svg
+        ref={svgRef}
+        viewBox="0 0 520 600"
+        xmlns="http://www.w3.org/2000/svg"
+        className={cn(
+          'drop-shadow-[0_12px_28px_rgba(0,0,0,0.85)] transition-transform duration-200 ease-out will-change-transform',
+          !width && !height && sizeClasses
+        )}
+        style={{
+          width: width ?? undefined,
+          height: height ?? undefined
+        }}
+      >
+        <defs>
+          {/* Specular Metal Gradients */}
+          <linearGradient id="headMetalBase" x1="0%" y1="0%" x2="100%" y2="100%">
+            <stop offset="0%" stopColor="#1e2533" />
+            <stop offset="45%" stopColor="#121620" />
+            <stop offset="75%" stopColor="#0a0d14" />
+            <stop offset="100%" stopColor="#151b27" />
+          </linearGradient>
+
+          <linearGradient id="headPlateLighter" x1="0%" y1="0%" x2="0%" y2="100%">
+            <stop offset="0%" stopColor="#3b465c" />
+            <stop offset="30%" stopColor="#262e3d" />
+            <stop offset="70%" stopColor="#171d27" />
+            <stop offset="100%" stopColor="#0e1219" />
+          </linearGradient>
+
+          <linearGradient id="headBevelHighlight" x1="0%" y1="0%" x2="100%" y2="0%">
+            <stop offset="0%" stopColor="#64748b" stopOpacity="0.8" />
+            <stop offset="50%" stopColor="#38bdf8" stopOpacity="0.3" />
+            <stop offset="100%" stopColor="#1e293b" stopOpacity="0.9" />
+          </linearGradient>
+
+          <linearGradient id="carbonNeckGrad" x1="0%" y1="0%" x2="100%" y2="0%">
+            <stop offset="0%" stopColor="#0d1117" />
+            <stop offset="50%" stopColor="#1b222f" />
+            <stop offset="100%" stopColor="#0d1117" />
+          </linearGradient>
+
+          {/* Core & Optics Gradients */}
+          <radialGradient id="opticCoreGrad" cx="50%" cy="50%" r="50%">
+            <stop offset="0%" stopColor="#ffffff" stopOpacity="1" />
+            <stop offset="25%" stopColor="#38f8ff" stopOpacity="0.95" />
+            <stop offset="65%" stopColor="#00a2ff" stopOpacity="0.7" />
+            <stop offset="88%" stopColor="#0369a1" stopOpacity="0.3" />
+            <stop offset="100%" stopColor="#0284c7" stopOpacity="0" />
+          </radialGradient>
+
+          <radialGradient id="neuralArcGrad" cx="50%" cy="50%" r="50%">
+            <stop offset="0%" stopColor="#ffffff" stopOpacity="1" />
+            <stop offset="35%" stopColor="#00f5ff" stopOpacity="0.85" />
+            <stop offset="75%" stopColor="#0284c7" stopOpacity="0.35" />
+            <stop offset="100%" stopColor="#0369a1" stopOpacity="0" />
+          </radialGradient>
+
+          {/* Volumetric Glow Filters */}
+          <filter id="cyanOpticGlow" x="-50%" y="-50%" width="200%" height="200%">
+            <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur1" />
+            <feGaussianBlur in="SourceGraphic" stdDeviation="12" result="blur2" />
+            <feGaussianBlur in="SourceGraphic" stdDeviation="22" result="blur3" />
+            <feMerge>
+              <feMergeNode in="blur3" />
+              <feMergeNode in="blur2" />
+              <feMergeNode in="blur1" />
+              <feMergeNode in="SourceGraphic" />
+            </feMerge>
+          </filter>
