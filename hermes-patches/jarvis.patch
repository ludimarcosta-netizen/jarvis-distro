+def _reopened_as_chat(session: Dict[str, Any], attempts: List[Dict[str, Any]]) -> bool:
+    """A finished run the user reopened as a chat: resuming clears ``ended_at``, so it looks
+    never-closed, but its ledger attempt is terminal and the row saw activity after it ended.
+    A true zombie (crash, watchdog kill) has no activity past its own death."""
+    if session.get("ended_at") is not None:
+        return False
+    try:
+        started_at = float(session.get("started_at") or 0)
+        last_active = float(session.get("last_active") or session.get("last_activity_at") or 0)
+    except (TypeError, ValueError):
+        return False
+    for attempt in attempts:
+        claimed_at = _iso_to_epoch(attempt.get("claimed_at"))
+        if claimed_at is None or claimed_at > started_at + _OWNERSHIP_CLAIM_GRACE_SECONDS:
+            continue
+        finished_at = _iso_to_epoch(attempt.get("finished_at"))
+        return (attempt.get("status") in ("completed", "failed", "unknown") and finished_at is not None
+                and last_active > finished_at + _REOPENED_ACTIVITY_MARGIN_SECONDS)
+    return False
+
