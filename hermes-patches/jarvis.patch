+
+def test_subagents_attachments_and_missing_skill_never_shortcut(abrir):
+    assert fa.try_fast_action(SimpleNamespace(_parent_session_id="pai"), "abre o spotify") is None
+    assert fa.try_fast_action(AGENT, [{"type": "text", "text": "abre o spotify"}]) is None
+    with patch.object(fa, "_abrir", return_value=None):
+        assert fa.try_fast_action(AGENT, "abre o spotify") is None
