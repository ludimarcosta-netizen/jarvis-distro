+import { useEffect, useRef } from 'react'
+
+import { setJarvisFaceSubmitHandler } from '@/store/jarvis-face'
+import { isAuxiliaryWindow } from '@/store/windows'
+
+/**
+ * Lets the Jarvis face (full-window overlay) send chat through the real prompt
+ * pipeline. Registers once through a ref so a callback identity change can't
+ * open a window where a submit is dropped. Primary window only.
+ */
+export function useJarvisFaceBridge(submitText: (text: string) => Promise<unknown> | unknown): void {
+  const submitTextRef = useRef(submitText)
+  submitTextRef.current = submitText
+
+  useEffect(() => {
+    if (isAuxiliaryWindow()) {
+      return
+    }
+
+    setJarvisFaceSubmitHandler(text => void submitTextRef.current(text))
+
+    return () => setJarvisFaceSubmitHandler(null)
+  }, [])
+}
