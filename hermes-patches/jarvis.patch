+import { describe, expect, it } from 'vitest'
+
+import { hash01, kindColor, layoutBackdrop, layoutDust, layoutGalaxy, pullLinkedTogether, spiralPoint } from './galaxy-layout'
+
+const graph = {
+  nodes: [
+    { id: 'pessoas/Ana', label: 'Ana', kind: 'pessoas', degree: 3 },
+    { id: 'projetos/Jarvis', label: 'Jarvis', kind: 'projetos', degree: 12 },
+    { id: 'sessoes/x', label: 'x', kind: 'sessoes', degree: 0 }
+  ],
+  links: [
+    [0, 1],
+    [1, 2]
+  ] as [number, number][]
+}
+
+describe('hash01', () => {
+  it('is deterministic and within [0, 1)', () => {
+    expect(hash01('a', 1)).toBe(hash01('a', 1))
+    expect(hash01('a', 1)).not.toBe(hash01('a', 2))
+
+    for (const key of ['', 'x', 'pessoas/Ana', 'ç']) {
+      expect(hash01(key)).toBeGreaterThanOrEqual(0)
+      expect(hash01(key)).toBeLessThan(1)
+    }
+  })
+})
+
+describe('spiralPoint', () => {
+  it('stays inside the unit galaxy and thin on the vertical axis', () => {
+    for (let i = 0; i < 200; i++) {
+      const [x, y, z] = spiralPoint(i % 3, hash01(`u${i}`), hash01(`v${i}`), hash01(`w${i}`))
+
+      expect(Math.hypot(x, z)).toBeLessThanOrEqual(1.0001)
+      expect(Math.abs(y)).toBeLessThanOrEqual(0.07)
+    }
+  })
+})
+
+describe('layoutGalaxy', () => {
+  it('lays out every node deterministically with links copied from node positions', () => {
+    const first = layoutGalaxy(graph)
+    const second = layoutGalaxy(graph)
+
+    expect([...first.positions]).toEqual([...second.positions])
+    expect(first.positions).toHaveLength(9)
+    expect(first.linkVertices).toHaveLength(12)
+    expect([...first.linkVertices.subarray(0, 3)]).toEqual([...first.positions.subarray(0, 3)])
+    expect([...first.linkVertices.subarray(3, 6)]).toEqual([...first.positions.subarray(3, 6)])
+  })
+
+  it('makes better-connected notes bigger and colors by kind', () => {
+    const layout = layoutGalaxy(graph)
+
+    expect(layout.sizes[1]).toBeGreaterThan(layout.sizes[2]!)
+    expect([...layout.colors.subarray(0, 3)]).toEqual([...new Float32Array(kindColor('pessoas'))])
+  })
+
+  it('handles an empty graph', () => {
+    const layout = layoutGalaxy({ nodes: [], links: [] })
+
+    expect(layout.positions).toHaveLength(0)
+    expect(layout.linkVertices).toHaveLength(0)
+  })
+})
+
+describe('ambient fields', () => {
+  it('generate the requested star counts', () => {
+    expect(layoutDust(50).positions).toHaveLength(150)
+    expect(layoutBackdrop(20).sizes).toHaveLength(20)
+  })
+})
+
+describe('pullLinkedTogether', () => {
+  it('moves linked nodes closer without leaving the unit galaxy', () => {
+    const positions = new Float32Array([0.9, 0, 0, -0.9, 0, 0, 0, 0, 0.8])
+    const gap = () => Math.hypot(positions[0]! - positions[3]!, positions[2]! - positions[5]!)
+    const before = gap()
+
+    pullLinkedTogether(positions, [[0, 1]])
+
+    expect(gap()).toBeLessThan(before)
+    expect([...positions.subarray(6, 9)]).toEqual([...new Float32Array([0, 0, 0.8])])
+
+    for (let i = 0; i < 3; i++) {
+      expect(Math.hypot(positions[i * 3]!, positions[i * 3 + 2]!)).toBeLessThanOrEqual(1.0001)
+    }
+  })
+})
diff --git a/apps/desktop/src/lib/jarvis-face/galaxy-layout.ts b/apps/desktop/src/lib/jarvis-face/galaxy-layout.ts
new file mode 100644
index 00000000000..70053b477a9
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/galaxy-layout.ts
@@ -0,0 +1,191 @@
+export interface CerebroNode {
+  id: string
+  label: string
+  kind: string
+  degree: number
+}
+
+export interface CerebroGraph {
+  nodes: CerebroNode[]
+  links: [number, number][]
+}
+
+export interface GalaxyLayout {
+  /** xyz per memory node, galaxy radius ≈ 1. */
+  positions: Float32Array
+  /** Point size per node (bigger = more connected). */
+  sizes: Float32Array
+  /** rgb per node, by note kind. */
+  colors: Float32Array
+  /** Flat vertex pairs (xyz, xyz) per link, ready for GL_LINES. */
+  linkVertices: Float32Array
+}
+
+type Rgb = readonly [number, number, number]
+
+const KIND_COLORS: Record<string, Rgb> = {
+  pessoas: [1, 0.78, 0.45],
+  organizacoes: [0.4, 0.9, 1],
+  projetos: [0.72, 0.55, 1],
+  sessoes: [0.45, 0.65, 1],
+  reunioes: [1, 0.52, 0.78],
+  perfil: [0.6, 1, 0.75]
+}
+
+const FALLBACK_COLOR: Rgb = [0.85, 0.9, 1]
+const ARMS = 3
+const SPIRAL_TURNS = 2.4
+
+export function kindColor(kind: string): Rgb {
+  return KIND_COLORS[kind] ?? FALLBACK_COLOR
+}
+
+/** Deterministic 0..1 from a string, so a note keeps its star between sessions. */
+export function hash01(text: string, salt = 0): number {
+  let h = 2166136261 ^ salt
+
+  for (let i = 0; i < text.length; i++) {
+    h = Math.imul(h ^ text.charCodeAt(i), 16777619)
+  }
+
+  h ^= h >>> 15
+  h = Math.imul(h, 2246822507)
+  h ^= h >>> 13
+
+  return (h >>> 0) / 4294967296
+}
+
+/** Point on a spiral-galaxy disc: bulge-heavy radius, arm angle plus jitter, thin vertical spread. */
+export function spiralPoint(arm: number, u: number, v: number, w: number): [number, number, number] {
+  const radius = 0.05 + 0.95 * u
+  const angle = (arm / ARMS) * Math.PI * 2 + radius * SPIRAL_TURNS * Math.PI + (v - 0.5) * (0.9 + 1.4 * radius)
+  const lift = (w - 0.5) * 0.14 * (1 - radius * 0.7)
+
+  return [Math.cos(angle) * radius, lift, Math.sin(angle) * radius]
+}
+
+export function layoutGalaxy(graph: CerebroGraph): GalaxyLayout {
+  const count = graph.nodes.length
+  const positions = new Float32Array(count * 3)
+  const sizes = new Float32Array(count)
+  const colors = new Float32Array(count * 3)
+  const kinds = [...new Set(graph.nodes.map(node => node.kind))].sort()
+
+  graph.nodes.forEach((node, i) => {
+    const arm = Math.max(0, kinds.indexOf(node.kind)) % ARMS
+    // Hubs sink toward the core; leaves drift outward.
+    const u = hash01(node.id, 1) ** 0.8 * (1 / (1 + node.degree * 0.08))
+    const [x, y, z] = spiralPoint(arm, u, hash01(node.id, 2), hash01(node.id, 3))
+    const [r, g, b] = kindColor(node.kind)
+
+    positions.set([x, y, z], i * 3)
+    colors.set([r, g, b], i * 3)
+    sizes[i] = 5 + Math.min(node.degree, 14) * 0.9
+  })
+
+  pullLinkedTogether(positions, graph.links)
+
+  const linkVertices = new Float32Array(graph.links.length * 6)
+
+  graph.links.forEach(([a, b], i) => {
+    linkVertices.set(positions.subarray(a * 3, a * 3 + 3), i * 6)
+    linkVertices.set(positions.subarray(b * 3, b * 3 + 3), i * 6 + 3)
+  })
+
+  return { positions, sizes, colors, linkVertices }
+}
+
+/**
+ * Relax toward neighbours so linked notes form constellations instead of
+ * random chords across the disc. Deterministic; each node is anchored to its
+ * original spot so hubs can't collapse the whole graph into the core, and it
+ * stays inside the unit galaxy.
+ */
+export function pullLinkedTogether(positions: Float32Array, links: [number, number][], iterations = 8, strength = 0.08, anchor = 0.12): void {
+  const count = positions.length / 3
+  const origin = positions.slice()
+  const neighbours: number[][] = Array.from({ length: count }, () => [])
+
+  for (const [a, b] of links) {
+    neighbours[a]!.push(b)
+    neighbours[b]!.push(a)
+  }
+
+  for (let step = 0; step < iterations; step++) {
+    const next = positions.slice()
+
+    for (let i = 0; i < count; i++) {
+      const adjacent = neighbours[i]!
+
+      if (adjacent.length === 0) {
+        continue
+      }
+
+      for (let axis = 0; axis < 3; axis++) {
+        let sum = 0
+
+        for (const j of adjacent) {
+          sum += positions[j * 3 + axis]!
+        }
+
+        const own = positions[i * 3 + axis]!
+        next[i * 3 + axis] = own + (sum / adjacent.length - own) * strength + (origin[i * 3 + axis]! - own) * anchor
+      }
+
+      const radius = Math.hypot(next[i * 3]!, next[i * 3 + 2]!)
+
+      if (radius > 1) {
+        next[i * 3] = next[i * 3]! / radius
+        next[i * 3 + 2] = next[i * 3 + 2]! / radius
+      }
+    }
+
+    positions.set(next)
+  }
+}
+
+/** Dust stars that sketch the galaxy itself (no data behind them). */
+export function layoutDust(count: number, seed = 7): { positions: Float32Array; sizes: Float32Array; colors: Float32Array } {
+  const positions = new Float32Array(count * 3)
+  const sizes = new Float32Array(count)
+  const colors = new Float32Array(count * 3)
+
+  for (let i = 0; i < count; i++) {
+    const key = `d${i}`
+    const arm = Math.floor(hash01(key, seed) * ARMS)
+    const bulge = hash01(key, seed + 5) < 0.3
+    const u = bulge ? hash01(key, seed + 1) ** 3 : hash01(key, seed + 1) ** 0.85
+    const [x, y, z] = spiralPoint(arm, u, hash01(key, seed + 2) ** 0.8, hash01(key, seed + 3))
+    const warm = 1 - u
+
+    positions.set([x * 1.04, y * 1.5, z * 1.04], i * 3)
+    colors.set([0.55 + 0.45 * warm, 0.62 + 0.2 * warm, 1 - 0.45 * warm], i * 3)
+    sizes[i] = 1.8 + hash01(key, seed + 4) ** 3 * 4.5
+  }
+
+  return { positions, sizes, colors }
+}
+
+/** Far, faint stars on a big shell so the camera has parallax depth. */
+export function layoutBackdrop(count: number, seed = 11): { positions: Float32Array; sizes: Float32Array; colors: Float32Array } {
+  const positions = new Float32Array(count * 3)
+  const sizes = new Float32Array(count)
+  const colors = new Float32Array(count * 3)
+
+  for (let i = 0; i < count; i++) {
+    const key = `b${i}`
+    const theta = hash01(key, seed) * Math.PI * 2
+    const phi = Math.acos(2 * hash01(key, seed + 1) - 1)
+    const radius = 5 + hash01(key, seed + 2) * 5
+    const tint = hash01(key, seed + 3)
+
+    positions.set(
+      [radius * Math.sin(phi) * Math.cos(theta), radius * Math.cos(phi), radius * Math.sin(phi) * Math.sin(theta)],
+      i * 3
+    )
+    colors.set([0.7 + 0.3 * tint, 0.78 + 0.2 * (1 - tint), 1], i * 3)
+    sizes[i] = 2.4 + hash01(key, seed + 4) ** 3 * 5
+  }
+
+  return { positions, sizes, colors }
+}
diff --git a/apps/desktop/src/lib/jarvis-face/galaxy-renderer.ts b/apps/desktop/src/lib/jarvis-face/galaxy-renderer.ts
new file mode 100644
index 00000000000..9dc3dcabfab
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/galaxy-renderer.ts
@@ -0,0 +1,615 @@
+import { faceScale, GALAXY_DISTANCE, zoomDistance } from './face-motion'
+import { canvasPixelRatio, createFrameLoop } from './frame-scheduler'
+import { type CerebroGraph, type GalaxyLayout, layoutBackdrop, layoutDust, layoutGalaxy } from './galaxy-layout'
+import { type Mat4, multiply, perspective, viewMatrix } from './mat4'
+
+/**
+ * Cinematic galaxy for the Jarvis "face": WebGL2, no dependencies.
+ * Layers (back to front): nebula shader, far stars, spiral dust, memory links,
+ * memory stars (with diffraction spikes), shooting stars. Everything is additive.
+ */
+
+export interface GalaxyHover {
+  index: number
+  x: number
+  y: number
+}
+
+export interface GalaxyOptions {
+  onFaceScale?: (scale: number) => void
+  onHover?: (hover: GalaxyHover | null) => void
+  onSelect?: (index: number) => void
+}
+
+export interface Galaxy {
+  setGraph: (graph: CerebroGraph) => void
+  /** 0 = idle, 1 = fully energised (thinking / speaking). */
+  setEnergy: (energy: number) => void
+  setPaused: (paused: boolean) => void
+  dispose: () => void
+}
+
+
+/** Shifts the galaxy up on screen (NDC) so the humanoid face has the lower half to itself. */
+const GALAXY_LIFT = 0.3
+const DUST_COUNT = 9000
+const BACKDROP_COUNT = 2200
+const MAX_SHOOTING = 4
+
+const NEBULA_VS = `#version 300 es
+in vec2 aPos;
+void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`
+
+const NEBULA_FS = `#version 300 es
+precision highp float;
+uniform vec2 uRes;
+uniform float uTime;
+uniform float uEnergy;
+uniform vec2 uLook;
+out vec4 outColor;
+float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
+float noise(vec2 p) {
+  vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f);
+  return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
+}
+float fbm(vec2 p) {
+  float v = 0.0; float a = 0.5;
+  for (int i = 0; i < 5; i++) { v += a * noise(p); p = p * 2.03 + vec2(17.0, 9.0); a *= 0.5; }
+  return v;
+}
+void main() {
+  vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;
+  vec2 p = uv * 1.6 + uLook * 0.35;
+  float t = uTime * 0.02;
+  float n1 = fbm(p + vec2(t, -t * 0.6));
+  float n2 = fbm(p * 1.7 + n1 * 1.4 - vec2(t * 0.8, t));
+  float core = exp(-dot(uv, uv) * 3.2);
+  vec3 col = vec3(0.008, 0.012, 0.035);
+  col += vec3(0.16, 0.13, 0.36) * pow(n1, 2.2) * 1.6;
+  col += vec3(0.60, 0.24, 0.28) * pow(n2, 3.0) * 1.8;
+  col += vec3(0.35, 0.18, 0.14) * core * (0.18 + 0.10 * uEnergy);
+  col += vec3(0.20, 0.50, 1.00) * core * core * 0.45 * uEnergy;
+  float vignette = smoothstep(1.3, 0.2, length(uv));
+  col *= mix(0.4, 1.0, vignette);
+  outColor = vec4(col, 1.0);
+}`
+
+const POINT_VS = `#version 300 es
+in vec3 aPos;
+in float aSize;
+in vec3 aColor;
+uniform mat4 uProj;
+uniform mat4 uView;
+uniform float uDpr;
+uniform float uTime;
+uniform float uEnergy;
+uniform float uScale;
+uniform int uHover;
+out vec3 vColor;
+out float vAlpha;
+void main() {
+  vec4 vp = uView * vec4(aPos, 1.0);
+  gl_Position = uProj * vp;
+  float depth = max(-vp.z, 0.05);
+  float seed = fract(sin(dot(aPos, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
+  float twinkle = 0.7 + 0.3 * sin(uTime * (0.7 + seed * 2.2) + seed * 40.0);
+  float size = aSize * (1.0 + 0.35 * uEnergy);
+  if (gl_VertexID == uHover) { size *= 2.4; twinkle = 1.0; }
+  gl_PointSize = clamp(size * uDpr * uScale / depth, 1.0, 120.0 * uDpr);
+  vColor = aColor;
+  vAlpha = twinkle * clamp(2.2 / depth, 0.0, 1.0);
+}`
+
+const POINT_FS = `#version 300 es
+precision highp float;
+uniform float uSpikes;
+in vec3 vColor;
+in float vAlpha;
+out vec4 outColor;
+void main() {
+  vec2 c = gl_PointCoord - 0.5;
+  float d = length(c) * 2.0;
+  float core = exp(-d * d * 9.0);
+  float halo = exp(-d * 3.2) * 0.35;
+  float spike = uSpikes * (exp(-abs(c.x) * 55.0) * exp(-abs(c.y) * 5.0) + exp(-abs(c.y) * 55.0) * exp(-abs(c.x) * 5.0)) * 0.5;
+  float a = (core + halo + spike) * (1.0 - smoothstep(0.85, 1.0, d));
+  outColor = vec4(vColor * a * vAlpha, a * vAlpha);
+}`
+
+const LINE_VS = `#version 300 es
+in vec3 aPos;
+in float aAlpha;
+uniform mat4 uProj;
+uniform mat4 uView;
+out float vAlpha;
+void main() {
+  vec4 vp = uView * vec4(aPos, 1.0);
+  gl_Position = uProj * vp;
+  vAlpha = aAlpha * clamp(2.2 / max(-vp.z, 0.05), 0.0, 1.0);
+}`
+
+const LINE_FS = `#version 300 es
+precision highp float;
+uniform vec3 uColor;
+uniform float uStrength;
+in float vAlpha;
+out vec4 outColor;
+void main() { outColor = vec4(uColor * vAlpha * uStrength, vAlpha * uStrength); }`
+
+function compile(gl: WebGL2RenderingContext, type: number, source: string): WebGLShader {
+  const shader = gl.createShader(type)
+
+  if (!shader) {
+    throw new Error('shader allocation failed')
+  }
+
+  gl.shaderSource(shader, source)
+  gl.compileShader(shader)
+
+  if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
+    throw new Error(gl.getShaderInfoLog(shader) ?? 'shader compile failed')
+  }
+
+  return shader
+}
+
+function program(gl: WebGL2RenderingContext, vs: string, fs: string): WebGLProgram {
+  const prog = gl.createProgram()
+
+  if (!prog) {
+    throw new Error('program allocation failed')
+  }
+
+  gl.attachShader(prog, compile(gl, gl.VERTEX_SHADER, vs))
+  gl.attachShader(prog, compile(gl, gl.FRAGMENT_SHADER, fs))
+  gl.linkProgram(prog)
+
+  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
+    throw new Error(gl.getProgramInfoLog(prog) ?? 'program link failed')
+  }
+
+  return prog
+}
+
+function transform(m: Mat4, x: number, y: number, z: number): [number, number, number, number] {
+  return [
+    m[0]! * x + m[4]! * y + m[8]! * z + m[12]!,
+    m[1]! * x + m[5]! * y + m[9]! * z + m[13]!,
+    m[2]! * x + m[6]! * y + m[10]! * z + m[14]!,
+    m[3]! * x + m[7]! * y + m[11]! * z + m[15]!
+  ]
+}
+
+interface PointLayer {
+  vao: WebGLVertexArrayObject
+  buffers: WebGLBuffer[]
+  count: number
+}
+
+interface ShootingStar {
+  pos: [number, number, number]
+  vel: [number, number, number]
+  life: number
+}
+
+export function createGalaxy(canvas: HTMLCanvasElement, options: GalaxyOptions = {}): Galaxy | null {
+  const gl = canvas.getContext('webgl2', { antialias: true, alpha: false, powerPreference: 'high-performance' })
+
+  if (!gl) {
+    return null
+  }
+
+  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false
+  const nebulaProg = program(gl, NEBULA_VS, NEBULA_FS)
+  const pointProg = program(gl, POINT_VS, POINT_FS)
+  const lineProg = program(gl, LINE_VS, LINE_FS)
+
+  const quadBuffer = gl.createBuffer()!
+  const quadVao = gl.createVertexArray()!
+  gl.bindVertexArray(quadVao)
+  gl.bindBuffer(gl.ARRAY_BUFFER, quadBuffer)
+  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW)
+  const quadLoc = gl.getAttribLocation(nebulaProg, 'aPos')
+  gl.enableVertexAttribArray(quadLoc)
+  gl.vertexAttribPointer(quadLoc, 2, gl.FLOAT, false, 0, 0)
+
+  const makePoints = (positions: Float32Array, sizes: Float32Array, colors: Float32Array): PointLayer => {
+    const vao = gl.createVertexArray()!
+
+    const buffers = [positions, sizes, colors].map(data => {
+      const buffer = gl.createBuffer()!
+      gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
+      gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW)
+
+      return buffer
+    })
+
+    gl.bindVertexArray(vao)
+    ;(['aPos', 'aSize', 'aColor'] as const).forEach((name, i) => {
+      const loc = gl.getAttribLocation(pointProg, name)
+      const size = name === 'aSize' ? 1 : 3
+      gl.bindBuffer(gl.ARRAY_BUFFER, buffers[i]!)
+      gl.enableVertexAttribArray(loc)
+      gl.vertexAttribPointer(loc, size, gl.FLOAT, false, 0, 0)
+    })
+
+    return { vao, buffers, count: sizes.length }
+  }
+
+  const freeLayer = (layer: PointLayer | null) => {
+    if (layer) {
+      layer.buffers.forEach(buffer => gl.deleteBuffer(buffer))
+      gl.deleteVertexArray(layer.vao)
+    }
+  }
+
+  const dust = layoutDust(DUST_COUNT)
+  const backdrop = layoutBackdrop(BACKDROP_COUNT)
+  const dustLayer = makePoints(dust.positions, dust.sizes, dust.colors)
+  const backdropLayer = makePoints(backdrop.positions, backdrop.sizes, backdrop.colors)
+  let nodeLayer: PointLayer | null = null
+  let layout: GalaxyLayout | null = null
+
+  // Line layers share one VAO shape: position buffer + (constant or buffered) alpha.
+  const lineAlphaLoc = gl.getAttribLocation(lineProg, 'aAlpha')
+  const linePosLoc = gl.getAttribLocation(lineProg, 'aPos')
+  const linkVao = gl.createVertexArray()!
+  const linkBuffer = gl.createBuffer()!
+  let linkCount = 0
+  gl.bindVertexArray(linkVao)
+  gl.bindBuffer(gl.ARRAY_BUFFER, linkBuffer)
+  gl.enableVertexAttribArray(linePosLoc)
+  gl.vertexAttribPointer(linePosLoc, 3, gl.FLOAT, false, 0, 0)
+  gl.vertexAttrib1f(lineAlphaLoc, 1)
+
+  const shootVao = gl.createVertexArray()!
+  const shootBuffer = gl.createBuffer()!
+  gl.bindVertexArray(shootVao)
+  gl.bindBuffer(gl.ARRAY_BUFFER, shootBuffer)
+  gl.bufferData(gl.ARRAY_BUFFER, MAX_SHOOTING * 2 * 4 * 4, gl.DYNAMIC_DRAW)
+  gl.enableVertexAttribArray(linePosLoc)
+  gl.vertexAttribPointer(linePosLoc, 3, gl.FLOAT, false, 16, 0)
+  gl.enableVertexAttribArray(lineAlphaLoc)
+  gl.vertexAttribPointer(lineAlphaLoc, 1, gl.FLOAT, false, 16, 12)
+  gl.bindVertexArray(null)
+
+  const u = (prog: WebGLProgram, name: string) => gl.getUniformLocation(prog, name)
+  const nebulaU = { res: u(nebulaProg, 'uRes'), time: u(nebulaProg, 'uTime'), energy: u(nebulaProg, 'uEnergy'), look: u(nebulaProg, 'uLook') }
+
+  const pointU = {
+    proj: u(pointProg, 'uProj'),
+    view: u(pointProg, 'uView'),
+    dpr: u(pointProg, 'uDpr'),
+    time: u(pointProg, 'uTime'),
+    energy: u(pointProg, 'uEnergy'),
+    scale: u(pointProg, 'uScale'),
+    hover: u(pointProg, 'uHover'),
+    spikes: u(pointProg, 'uSpikes')
+  }
+
+  const lineU = { proj: u(lineProg, 'uProj'), view: u(lineProg, 'uView'), color: u(lineProg, 'uColor'), strength: u(lineProg, 'uStrength') }
+
+  // Camera state (targets are eased toward every frame).
+  let yaw = 0.6
+  let pitch = 0.62
+  let dist = GALAXY_DISTANCE
+  let targetYaw = yaw
+  let targetPitch = pitch
+  let targetDist = dist
+  let lookX = 0
+  let lookY = 0
+  let energy = 0
+  let targetEnergy = 0
+  let hover = -1
+  let dragging = false
+  let moved = 0
+  let lastX = 0
+  let lastY = 0
+  let width = 1
+  let height = 1
+  let dpr = 1
+  let viewProj: Mat4 = new Float32Array(16)
+  let view: Mat4 = viewMatrix(yaw, pitch, dist)
+  let proj: Mat4 = perspective(0.9, 1, 0.05, 40)
+  const shooting: ShootingStar[] = []
+  let nextShootAt = 2
+  let time = 0
+  let lastFaceScale = -1
+
+  const resize = () => {
+    dpr = canvasPixelRatio(window.devicePixelRatio)
+    width = Math.max(1, canvas.clientWidth)
+    height = Math.max(1, canvas.clientHeight)
+    canvas.width = Math.round(width * dpr)
+    canvas.height = Math.round(height * dpr)
+    gl.viewport(0, 0, canvas.width, canvas.height)
+    proj = perspective(0.9, width / height, 0.05, 40)
+    proj[9] = -GALAXY_LIFT
+  }
+
+  resize()
+
+  const pick = (px: number, py: number): number => {
+    if (!layout) {
+      return -1
+    }
+
+    let best = -1
+    let bestDist = 20 * 20
+    const count = layout.positions.length / 3
+
+    for (let i = 0; i < count; i++) {
+      const [cx, cy, , cw] = transform(viewProj, layout.positions[i * 3]!, layout.positions[i * 3 + 1]!, layout.positions[i * 3 + 2]!)
+
+      if (cw <= 0) {
+        continue
+      }
+
+      const sx = ((cx / cw) * 0.5 + 0.5) * width
+      const sy = (1 - ((cy / cw) * 0.5 + 0.5)) * height
+      const d = (sx - px) ** 2 + (sy - py) ** 2
+
+      if (d < bestDist) {
+        bestDist = d
+        best = i
+      }
+    }
+
+    return best
+  }
+
+  const onPointerDown = (event: PointerEvent) => {
+    dragging = true
+    moved = 0
+    lastX = event.clientX
+    lastY = event.clientY
+    canvas.setPointerCapture(event.pointerId)
+  }
+
+  const onPointerMove = (event: PointerEvent) => {
+    const rect = canvas.getBoundingClientRect()
+    const px = event.clientX - rect.left
+    const py = event.clientY - rect.top
+
+    lookX = (px / width - 0.5) * 2
+    lookY = (py / height - 0.5) * 2
+
+    if (dragging) {
+      targetYaw += (event.clientX - lastX) * 0.005
+      targetPitch = Math.max(0.12, Math.min(1.45, targetPitch + (event.clientY - lastY) * 0.004))
+      moved += Math.abs(event.clientX - lastX) + Math.abs(event.clientY - lastY)
+      lastX = event.clientX
+      lastY = event.clientY
+
+      return
+    }
+
+    const next = pick(px, py)
+
+    if (next !== hover) {
+      hover = next
+      options.onHover?.(next >= 0 ? { index: next, x: px, y: py } : null)
+    }
+  }
+
+  const onPointerUp = (event: PointerEvent) => {
+    dragging = false
+    canvas.releasePointerCapture(event.pointerId)
+
+    if (moved < 5 && hover >= 0) {
+      options.onSelect?.(hover)
+    }
+  }
+
+  const onPointerLeave = () => {
+    if (hover !== -1) {
+      hover = -1
+      options.onHover?.(null)
+    }
+  }
+
+  const onWheel = (event: WheelEvent) => {
+    event.preventDefault()
+    targetDist = zoomDistance(targetDist, event.deltaY, event.deltaMode, height)
+    hover = -1
+    options.onHover?.(null)
+  }
+
+  canvas.addEventListener('pointerdown', onPointerDown)
+  canvas.addEventListener('pointermove', onPointerMove)
+  canvas.addEventListener('pointerup', onPointerUp)
+  canvas.addEventListener('pointerleave', onPointerLeave)
+  canvas.addEventListener('wheel', onWheel, { passive: false })
+
+  const spawnShootingStar = () => {
+    if (shooting.length >= MAX_SHOOTING) {
+      return
+    }
+
+    const angle = Math.random() * Math.PI * 2
+    const radius = 2.2 + Math.random() * 1.2
+    const speed = 1.4 + Math.random() * 1.2
+    const toward = angle + Math.PI + (Math.random() - 0.5) * 0.9
+
+    shooting.push({
+      pos: [Math.cos(angle) * radius, (Math.random() - 0.5) * 1.6, Math.sin(angle) * radius],
+      vel: [Math.cos(toward) * speed, (Math.random() - 0.5) * 0.3, Math.sin(toward) * speed],
+      life: 1
+    })
+  }
+
+  /** Draws one frame; true while the camera or the glow is still easing toward its target. */
+  const frame = (_now: number, dt: number): boolean => {
+    time += dt
+
+    if (!dragging) {
+      targetYaw += dt * (reducedMotion ? 0.004 : 0.03) * (1 + energy * 1.5)
+    }
+
+    const ease = 1 - Math.exp(-dt * 6)
+    yaw += (targetYaw - yaw) * ease
+    pitch += (targetPitch + (reducedMotion ? 0 : lookY * 0.05) - pitch) * ease
+    dist += (targetDist - dist) * ease
+    const scale = faceScale(dist)
+
+    // The callback restyles the portrait: skip it while the zoom is still.
+    if (Math.abs(scale - lastFaceScale) > 1e-4) {
+      lastFaceScale = scale
+      options.onFaceScale?.(scale)
+    }
+
+    energy += (targetEnergy - energy) * (1 - Math.exp(-dt * 3))
+
+    view = viewMatrix(yaw + (reducedMotion ? 0 : lookX * 0.06), pitch, dist)
+    viewProj = multiply(proj, view)
+
+    if (!reducedMotion && time > nextShootAt) {
+      spawnShootingStar()
+      nextShootAt = time + 2.5 + Math.random() * 5
+    }
+
+    gl.disable(gl.DEPTH_TEST)
+    gl.disable(gl.BLEND)
+    gl.bindVertexArray(quadVao)
+    gl.useProgram(nebulaProg)
+    gl.uniform2f(nebulaU.res, canvas.width, canvas.height)
+    gl.uniform1f(nebulaU.time, time)
+    gl.uniform1f(nebulaU.energy, energy)
+    gl.uniform2f(nebulaU.look, lookX * 0.5 + Math.sin(yaw) * 0.5, lookY * 0.3)
+    gl.drawArrays(gl.TRIANGLES, 0, 3)
+
+    gl.enable(gl.BLEND)
+    gl.blendFunc(gl.ONE, gl.ONE)
+
+    gl.useProgram(pointProg)
+    gl.uniformMatrix4fv(pointU.proj, false, proj)
+    gl.uniformMatrix4fv(pointU.view, false, view)
+    gl.uniform1f(pointU.dpr, dpr)
+    gl.uniform1f(pointU.time, time)
+    gl.uniform1f(pointU.energy, energy)
+    gl.uniform1f(pointU.scale, 0.9 * (height / 900 + 0.4))
+    gl.uniform1i(pointU.hover, -1)
+    gl.uniform1f(pointU.spikes, 0)
+    gl.bindVertexArray(backdropLayer.vao)
+    gl.drawArrays(gl.POINTS, 0, backdropLayer.count)
+    gl.bindVertexArray(dustLayer.vao)
+    gl.drawArrays(gl.POINTS, 0, dustLayer.count)
+
+    gl.useProgram(lineProg)
+    gl.uniformMatrix4fv(lineU.proj, false, proj)
+    gl.uniformMatrix4fv(lineU.view, false, view)
+
+    if (linkCount > 0) {
+      gl.uniform3f(lineU.color, 0.45, 0.65, 1)
+      gl.uniform1f(lineU.strength, 0.07 + 0.08 * energy)
+      gl.bindVertexArray(linkVao)
+      gl.drawArrays(gl.LINES, 0, linkCount)
+    }
+
+    if (nodeLayer) {
+      gl.useProgram(pointProg)
+      gl.uniform1i(pointU.hover, hover)
+      gl.uniform1f(pointU.spikes, 1)
+      gl.uniform1f(pointU.scale, 1.5 * (height / 900 + 0.4))
+      gl.bindVertexArray(nodeLayer.vao)
+      gl.drawArrays(gl.POINTS, 0, nodeLayer.count)
+    }
+
+    drawShootingStars(dt)
+
+    gl.bindVertexArray(null)
+
+    return (
+      dragging ||
+      Math.abs(targetYaw - yaw) > 0.02 ||
+      Math.abs(targetPitch + (reducedMotion ? 0 : lookY * 0.05) - pitch) > 0.002 ||
+      Math.abs(targetDist - dist) > 0.002 ||
+      Math.abs(targetEnergy - energy) > 0.01
+    )
+  }
+
+  const drawShootingStars = (dt: number) => {
+    if (shooting.length === 0) {
+      return
+    }
+
+    const data = new Float32Array(MAX_SHOOTING * 8)
+    let vertices = 0
+
+    for (let i = shooting.length - 1; i >= 0; i--) {
+      const star = shooting[i]!
+      star.life -= dt * 0.55
+      star.pos[0] += star.vel[0] * dt
+      star.pos[1] += star.vel[1] * dt
+      star.pos[2] += star.vel[2] * dt
+
+      if (star.life <= 0) {
+        shooting.splice(i, 1)
+
+        continue
+      }
+    }
+
+    for (const star of shooting) {
+      const fade = Math.min(1, star.life * 3) * 1.4
+      const tail = 0.42
+
+      data.set([star.pos[0] - star.vel[0] * tail, star.pos[1] - star.vel[1] * tail, star.pos[2] - star.vel[2] * tail, 0], vertices * 4)
+      data.set([star.pos[0], star.pos[1], star.pos[2], fade], vertices * 4 + 4)
+      vertices += 2
+    }
+
+    gl.useProgram(lineProg)
+    gl.uniform3f(lineU.color, 0.8, 0.92, 1)
+    gl.uniform1f(lineU.strength, 1)
+    gl.bindVertexArray(shootVao)
+    gl.bindBuffer(gl.ARRAY_BUFFER, shootBuffer)
+    gl.bufferSubData(gl.ARRAY_BUFFER, 0, data)
+    gl.drawArrays(gl.LINES, 0, vertices)
+  }
+
+  const loop = createFrameLoop(frame, { trackInput: true })
+
+  // Resizing clears the canvas, so it also asks for a fresh frame.
+  const observer = new ResizeObserver(() => {
+    resize()
+    loop.wake()
+  })
+
+  observer.observe(canvas)
+
+  return {
+    setGraph(graph) {
+      freeLayer(nodeLayer)
+      layout = layoutGalaxy(graph)
+      nodeLayer = layout.sizes.length > 0 ? makePoints(layout.positions, layout.sizes, layout.colors) : null
+      hover = -1
+      linkCount = layout.linkVertices.length / 3
+      gl.bindVertexArray(linkVao)
+      gl.bindBuffer(gl.ARRAY_BUFFER, linkBuffer)
+      gl.bufferData(gl.ARRAY_BUFFER, layout.linkVertices, gl.STATIC_DRAW)
+      gl.bindVertexArray(null)
+    },
+    setEnergy(value) {
+      targetEnergy = Math.max(0, Math.min(1, value))
+      loop.setVoiceActive(targetEnergy > 0)
+    },
+    setPaused: loop.setPaused,
+    dispose() {
+      loop.dispose()
+      observer.disconnect()
+      canvas.removeEventListener('pointerdown', onPointerDown)
+      canvas.removeEventListener('pointermove', onPointerMove)
+      canvas.removeEventListener('pointerup', onPointerUp)
+      canvas.removeEventListener('pointerleave', onPointerLeave)
+      canvas.removeEventListener('wheel', onWheel)
+      freeLayer(nodeLayer)
+      freeLayer(dustLayer)
+      freeLayer(backdropLayer)
+      gl.deleteBuffer(quadBuffer)
+      gl.deleteBuffer(linkBuffer)
+      gl.deleteBuffer(shootBuffer)
+      gl.getExtension('WEBGL_lose_context')?.loseContext()
+    }
+  }
+}
diff --git a/apps/desktop/src/lib/jarvis-face/humanoid-geometry.test.ts b/apps/desktop/src/lib/jarvis-face/humanoid-geometry.test.ts
new file mode 100644
index 00000000000..a38cc3189e1
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/humanoid-geometry.test.ts
@@ -0,0 +1,130 @@
+import { describe, expect, it } from 'vitest'
+
+import {
+  buildHeadGeometry,
+  buildHeadMesh,
+  buildNeckMesh,
+  buildOrbitDust,
+  EYE_PHI,
+  eyePosition,
+  facePoint,
+  featureOffset,
+  MOUTH_Y,
+  neckPoint,
+  Y_CHIN,
+  Y_CROWN
+} from './humanoid-geometry'
+
+describe('facePoint', () => {
+  it('is mirror-symmetric left and right', () => {
+    for (const y of [-0.9, -0.6, -0.2, 0.24, 0.7]) {
+      for (const phi of [0.2, 0.5, 1.1]) {
+        const [lx, ly, lz] = facePoint(-phi, y)
+        const [rx, ry, rz] = facePoint(phi, y)
+
+        expect(lx).toBeCloseTo(-rx, 6)
+        expect(ly).toBeCloseTo(ry, 6)
+        expect(lz).toBeCloseTo(rz, 6)
+      }
+    }
+  })
+
+  it('has a nose that sticks out and eye sockets that sink in', () => {
+    const noseFront = facePoint(0, -0.2)[2]
+    const noseSide = facePoint(0.5, -0.2)[2]
+    const flat = 0.86 * Math.sqrt(1 - ((-0.2 - 0.1) / 1.18) ** 2)
+
+    expect(noseFront).toBeGreaterThan(flat + 0.15)
+    expect(noseSide).toBeLessThan(noseFront)
+    expect(featureOffset(EYE_PHI, 0.24)).toBeLessThan(-0.05)
+  })
+
+  it('narrows to a chin and a crown and stays finite everywhere', () => {
+    expect(facePoint(0.7, Y_CHIN)[0]).toBeCloseTo(0, 2)
+    expect(Math.abs(facePoint(Math.PI / 2, 0.1)[0])).toBeGreaterThan(Math.abs(facePoint(Math.PI / 2, Y_CROWN)[0]))
+
+    for (let y = Y_CHIN; y <= Y_CROWN; y += 0.05) {
+      for (let phi = -Math.PI; phi <= Math.PI; phi += 0.2) {
+        expect(facePoint(phi, y).every(Number.isFinite)).toBe(true)
+      }
+    }
+  })
+
+  it('has a lip line at the mouth height with the lower lip below it', () => {
+    expect(featureOffset(0, MOUTH_Y)).toBeLessThan(featureOffset(0, MOUTH_Y + 0.08))
+    expect(featureOffset(0, MOUTH_Y)).toBeLessThan(featureOffset(0, MOUTH_Y - 0.06))
+  })
+})
+
+describe('buildHeadGeometry', () => {
+  const geometry = buildHeadGeometry()
+
+  it('produces whole records with finite values', () => {
+    expect(geometry.points.length % 5).toBe(0)
+    expect(geometry.lines.length % 8).toBe(0)
+    expect(geometry.points.length / 5).toBeGreaterThan(2000)
+    expect(geometry.lines.length / 8).toBeGreaterThan(1500)
+    expect([...geometry.points, ...geometry.lines].every(Number.isFinite)).toBe(true)
+  })
+
+  it('is deterministic', () => {
+    expect([...buildHeadGeometry().points.slice(0, 60)]).toEqual([...geometry.points.slice(0, 60)])
+  })
+})
+
+describe('extras', () => {
+  it('orbit dust has the requested count and the eyes sit symmetrically', () => {
+    expect(buildOrbitDust(40).length).toBe(40 * 5)
+
+    const [lx, ly, lz] = eyePosition(-1)
+    const [rx, ry, rz] = eyePosition(1)
+
+    expect(lx).toBeCloseTo(-rx, 6)
+    expect([ly, lz]).toEqual([ry, rz])
+  })
+})
+
+describe('skin meshes', () => {
+  const head = buildHeadMesh()
+
+  it('are whole triangle lists with finite unit normals', () => {
+    expect(head.indices.length % 3).toBe(0)
+    expect(head.vertices.length % 6).toBe(0)
+    expect(Math.max(...head.indices)).toBeLessThan(head.vertices.length / 6)
+
+    for (let i = 0; i < head.vertices.length; i += 6 * 97) {
+      const length = Math.hypot(head.vertices[i + 3]!, head.vertices[i + 4]!, head.vertices[i + 5]!)
+
+      expect(Number.isFinite(length)).toBe(true)
+      expect(length).toBeCloseTo(1, 3)
+    }
+  })
+
+  it('has normals that point outward from the vertical axis', () => {
+    let checked = 0
+
+    for (let i = 0; i < head.vertices.length; i += 6 * 53) {
+      const [x, , z, nx, , nz] = [0, 1, 2, 3, 4, 5].map(k => head.vertices[i + k]!)
+
+      if (Math.hypot(x!, z!) > 0.2) {
+        expect(x! * nx! + z! * nz!).toBeGreaterThan(0)
+        checked++
+      }
+    }
+
+    expect(checked).toBeGreaterThan(20)
+  })
+
+  it('closes the skull and flares the neck', () => {
+    expect(Math.abs(facePoint(Math.PI / 2, Y_CROWN)[0])).toBeLessThan(0.12)
+    expect(neckPoint(Math.PI / 2, -1.8)[0]).toBeGreaterThan(neckPoint(Math.PI / 2, -1.15)[0])
+    expect(buildNeckMesh().indices.length).toBeGreaterThan(0)
+  })
+
+  it('gives the head ears', () => {
+    const [ex] = facePoint(1.6, -0.02)
+    const [bare] = facePoint(1.0, -0.02)
+
+    expect(Math.abs(ex)).toBeGreaterThan(Math.abs(bare) * 0.95)
+  })
+})
diff --git a/apps/desktop/src/lib/jarvis-face/humanoid-geometry.ts b/apps/desktop/src/lib/jarvis-face/humanoid-geometry.ts
new file mode 100644
index 00000000000..633182a1355
--- /dev/null
+++ b/apps/desktop/src/lib/jarvis-face/humanoid-geometry.ts
@@ -0,0 +1,328 @@
+import { hash01 } from './galaxy-layout'
+
+/**
+ * Procedural humanoid head for the Jarvis face. The head is a surface z(φ, y) around a vertical
+ * axis: φ = 0 faces the viewer, y runs chin (-1.08) to crown (1.0). Facial features are smooth
+ * bumps and dents added to the surface, so one function yields nose, brow, eye sockets, cheek
+ * bones, lips and chin — and both the point cloud and the wire grid are sampled from it.
+ */
+
+export const Y_CHIN = -1.08
+export const Y_CROWN = 1.275
+export const MOUTH_Y = -0.6
+export const EYE_Y = 0.24
+export const EYE_PHI = 0.34
+
+const bump = (value: number, center: number, width: number) => Math.exp(-(((value - center) / width) ** 2))
+
+const clamp01 = (value: number) => Math.min(1, Math.max(0, value))
+
+const smoothstep = (a: number, b: number, value: number) => {
+  const t = clamp01((value - a) / (b - a))
+
+  return t * t * (3 - 2 * t)
+}
+
+/** Radial displacement of the front of the face at (φ, y). */
+export function featureOffset(phi: number, y: number): number {
+  const side = Math.abs(phi)
+
+  return (
+    0.42 * bump(y, -0.2, 0.2) * bump(phi, 0, 0.13) + // sharp nose
+    0.06 * bump(y, -0.37, 0.045) * bump(phi, 0, 0.16) + // nose tip
+    0.16 * bump(y, 0.33, 0.075) * bump(phi, 0, 0.8) + // heavy brow ridge
+    -0.18 * bump(y, EYE_Y, 0.085) * bump(side, EYE_PHI, 0.13) + // deep eye sockets
+    0.1 * bump(y, 0.02, 0.12) * bump(side, 0.6, 0.17) + // high cheek bones
+    -0.08 * bump(y, -0.25, 0.12) * bump(side, 0.55, 0.16) + // hollow cheeks
+    0.04 * bump(y, -0.55, 0.045) * bump(phi, 0, 0.28) + // thin upper lip
+    0.05 * bump(y, -0.66, 0.05) * bump(phi, 0, 0.26) + // thin lower lip
+    -0.06 * bump(y, MOUTH_Y, 0.012) * bump(phi, 0, 0.3) + // hard mouth line
+    0.14 * bump(y, -0.95, 0.11) * bump(phi, 0, 0.24) + // strong chin
+    -0.05 * bump(y, -0.42, 0.08) * bump(phi, 0, 0.4) // under-nose dip
+  )
+}
+
+/** A point on the head surface. Narrows toward chin and crown like a real skull. */
+export function facePoint(phi: number, y: number): [number, number, number] {
+  const t = y - 0.1
+  const k = t >= 0 ? 2.2 : 2.2
+  const profile = clamp01(1 - (Math.abs(t) / 1.18) ** k) ** (1 / k)
+  const jaw = 1 + 0.07 * bump(y, -0.5, 0.14) - 0.3 * smoothstep(-0.55, -1.0, y)
+  const half = 0.8 * profile * jaw
+  const depth = 0.88 * profile
+  const front = Math.max(0, Math.cos(phi))
+  const offset = featureOffset(phi, y) * front
+  const ear = 0.17 * bump(y, -0.02, 0.16) * bump(Math.abs(phi), 1.6, 0.17)
+
+  return [half * Math.sin(phi) * (1 + 0.04 * offset) + Math.sign(phi) * ear, y, depth * Math.cos(phi) + offset]
+}
+
+/** Neck below the chin, flaring toward the shoulders. */
+export function neckPoint(phi: number, y: number): [number, number, number] {
+  const radius = 0.36 + 0.2 * smoothstep(-1.3, -1.85, y)
+
+  return [radius * 0.95 * Math.sin(phi), y, radius * 0.9 * Math.cos(phi) - 0.12]
+}
+
+export const NECK_TOP = -1.1
+export const NECK_BOTTOM = -1.85
+const BASE_Y = -1.95
+
+export interface SurfaceMesh {
+  /** x y z nx ny nz per vertex. */
+  vertices: Float32Array
+  /** Triangles, counter-clockwise seen from outside. */
+  indices: Uint32Array
+}
+
+/**
+ * Triangulate a surface of revolution-like patch point(φ, y) with smooth outward normals, wrapping
+ * around φ. Used for the translucent skin: the shader lights it and rims its silhouette.
+ */
+export function buildSurfaceMesh(
+  point: (phi: number, y: number) => [number, number, number],
+  y0: number,
+  y1: number,
+  phiSteps = 140,
+  ySteps = 90
+): SurfaceMesh {
+  const vertices: number[] = []
+  const eps = 0.012
+
+  for (let j = 0; j <= ySteps; j++) {
+    const y = y0 + ((y1 - y0) * j) / ySteps
+
+    for (let i = 0; i < phiSteps; i++) {
+      const phi = -Math.PI + (2 * Math.PI * i) / phiSteps
+      const p = point(phi, y)
+      const a = point(phi + eps, y)
+      const b = point(phi - eps, y)
+      const c = point(phi, y + eps)
+      const d = point(phi, y - eps)
+      const du = [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+      const dv = [c[0] - d[0], c[1] - d[1], c[2] - d[2]]
+      let n = [du[1]! * dv[2]! - du[2]! * dv[1]!, du[2]! * dv[0]! - du[0]! * dv[2]!, du[0]! * dv[1]! - du[1]! * dv[0]!]
+      const length = Math.hypot(n[0]!, n[1]!, n[2]!)
+
+      n = length > 1e-9 ? n.map(value => value / length) : [0, j === 0 ? -1 : 1, 0]
+
+      // Outward: the surface wraps a vertical axis, so the radial direction in xz must agree.
+      if (n[0]! * p[0] + n[2]! * p[2] < 0 && Math.hypot(p[0], p[2]) > 1e-3) {
+        n = n.map(value => -value)
+      }
+
+      vertices.push(p[0], p[1], p[2], n[0]!, n[1]!, n[2]!)
+    }
+  }
+
+  const indices: number[] = []
+
+  for (let j = 0; j < ySteps; j++) {
+    for (let i = 0; i < phiSteps; i++) {
+      const next = (i + 1) % phiSteps
+      const a = j * phiSteps + i
+      const b = j * phiSteps + next
+      const c = (j + 1) * phiSteps + i
+      const d = (j + 1) * phiSteps + next
+
+      indices.push(a, b, c, b, d, c)
+    }
+  }
+
+  return { vertices: new Float32Array(vertices), indices: new Uint32Array(indices) }
+}
+
+export const buildHeadMesh = () => buildSurfaceMesh(facePoint, Y_CHIN + 0.004, Y_CROWN, 150, 110)
+
+// y must increase along the patch, or the triangles wind clockwise and get culled as back faces.
+export const buildNeckMesh = () => buildSurfaceMesh(neckPoint, NECK_BOTTOM, NECK_TOP, 64, 26)
+
+export interface HeadGeometry {
+  /** x y z alpha size, per cloud point. */
+  points: Float32Array
+  /** x y z alpha, two vertices per grid segment. */
+  lines: Float32Array
+}
+
+const POINT_STEP_PHI = 0.045
+const POINT_STEP_Y = 0.024
+const RING_STEP_Y = 0.045
+const RING_STEP_PHI = 0.06
+const MERIDIAN_STEP_PHI = 0.11
+const MERIDIAN_STEP_Y = 0.045
+
+function pushLine(out: number[], a: [number, number, number], b: [number, number, number], alpha: number) {
+  out.push(a[0], a[1], a[2], alpha, b[0], b[1], b[2], alpha)
+}
+
+type Curve = [number, number][]
+
+function polyline(out: number[], curve: Curve, alpha: number, closed = false) {
+  const count = closed ? curve.length : curve.length - 1
+
+  for (let i = 0; i < count; i++) {
+    const [pa, ya] = curve[i]!
+    const [pb, yb] = curve[(i + 1) % curve.length]!
+    const a = facePoint(pa, ya)
+    const b = facePoint(pb, yb)
+
+    pushLine(out, [a[0], a[1], a[2] + 0.012], [b[0], b[1], b[2] + 0.012], alpha)
+  }
+}
+
+const sample = (steps: number, at: (u: number) => [number, number]): Curve =>
+  Array.from({ length: steps + 1 }, (_, i) => at(i / steps))
+
+/** Bright contours that make the grid read as a severe face: brows, narrow eyes, sharp nose, grim mouth, hard jaw. */
+function addFeatureLines(out: number[]) {
+  const tilt = 0.3
+
+  for (const s of [-1, 1]) {
+    // Brows: low at the nose, rising outward, so the face looks angry.
+    polyline(out, sample(12, u => [s * (0.1 + 0.58 * u), 0.33 + 0.12 * u + 0.03 * Math.sin(u * Math.PI)]), 1)
+    // Narrow, slanted eyes with the inner corner lower.
+    polyline(
+      out,
+      sample(24, u => {
+        const dx = 0.2 * Math.cos(u * Math.PI * 2)
+        const dy = 0.034 * Math.sin(u * Math.PI * 2)
+        const a = s * tilt
+
+        return [s * EYE_PHI + dx * Math.cos(a) - dy * Math.sin(a), EYE_Y + dx * Math.sin(a) + dy * Math.cos(a)]
+      }),
+      0.95,
+      true
+    )
+    polyline(out, [[s * 0.03, -0.12], [s * 0.15, -0.32], [s * 0.1, -0.4]], 0.9)
+    polyline(out, [[s * 0.18, -0.34], [s * 0.3, -0.5], [s * 0.31, -0.62]], 0.7)
+    polyline(out, [[s * 1.25, -0.05], [s * 1.12, -0.5], [s * 0.95, -0.75], [s * 0.4, -1.0], [0, -1.07]], 0.85)
+    polyline(out, [[s * 0.75, 0.12], [s * 0.55, 0.0], [s * 0.4, -0.18]], 0.8)
+    polyline(out, [[s * 0.5, -0.18], [s * 0.4, -0.4]], 0.45)
+    polyline(out, [[s * 0.04, 0.34], [s * 0.03, 0.52]], 0.8)
+    // Plating seams: this is a machine.
+    polyline(out, [[s * 0.35, 0.66], [s * 0.35, 0.95]], 0.5)
+    polyline(out, [[s * 0.95, 0.4], [s * 1.15, 0.1], [s * 1.2, -0.2]], 0.55)
+  }
+
+  polyline(out, [[0, 0.3], [0, -0.1]], 0.75)
+  polyline(out, sample(14, u => [-0.17 + 0.34 * u, -0.38 + 0.03 * (((u - 0.5) * 2) ** 2)]), 0.9)
+  polyline(out, sample(16, u => [-0.3 + 0.6 * u, MOUTH_Y - 0.035 * (((u - 0.5) * 2) ** 2)]), 1)
+  polyline(out, sample(16, u => [-0.26 + 0.52 * u, -0.545 - 0.02 * (((u - 0.5) * 2) ** 2)]), 0.8)
+  polyline(out, sample(16, u => [-0.24 + 0.48 * u, -0.7 + 0.03 * (((u - 0.5) * 2) ** 2)]), 0.8)
+  polyline(out, sample(20, u => [-0.9 + 1.8 * u, 0.66]), 0.55)
+  polyline(out, sample(12, u => [-0.4 + 0.8 * u, -0.84]), 0.5)
+}
+
+/** Neck grid, and the glowing rings the head floats above. */
+function addNeckAndBase(out: number[]) {
+  for (let y = NECK_TOP; y >= NECK_BOTTOM; y -= 0.07) {
+    const alpha = 0.16 * (1 - (NECK_TOP - y) / 1.1)
+
+    for (let phi = -Math.PI; phi < Math.PI; phi += 0.2) {
+      pushLine(out, neckPoint(phi, y), neckPoint(phi + 0.2, y), alpha)
+    }
+  }
+
+  for (let phi = -Math.PI; phi < Math.PI; phi += 0.22) {
+    for (let y = NECK_TOP; y > NECK_BOTTOM + 0.05; y -= 0.07) {
+      pushLine(out, neckPoint(phi, y), neckPoint(phi, y - 0.07), 0.1)
+    }
+  }
+
+  const ring = (radius: number, alpha: number, dashed: boolean) => {
+    for (let i = 0; i < 72; i++) {
+      if (dashed && i % 2) {
+        continue
+      }
+
+      const a = (i / 72) * Math.PI * 2
+      const b = ((i + 1) / 72) * Math.PI * 2
+
+      pushLine(out, [radius * Math.sin(a), BASE_Y, radius * Math.cos(a) - 0.1], [radius * Math.sin(b), BASE_Y, radius * Math.cos(b) - 0.1], alpha)
+    }
+  }
+
+  ring(0.62, 0.95, false)
+  ring(0.82, 0.55, false)
+  ring(1.05, 0.4, true)
+  ring(1.3, 0.28, true)
+}
+
+/** Forehead targeting mark and the bright centre line, as in the reference. */
+function addReticle(out: number[]) {
+  polyline(out, [[0, 1.2], [0, 0.78]], 0.9)
+  polyline(out, [[0, 0.52], [0, 0.4]], 0.8)
+  polyline(out, sample(24, u => [0.09 * Math.cos(u * Math.PI * 2), 0.65 + 0.065 * Math.sin(u * Math.PI * 2)]), 1, true)
+  polyline(out, sample(24, u => [0.04 * Math.cos(u * Math.PI * 2), 0.65 + 0.03 * Math.sin(u * Math.PI * 2)]), 0.9, true)
+  polyline(out, [[-0.16, 0.65], [-0.11, 0.65]], 0.9)
+  polyline(out, [[0.11, 0.65], [0.16, 0.65]], 0.9)
+}
+
+export function buildHeadGeometry(): HeadGeometry {
+  const points: number[] = []
+  const lines: number[] = []
+
+  for (let y = Y_CHIN + 0.02; y <= Y_CROWN - 0.02; y += POINT_STEP_Y) {
+    for (let phi = -Math.PI; phi < Math.PI; phi += POINT_STEP_PHI) {
+      const key = `${y.toFixed(3)}:${phi.toFixed(3)}`
+      const frontal = Math.abs(phi) < 1.5
+
+      // Sparse at the back, dense on the face, with a little jitter so it reads as a cloud.
+      if (!frontal && hash01(key, 5) > 0.3) {
+        continue
+      }
+
+      const [x, py, z] = facePoint(phi + (hash01(key, 1) - 0.5) * 0.03, y + (hash01(key, 2) - 0.5) * 0.012)
+
+      points.push(x, py, z, frontal ? 0.5 + 0.5 * hash01(key, 3) : 0.35, 1.2 + hash01(key, 4) ** 3 * 2.4)
+    }
+  }
+
+  for (let y = Y_CHIN + 0.03; y <= Y_CROWN - 0.04; y += RING_STEP_Y) {
+    for (let phi = -Math.PI; phi < Math.PI; phi += RING_STEP_PHI) {
+      pushLine(lines, facePoint(phi, y), facePoint(phi + RING_STEP_PHI, y), 0.09)
+    }
+  }
+
+  for (let phi = -Math.PI; phi < Math.PI; phi += MERIDIAN_STEP_PHI) {
+    for (let y = Y_CHIN + 0.03; y < Y_CROWN - 0.06; y += MERIDIAN_STEP_Y) {
+      pushLine(lines, facePoint(phi, y), facePoint(phi, y + MERIDIAN_STEP_Y), 0.08)
+    }
+  }
+
+  addFeatureLines(lines)
+
+  addNeckAndBase(lines)
+  addReticle(lines)
+
+  return { points: new Float32Array(points), lines: new Float32Array(lines) }
+}
+
+/** Dust drifting around the head on tilted orbits; rotated as a whole by the renderer. */
+export function buildOrbitDust(count = 160): Float32Array {
+  const out: number[] = []
+
+  for (let i = 0; i < count; i++) {
+    const key = `o${i}`
+    const angle = hash01(key, 1) * Math.PI * 2
+    const radius = 1.25 + hash01(key, 2) * 0.55
+    const tilt = (hash01(key, 3) - 0.5) * 1.3
+
+    out.push(
+      radius * Math.cos(angle),
+      radius * Math.sin(angle) * Math.sin(tilt) * 0.5 - 0.15,
+      radius * Math.sin(angle) * Math.cos(tilt),
+      0.35 + 0.65 * hash01(key, 4),
+      1 + hash01(key, 5) ** 2 * 2.4
+    )
+  }
+
+  return new Float32Array(out)
+}
+
+/** Where the eyes sit: inside the sockets, slightly recessed. */
+export function eyePosition(side: -1 | 1): [number, number, number] {
+  const [x, y, z] = facePoint(side * EYE_PHI, EYE_Y)
+
+  return [x, y, z + 0.015]
+}
