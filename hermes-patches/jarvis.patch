+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import {
+  $cerebroGraph,
+  $jarvisVoice,
+  bindJarvisVoiceEvents,
+  CEREBRO_GRAPH_REFRESH_MS,
+  decideJarvisPending,
+  faceEnergy,
